{
  "name": "ritemark",
  "displayName": "Ritemark Editor",
  "description": "WYSIWYG Markdown Editor",
  "version": "1.8.6",
  "publisher": "ritemark",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Ritemark renders markdown content via TipTap and does not execute code from the workspace."
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCustomEditor:ritemark.editor",
    "onCustomEditor:ritemark.excelViewer",
    "onView:ritemark.unifiedView",
    "onWebviewPanel:ritemark.settings",
    "onCommand:ritemark.configureApiKey",
    "onCommand:ritemark.aiSettings",
    "onCommand:ritemark.showAIPanel",
    "onCommand:ritemark.openSearch",
    "onCustomEditor:ritemark.flowEditor",
    "onView:ritemark.agentLibraryView",
    "onCustomEditor:ritemark.pdfViewer",
    "onCustomEditor:ritemark.docxViewer",
    "onCustomEditor:ritemark.drawioEditor",
    "onCommand:ritemark.browser.openUrl",
    "onView:ritemark.browserView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ritemark.configureApiKey",
        "title": "Ritemark: Configure OpenAI API Key"
      },
      {
        "command": "ritemark.showAIPanel",
        "title": "Ritemark: Show AI Assistant",
        "icon": "$(sparkle)"
      },
      {
        "command": "ritemark.openSearch",
        "title": "Search",
        "icon": "$(search)"
      },
      {
        "command": "ritemark.explorer.refresh",
        "title": "Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "ritemark.sendToChat",
        "title": "Send to AI Chat"
      },
      {
        "command": "ritemark.newChat",
        "title": "New Chat",
        "icon": "$(add)"
      },
      {
        "command": "ritemark.newDocument",
        "title": "New Document",
        "icon": "$(new-file)"
      },
      {
        "command": "ritemark.newTable",
        "title": "New Table",
        "icon": "$(table)"
      },
      {
        "command": "ritemark.aiSettings",
        "title": "AI Settings",
        "icon": "$(gear)"
      },
      {
        "command": "ritemark.chatHistory",
        "title": "Chat History",
        "icon": "$(history)"
      },
      {
        "command": "ritemark.flows.new",
        "title": "New Flow",
        "icon": "$(add)"
      },
      {
        "command": "ritemark.flows.refresh",
        "title": "Refresh Flows",
        "icon": "$(refresh)"
      },
      {
        "command": "ritemark.flows.settings",
        "title": "Flow Settings",
        "icon": "$(gear)"
      },
      {
        "command": "ritemark.reactions",
        "title": "Send Feedback",
        "icon": "$(thumbsup)"
      },
      {
        "command": "ritemark.browser.openUrl",
        "title": "Open URL in Ritemark Browser",
        "category": "Ritemark Browser",
        "icon": "$(globe)"
      },
      {
        "command": "ritemark.daemon.showScheduledRuns",
        "title": "Show Scheduled Runs",
        "category": "Ritemark"
      },
      {
        "command": "ritemark.daemon.approveScheduledAction",
        "title": "Approve Scheduled Action",
        "category": "Ritemark"
      },
      {
        "command": "ritemark.daemon.openResult",
        "title": "Open Scheduled Run Result",
        "category": "Ritemark"
      },
      {
        "command": "ritemark.browser.back",
        "title": "Back",
        "category": "Ritemark Browser",
        "icon": "$(arrow-left)"
      },
      {
        "command": "ritemark.browser.forward",
        "title": "Forward",
        "category": "Ritemark Browser",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ritemark.browser.refresh",
        "title": "Refresh",
        "category": "Ritemark Browser",
        "icon": "$(refresh)"
      },
      {
        "command": "ritemark.browser.openInSystemBrowser",
        "title": "Open in System Browser",
        "category": "Ritemark Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "ritemark.browser.openAsText",
        "title": "Open as Text",
        "category": "Ritemark Browser"
      },
      {
        "command": "ritemark.browser.openInBrowser",
        "title": "Open in Ritemark Browser",
        "category": "Ritemark Browser",
        "icon": "$(globe)"
      },
      {
        "command": "ritemark.browser.newTab",
        "title": "New Browser Tab",
        "category": "Ritemark Browser",
        "icon": "$(add)"
      },
      {
        "command": "ritemark.browser.history.open",
        "title": "Open in Ritemark Browser",
        "category": "Ritemark Browser"
      },
      {
        "command": "ritemark.browser.history.clearAll",
        "title": "Clear History",
        "category": "Ritemark Browser",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": [
      {
        "title": "Ritemark Updates",
        "properties": {
          "ritemark.updates.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Check for updates on startup"
          },
          "ritemark.updates.dismissed": {
            "type": "string",
            "default": "",
            "description": "Last dismissed update version (internal)"
          },
          "ritemark.updates.mode": {
            "type": "string",
            "enum": [
              "auto",
              "prompt"
            ],
            "default": "auto",
            "description": "How extension updates are applied: 'auto' stages silently and relaunches on next start or click; 'prompt' shows the existing install notification. Full app updates are unaffected by this setting."
          },
          "ritemark.updates.channel": {
            "type": "string",
            "enum": [
              "stable",
              "canary"
            ],
            "enumDescriptions": [
              "Receive updates only after they have been verified and published to everyone.",
              "Receive extension updates as soon as they are published, before they reach everyone else. For pre-release verification only — a canary build has not yet been confirmed working."
            ],
            "default": "stable",
            "description": "Which update ring to follow. Leave on 'stable' unless you are helping verify a release: 'canary' fetches an unverified pre-release update feed."
          }
        }
      },
      {
        "title": "Ritemark Analytics",
        "properties": {
          "ritemark.analytics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Send anonymous usage data to help improve Ritemark. No personal information is collected.",
            "scope": "application"
          }
        }
      },
      {
        "title": "Ritemark Features",
        "properties": {
          "ritemark.features.voice-dictation": {
            "type": "boolean",
            "default": false,
            "description": "Enable voice dictation (experimental, macOS only). Requires Whisper model download (~75MB).",
            "scope": "application"
          },
          "ritemark.features.agentic-assistant": {
            "type": "boolean",
            "default": false,
            "description": "Enable Claude in the AI sidebar (experimental). Allows autonomous file operations.",
            "scope": "application"
          },
          "ritemark.features.codex-integration": {
            "type": "boolean",
            "default": true,
            "description": "Enable Codex CLI integration with ChatGPT authentication (experimental). Requires codex binary installed.",
            "scope": "application"
          },
          "ritemark.features.scheduled-flow-runs": {
            "type": "boolean",
            "default": true,
            "description": "Enable automatic scheduled execution for eligible flows (experimental). Runs only while Ritemark is open.",
            "scope": "application"
          },
          "ritemark.features.analytics": {
            "type": "boolean",
            "default": true,
            "description": "Kill-switch for anonymous analytics. When disabled, no data is sent to PostHog.",
            "scope": "application"
          },
          "ritemark.features.comment-callouts": {
            "type": "boolean",
            "default": true,
            "description": "Editor-only comments (#81): anchored highlights and /// notes, assignable to an AI agent. Kill-switch — disable if comments stop round-tripping.",
            "scope": "application"
          },
          "ritemark.features.home-launcher": {
            "type": "boolean",
            "default": true,
            "description": "Home launcher (#74): persistent Activity Bar view with New document, quick actions, and recent work. Kill-switch — disable to hide the launcher UI.",
            "scope": "application"
          }
        }
      },
      {
        "title": "Ritemark Agent Runtime",
        "properties": {
          "ritemark.agentRuntime.preference": {
            "type": "string",
            "enum": [
              "bundled",
              "system"
            ],
            "enumDescriptions": [
              "Use the Codex and Claude runtimes that ship inside Ritemark (recommended)",
              "Prefer system-installed Codex and Claude; bundled runtimes are used only if no system install is found"
            ],
            "default": "bundled",
            "description": "Which agent runtime Ritemark prefers when both bundled and system installs are available. Applies to both Codex and Claude.",
            "scope": "application"
          }
        }
      },
      {
        "title": "Codex",
        "properties": {
          "ritemark.codex.approvalPolicy": {
            "type": "string",
            "default": "untrusted",
            "enum": [
              "untrusted",
              "on-request",
              "on-failure",
              "never"
            ],
            "enumDescriptions": [
              "Ask before every command and file change (safest)",
              "Ask only for operations outside workspace boundaries",
              "Auto-approve everything, ask only when a command fails",
              "Never ask — run everything automatically (use with caution)"
            ],
            "description": "When Codex should ask for your approval before running shell commands or modifying files.",
            "scope": "application"
          },
          "ritemark.codex.sandboxMode": {
            "type": "string",
            "default": "workspace-write",
            "enum": [
              "read-only",
              "workspace-write",
              "danger-full-access"
            ],
            "enumDescriptions": [
              "Codex can only read files (no writing or command execution)",
              "Codex can read and write files within the workspace (recommended)",
              "Full system access including network — use with extreme caution"
            ],
            "description": "What Codex is allowed to do on your filesystem.",
            "scope": "application"
          },
          "ritemark.opencode.autoApprove": {
            "type": "boolean",
            "default": false,
            "description": "Auto-approve OpenCode file edits and tool calls within the workspace without showing the approval card. Writes outside the workspace are still blocked. Use with caution.",
            "scope": "application"
          }
        }
      },
      {
        "title": "Ritemark AI",
        "properties": {
          "ritemark.ai.selectedAgent": {
            "type": "string",
            "default": "claude-code",
            "enum": [
              "ritemark-agent",
              "claude-code",
              "codex"
            ],
            "enumDescriptions": [
              "Ritemark Agent - Chat assistant with RAG search and image generation",
              "Claude (experimental) - Autonomous agent that can read, write, and organize files",
              "Codex (experimental) - OpenAI coding agent with ChatGPT authentication"
            ],
            "description": "Select which AI agent to use in the sidebar",
            "scope": "application"
          },
          "ritemark.ai.excludedFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".git",
              "node_modules",
              ".env",
              ".env.*",
              ".vscode",
              ".DS_Store",
              "*.pem",
              "*.key",
              "credentials*",
              "secrets*"
            ],
            "description": "Folders and file patterns Claude should not access. The agent is instructed to skip these paths.",
            "scope": "resource"
          },
          "ritemark.ai.selectedModel": {
            "type": "string",
            "default": "claude-sonnet-4-5",
            "description": "Claude model to use (e.g. claude-sonnet-4-5, claude-opus-4, haiku)",
            "scope": "application"
          },
          "ritemark.ai.debugTrace": {
            "type": "boolean",
            "default": false,
            "description": "Enable runtime trace logging for AI agents (written to temp directory). Restart required after changing.",
            "scope": "application"
          },
          "ritemark.ai.hasSeenClaudeWelcome": {
            "type": "boolean",
            "default": false,
            "description": "Internal: tracks whether the Claude welcome wizard has been shown.",
            "scope": "application"
          },
          "ritemark.chat.fontSize": {
            "type": "number",
            "default": 13,
            "minimum": 10,
            "maximum": 20,
            "description": "Font size for AI chat interface (10-20px)",
            "scope": "application"
          },
          "ritemark.ai.agentTimeout": {
            "type": "number",
            "default": 15,
            "minimum": 5,
            "maximum": 60,
            "description": "Inactivity timeout for Claude in minutes (5-60). The agent will be stopped if it produces no activity for this duration.",
            "scope": "application"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ritemark-home",
          "title": "Home",
          "icon": "media/home-icon.svg"
        },
        {
          "id": "ritemark-agent-library",
          "title": "Agent Library",
          "icon": "media/agent-library-icon.svg"
        },
        {
          "id": "ritemark-browser",
          "title": "Browser",
          "icon": "media/browser-icon.svg"
        }
      ],
      "auxiliarybar": [
        {
          "id": "ritemark-ai",
          "title": "Ritemark AI",
          "icon": "media/sparkles-icon.svg"
        }
      ]
    },
    "views": {
      "ritemark-home": [
        {
          "type": "webview",
          "id": "ritemark.homeView",
          "name": "Home",
          "contextualTitle": "Home",
          "visibility": "visible"
        }
      ],
      "ritemark-ai": [
        {
          "type": "webview",
          "id": "ritemark.unifiedView",
          "name": "Ritemark AI",
          "contextualTitle": "Ritemark AI",
          "visibility": "visible"
        }
      ],
      "ritemark-agent-library": [
        {
          "type": "webview",
          "id": "ritemark.agentLibraryView",
          "name": "Agent Library",
          "contextualTitle": "Agent Library",
          "visibility": "visible"
        }
      ],
      "ritemark-browser": [
        {
          "type": "webview",
          "id": "ritemark.browserView",
          "name": "Recent",
          "contextualTitle": "Browser",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "ritemark.showAIPanel",
          "group": "navigation",
          "when": "activeCustomEditorId == ritemark.editor"
        },
        {
          "command": "ritemark.reactions",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ritemark.openSearch",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@1"
        },
        {
          "command": "ritemark.explorer.refresh",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@2"
        },
        {
          "command": "ritemark.aiSettings",
          "when": "view == ritemark.unifiedView",
          "group": "navigation@3"
        },
        {
          "command": "ritemark.browser.newTab",
          "when": "view == ritemark.browserView",
          "group": "navigation@1"
        },
        {
          "command": "ritemark.browser.history.clearAll",
          "when": "view == ritemark.browserView",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ritemark.sendToChat",
          "group": "navigation"
        },
        {
          "command": "ritemark.browser.openAsText",
          "when": "resourceLangId == html",
          "group": "navigation"
        },
        {
          "command": "ritemark.browser.openInBrowser",
          "when": "resourceLangId == html",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ritemark.browser.openInBrowser",
          "group": "navigation",
          "when": "resourceLangId == html"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ritemark.editor",
        "displayName": "Ritemark",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ritemark.excelViewer",
        "displayName": "Excel Editor",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ritemark.flowEditor",
        "displayName": "Flow Editor",
        "selector": [
          {
            "filenamePattern": "*.flow.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ritemark.pdfViewer",
        "displayName": "PDF Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ritemark.docxViewer",
        "displayName": "DOCX Preview",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ritemark.drawioEditor",
        "displayName": "Draw.io Editor",
        "selector": [
          {
            "filenamePattern": "*.drawio.svg"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "workbench.sideBar.location": "left",
      "workbench.colorTheme": "ritemark-light",
      "workbench.iconTheme": "ritemark-icons",
      "workbench.productIconTheme": "ritemark-product-icons",
      "workbench.activityBar.location": "default",
      "workbench.editor.editorActionsLocation": "hidden",
      "extensions.ignoreRecommendations": true,
      "workbench.tips.enabled": false,
      "debug.showInStatusBar": "never",
      "testing.openTesting": "neverOpen",
      "outline.showVariables": false,
      "outline.showFunctions": false,
      "timeline.showUncommittedChanges": false,
      "window.autoDetectColorScheme": true,
      "workbench.preferredLightColorTheme": "ritemark-light",
      "workbench.preferredDarkColorTheme": "ritemark-dark",
      "chat.commandCenter.enabled": false,
      "chat.agent.enabled": true,
      "github.copilot.enable": {
        "*": true
      },
      "github.copilot.editor.enableAutoCompletions": true,
      "github.copilot.editor.enableCodeActions": true,
      "workbench.panel.defaultLocation": "right",
      "terminal.integrated.defaultLocation": "view",
      "problems.decorations.enabled": false,
      "markdown.validate.enabled": false,
      "workbench.secondarySideBar.showLabels": false
    },
    "themes": [
      {
        "id": "ritemark-light",
        "label": "Ritemark Light",
        "uiTheme": "vs",
        "path": "./themes/ritemark-light.json"
      },
      {
        "id": "ritemark-dark",
        "label": "Ritemark Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ritemark-dark.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ritemark-icons",
        "label": "Ritemark Icons",
        "path": "./fileicons/ritemark-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "ritemark-product-icons",
        "label": "Ritemark Product Icons",
        "path": "./producticons/ritemark-product-icon-theme.json"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+n",
        "mac": "cmd+n",
        "command": "ritemark.newDocument"
      },
      {
        "key": "ctrl+n",
        "mac": "cmd+n",
        "command": "-workbench.action.files.newUntitledFile"
      },
      {
        "key": "cmd+b",
        "command": "-workbench.action.toggleSidebarVisibility",
        "when": "activeCustomEditorId == ritemark.editor"
      },
      {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility",
        "when": "activeCustomEditorId == ritemark.editor"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit -p ./ && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "npx tsx src/features/featureGate.test.ts && npx tsx src/utils/bundledAgentRuntime.test.ts && npx tsx src/utils/imageWriter.test.ts && npx tsx src/agent/AgentRunner.test.ts && npx tsx src/codex/codexApproval.test.ts && npx tsx src/acp/acpClient.test.ts && npx tsx src/acp/acpManager.test.ts && npx tsx src/browser/browserActionTools.test.ts && npx tsx webview/src/components/ai-sidebar/lifecycle.test.ts && npx tsx webview/src/components/ai-sidebar/conversationReset.test.ts && npx tsx webview/src/components/ai-sidebar/planText.test.ts && npx tsx webview/src/components/ai-sidebar/composerQueue.test.ts && npx tsx webview/src/components/ai-sidebar/promptQueue.test.ts && npx tsx webview/src/components/ai-sidebar/promptQueueStore.test.ts && npx tsx webview/src/components/ai-sidebar/aiDisclosure.test.ts && npx tsx webview/src/components/flows/codexModelSelect.test.ts && npx tsx webview/src/components/flows/ExecutionPanel.test.ts && npx tsx src/flows/flowTypes.test.ts && npx tsx src/flows/flowSchedule.test.ts && npx tsx src/flows/FlowScheduleState.test.ts && npx tsx src/flows/FlowScheduler.test.ts && npx tsx src/flows/FlowExecutor.test.ts && npx tsx src/flows/flowRuntimeCoverage.test.ts && npx tsx src/flows/nodes/ClaudeCodeNodeExecutor.test.ts && npx tsx src/update/updateResolver.test.ts && npx tsx src/update/updateService.test.ts && npx tsx src/update/activationIntegrity.test.ts && npx tsx src/update/applyUpdate.test.ts && npx tsx src/update/versionComparison.test.ts && npx tsx src/flows/FlowIntegration.test.ts && npx tsx src/flows/nodes/SaveFileNodeExecutor.integration.test.ts && npx tsx src/flows/nodes/ClaudeCodeNodeExecutor.integration.test.ts && npx tsx src/analytics/analytics.test.ts && npx tsx webview/src/components/agent/agentSchema.test.ts && npx tsx webview/src/components/agent/cronSchedule.test.ts && npx tsx src/daemon/workspaceConsent.test.ts && npx tsx src/utils/stickyTabHealer.test.ts && npx tsx src/daemon/scheduleParser.test.ts && npx tsx src/daemon/