+
+import assert from 'assert';
+import { ISerializedLeafNode, ISerializedNode } from '../../../base/browser/ui/grid/gridview.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';
+import { IConfigurationService } from '../../../platform/configuration/common/configuration.js';
+import { ServicesAccessor } from '../../../platform/instantiation/common/instantiation.js';
+import { NullLogService } from '../../../platform/log/common/log.js';
+import { IStorageService, StorageScope } from '../../../platform/storage/common/storage.js';
+import { IWorkspaceContextService, WorkbenchState } from '../../../platform/workspace/common/workspace.js';
+import { readRitemarkFrame, ritemarkFirstDesk, ritemarkSeedPlaces, ritemarkSlotReleased } from '../../browser/ritemarkFrame.js';
+import { ISerializedEditorGroupModel } from '../../common/editor/editorGroupModel.js';
+import { TestStorageService } from '../common/workbenchTestServices.js';
+
+/**
+ * Ritemark 2.0 (Sprint 152, R1, R3, R7, R9): the frame's manifest (product.json's `ritemarkFrame`) as the shell reads
+ * it at the first frame, the slots' release log, a new profile's places and a project's first desk.
+ */
+suite('Ritemark frame', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	const manifest = {
+		extension: 'ritemark.ritemark',
+		homePlace: 'workbench.view.extension.ritemark-home',
+		aiColumn: 'workbench.view.extension.ritemark-ai',
+		permanentTabs: [
+			{ viewType: 'mainThreadWebview-ritemark.home', title: 'Home', icon: { light: 'media/home/home-tab-light.svg', dark: 'media/home/home-tab-dark.svg' } },
+			{ viewType: 'mainThreadWebview-ritemark.taskBoard', title: 'Task board', setting: 'ritemark.features.task-board' },
+		],
+		deskFront: 'mainThreadWebview-ritemark.home',
+		welcome: 'mainThreadWebview-ritemark.welcome',
+		places: [
+			{ id: 'workbench.view.extension.ritemark-home', title: 'Home', order: -1, icon: 'media/home-icon.svg' },
+			{ id: 'workbench.view.explorer', title: 'Documents', head: { rows: [{ command: 'ritemark.projectHead.newRow', menu: 'ritemark/projectHead/new' }, { command: 'ritemark.projectHead.search' }], label: 'Documents' } },
+		],
+	};
+
+	test('the manifest: no block reads as no frame; unknown keys are ignored, and entries it can\'t use are left out', () => {
+		const none = { places: [], homePlace: undefined, aiColumn: undefined, permanentTabs: [], deskFront: undefined, welcome: undefined, extension: undefined };
+		const read = readRitemarkFrame({
+			...manifest,
+			futureKey: { anything: true },
+			places: [...manifest.places, { id: 'no-title' }, { title: 'No id' }, { id: 'p', title: 'P', order: 'first', head: { rows: [{ menu: 'no command' }, { command: 'c' }] } }],
+			permanentTabs: [...manifest.permanentTabs, { title: 'No view type' }],
+			welcome: 7,
+		});
+		assert.deepStrictEqual({
+			missing: readRitemarkFrame(undefined),
+			array: readRitemarkFrame([manifest]),
+			text: readRitemarkFrame('ritemarkFrame'),
+			read,
+		}, {
+			missing: none,
+			array: none,
+			text: none,
+			read: {
+				...manifest,
+				welcome: undefined,
+				places: [...manifest.places, { id: 'p', title: 'P', head: { rows: [{ command: 'c' }] } }],
+			},
+		});
+	});
+
+	test('a slot\'s release is logged once', () => {
+		const logged: string[] = [];
+		const logService = new class extends NullLogService { override warn(message: string) { logged.push(message); } }();
+		ritemarkSlotReleased(logService, 'a test slot', 'why');
+		ritemarkSlotReleased(logService, 'a test slot', 'why again');
+		ritemarkSlotReleased(logService, 'another test slot', 'why');
+		assert.deepStrictEqual(logged, ['[ritemark] slot released: a test slot (why)', '[ritemark] slot released: another test slot (why)']);
+	});
