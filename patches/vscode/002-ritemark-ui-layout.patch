index 00000000000..ff03e6593fa
--- /dev/null
+++ b/src/vs/workbench/browser/ritemarkFrame.ts
@@ -0,0 +1,465 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0 (Sprint 152, R1; the startup contract, docs/development/analysis/2026-11-01-startup-contract.md): the
+ * shell knows Ritemark's frame up front and draws its final geometry from the first frame; the extension only fills
+ * it in. The frame's one description is the `ritemarkFrame` block of product.json, read here at the first frame (the
+ * extension's own contributions exist only once VS Code has read the extensions, after it). Every patch that draws a
+ * part of the frame reads it from here: the places, their order and their placeholders (viewsExtensionPoint.ts,
+ * sidebarPart.ts), the place a project window opens on (layout.ts), the AI column (layout.ts, paneCompositePart.ts,
+ * auxiliaryBarPart.ts), the head's rows (ritemarkProjectHead.ts), the permanent tabs and the desk's front
+ * (editorGroupView.ts, editorPart.ts, ritemarkSwitchGuard.ts), the welcome (ritemarkWelcomeAlone.ts). Unknown keys are
+ * ignored; a missing or broken block reads as no frame, said once in the log, and the shell then draws as VS Code does
+ * (validate-build-output.sh fails a build without it).
+ *
+ * A slot is a box the shell draws at its final size before its content exists. When the extension that runs has
+ * nothing for it (an older extension, a failed start), the slot goes once, at a known moment: a contribution's slot
+ * when the extensions are read, a content slot when Ritemark isn't there or hasn't started after RITEMARK_SLOT_RELEASE_MS
+ * (how a failed start shows: VS Code reports a failed activation only to its telemetry). Each release is logged once,
+ * `[ritemark] slot released: <name>`, so a test run sees it; the release check in release-extension-preflight.sh keeps
+ * it from being the normal path. (The plan named a module of 018's for the slots; they live here, with the manifest,
+ * since 002's AI column releases one too and 002 can't import 018.)
+ */
+
+import { ISerializedGrid, Orientation } from '../../base/browser/ui/grid/grid.js';
+import { disposableTimeout } from '../../base/common/async.js';
+import { Disposable } from '../../base/common/lifecycle.js';
+import { AppResourcePath, builtinExtensionsPath, FileAccess } from '../../base/common/network.js';
+import { joinPath } from '../../base/common/resources.js';
+import { URI } from '../../base/common/uri.js';
+import { IConfigurationService } from '../../platform/configuration/common/configuration.js';
+import { ExtensionIdentifier } from '../../platform/extensions/common/extensions.js';
+import { ServicesAccessor } from '../../platform/instantiation/common/instantiation.js';
+import { ILogService } from '../../platform/log/common/log.js';
+import product from '../../platform/product/common/product.js';
+import { Registry } from '../../platform/registry/common/platform.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../platform/storage/common/storage.js';
+import { IWorkspaceContextService, WorkbenchState } from '../../platform/workspace/common/workspace.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../common/contributions.js';
+import { EditorExtensions, IEditorFactoryRegistry } from '../common/editor.js';
+import { ISerializedEditorGroupModel } from '../common/editor/editorGroupModel.js';
+import { IEditorService } from '../services/editor/common/editorService.js';
+import { IExtensionService } from '../services/extensions/common/extensions.js';
+import { IWorkbenchLayoutService, Parts } from '../services/layout/browser/layoutService.js';
+import { generateUuid } from '../../base/common/uuid.js';
+import { Memento } from '../common/memento.js';
+import { IViewDescriptorService } from '../common/views.js';
+
+/** A row under a place's head: an extension command (its words and icon), with the extension's menu when it has one. */
+export interface IRitemarkFrameHeadRow {
+	readonly command: string;
+	readonly menu?: string;
+}
+
+/** A place in the places row, in order, with its placeholder's title and icon (the extension's media). */
+export interface IRitemarkFramePlace {
+	readonly id: string;
+	readonly title: string;
+	/** VS Code's view container order; none for VS Code's own place (Documents). */
+	readonly order?: number;
+	/** Relative to the extension's folder (`media/home-icon.svg`). */
+	readonly icon?: string;
+	/** The project's head on this place: its rows (their room is kept from the first frame), and the label over the content. */
+	readonly head?: { readonly rows: readonly IRitemarkFrameHeadRow[]; readonly label?: string };
+}
+
+/** A permanent tab (Home, the Task board): its webview's view type, its name and its icons, as the extension gives them. */
+export interface IRitemarkFrameTab {
+	readonly viewType: string;
+	readonly title: string;
+	/** Relative to the extension's folder, one per theme. */
+	readonly icon?: { readonly light: string; readonly dark: string };
+	/** The setting that turns the tab off when false (a feature flag); on when unset. */
+	readonly setting?: string;
+}
+
+export interface IRitemarkFrame {
+	readonly places: readonly IRitemarkFramePlace[];
+	/** The place a project window opens on when it has none of its own. */
+	readonly homePlace: string | undefined;
+	/** The AI column's view container. */
+	readonly aiColumn: string | undefined;
+	/** The permanent tabs, in order (Home, the Task board). */
+	readonly permanentTabs: readonly IRitemarkFrameTab[];
+	/** The tab in front of a project window's desk when it lands (a switch, a project opened for the first time). */
+	readonly deskFront: string | undefined;
+	/** The welcome's webview view type (the welcome alone). */
+	readonly welcome: string | undefined;
+	/** The extension's id, whose built-in copy holds the places' and the tabs' icons. */
+	readonly extension: string | undefined;
+}
+
+const NO_FRAME: IRitemarkFrame = { places: [], homePlace: undefined, aiColumn: undefined, permanentTabs: [], deskFront: undefined, welcome: undefined, extension: undefined };
+
+function text(value: unknown): string | undefined {
+	return typeof value === 'string' && value.length > 0 ? value : undefined;
+}
+
+function headRow(value: unknown): IRitemarkFrameHeadRow | undefined {
+	const row = value as { command?: unknown; menu?: unknown } | null;
+	const command = text(row?.command);
+	const menu = text(row?.menu);
+	return command ? { command, ...(menu ? { menu } : {}) } : undefined;
+}
+
+function place(value: unknown): IRitemarkFramePlace | undefined {
+	const raw = value as { id?: unknown; title?: unknown; order?: unknown; icon?: unknown; head?: { rows?: unknown; label?: unknown } } | null;
+	const id = text(raw?.id);
+	const title = text(raw?.title);
+	if (!id || !title) {
+		return undefined;
+	}
+	const icon = text(raw?.icon);
+	const label = text(raw?.head?.label);
+	const rows = Array.isArray(raw?.head?.rows) ? raw.head.rows.map(headRow).filter((row): row is IRitemarkFrameHeadRow => !!row) : undefined;
+	return {
+		id,
+		title,
+		...(typeof raw?.order === 'number' && Number.isFinite(raw.order) ? { order: raw.order } : {}),
+		...(icon ? { icon } : {}),
+		...(rows ? { head: { rows, ...(label ? { label } : {}) } } : {}),
+	};
+}
+
+function tab(value: unknown): IRitemarkFrameTab | undefined {
+	const raw = value as { viewType?: unknown; title?: unknown; icon?: { light?: unknown; dark?: unknown }; setting?: unknown } | null;
+	const viewType = text(raw?.viewType);
+	const title = text(raw?.title);
+	if (!viewType || !title) {
+		return undefined;
+	}
+	const light = text(raw?.icon?.light);
+	const dark = text(raw?.icon?.dark);
+	const setting = text(raw?.setting);
+	return { viewType, title, ...(light && dark ? { icon: { light, dark } } : {}), ...(setting ? { setting } : {}) };
+}
+
+/** The frame from product.json's `ritemarkFrame` block: what it can use of it, and nothing it can't. */
+export function readRitemarkFrame(value: unknown): IRitemarkFrame {
+	if (!value || typeof value !== 'object' || Array.isArray(value)) {
+		return NO_FRAME;
+	}
+	const raw = value as Record<string, unknown>;
+	return {
+		places: Array.isArray(raw.places) ? raw.places.map(place).filter((entry): entry is IRitemarkFramePlace => !!entry) : [],
+		homePlace: text(raw.homePlace),
+		aiColumn: text(raw.aiColumn),
+		permanentTabs: Array.isArray(raw.permanentTabs) ? raw.permanentTabs.map(tab).filter((entry): entry is IRitemarkFrameTab => !!entry) : [],
+		deskFront: text(raw.deskFront),
+		welcome: text(raw.welcome),
+		extension: text(raw.extension),
+	};
+}
+
+/** Ritemark's frame, as this build's product.json describes it. */
+export const ritemarkFrame: IRitemarkFrame = readRitemarkFrame((product as { ritemarkFrame?: unknown }).ritemarkFrame);
+
+if (!ritemarkFrame.places.length || !ritemarkFrame.aiColumn) {
+	console.warn('[ritemark] product.json has no usable ritemarkFrame block: the frame draws as VS Code does');
+}
+
+/** A Ritemark place's order in the places row (VS Code's view container order), from the manifest. */
+export function ritemarkPlaceOrder(containerId: string): number | undefined {
+	return ritemarkFrame.places.find(entry => entry.id === containerId)?.order;
+}
+
+/** Whether a view container is one of the frame's places. */
+export function isRitemarkPlace(containerId: string | undefined): boolean {
+	return ritemarkFrame.places.some(entry => entry.id === containerId);
+}
+
+/** The built-in copy of the extension, in the app's own extensions folder: its media is there before it starts. */
+export function ritemarkBuiltinExtensionLocation(frame = ritemarkFrame): URI | undefined {
+	const name = frame.extension?.split('.').pop();
+	return name ? FileAccess.asFileUri(`${builtinExtensionsPath}/${name}` as AppResourcePath) : undefined;
+}
+
+/**
+ * How long a content slot waits for the extension to fill it: VS Code's own limit for the extension host to say it is
+ * ready ("took longer than 60s to send its ready message"). A2 measured every start well inside it: the slowest cold
+ * Windows start had Ritemark active at 17.2 s, a start after an install about 26 s.
+ */
+export const RITEMARK_SLOT_RELEASE_MS = 60_000;
+
+const released = new Set<string>();
+
+/** For tests: forget which slots have said they went. */
+export function resetRitemarkSlotReleasesForTesting(): void {
+	released.clear();
+}
+
+/** A slot goes, once: says so in the log, the first time only. */
+export function ritemarkSlotReleased(logService: ILogService, name: string, why: string): void {
+	if (released.has(name)) {
+		return;
+	}
+	released.add(name);
+	logService.warn(`[ritemark] slot released: ${name} (${why})`);
+}
+
+// --- What the layout decided at the first frame, for the parts drawn after it ------------------------------------
+
+/**
+ * A project window's note that it has been opened (layout.ts): with it, a project with no stored place (VS Code stores
+ * none for Documents, its default) comes back on Documents; without it, and with the workspace's storage new, the
+ * project is opened for the first time and opens on Home's place (R3). VS Code keeps a workspace's storage "new" for
+ * the whole app session it was made in, so a reload in that session needs the note.
+ */
+export const RITEMARK_PROJECT_OPENED_KEY = 'ritemark.project.opened';
+
+let placeToRestore: string | undefined;
+let welcomeAloneExpected = false;
+let welcomeAloneColumns: { readonly sideBar: boolean; readonly aiColumn: boolean } = { sideBar: false, aiColumn: false };
+
+/**
+ * Whether the window's saved tabs (VS Code's editor part state, read before the part is made) hold anything but the
+ * welcome: an empty window restoring documents (hot exit, a restored window) opens no welcome (the extension's
+ * `opensAtStart`), so it isn't the welcome alone. Read only; the editor part restores them as always.
+ */
+export function ritemarkRestoresDocuments(storageService: IStorageService): boolean {
+	const state = new Memento<{ 'editorpart.state'?: { serializedGrid?: { root?: unknown } } }>('workbench.parts.editor', storageService).getMemento(StorageScope.WORKSPACE, StorageTarget.MACHINE)['editorpart.state'];
+	const documents = (node: unknown): boolean => {
+		const branch = node as { type?: string; data?: unknown } | undefined;
+		if (branch?.type === 'branch' && Array.isArray(branch.data)) {
+			return branch.data.some(documents);
+		}
+		const editors = (branch?.data as { editors?: { id?: string; value?: string }[] } | undefined)?.editors ?? [];
+		return editors.some(editor => {
+			try {
+				return editor.id !== WEBVIEW_EDITOR_TYPE_ID || (JSON.parse(editor.value ?? '{}') as { viewType?: unknown }).viewType !== ritemarkFrame.welcome;
+			} catch {
+				return true;
+			}
+		});
+	};
+	return documents(state?.serializedGrid?.root);
+}
+
+/** layout.ts: the place the left column restores, perhaps before its extension has registered it (R2, R3); the side bar forgets it once a place opens. */
+export function ritemarkNotePlaceToRestore(containerId: string | undefined): void {
+	placeToRestore = containerId;
+}
+
+/** The place the left column restores: in front in the places row and drawn by the head from the first frame. */
+export function ritemarkPlaceToRestore(): string | undefined {
+	return placeToRestore;
+}
+
+/**
+ * layout.ts: whether this window is the welcome's, alone from its first frame (R4): no folder, nothing to open; and
+ * which columns the layout would have shown, which it closed for the welcome alone. When that slot is released
+ * (another editor came in front, Ritemark isn't there or hasn't started), those columns come back: the window is
+ * VS Code's empty window again.
+ */
+export function ritemarkNoteWelcomeAloneExpected(expected: boolean, columns = { sideBar: false, aiColumn: false }): void {
+	welcomeAloneExpected = expected && !!ritemarkFrame.welcome;
+	welcomeAloneColumns = welcomeAloneExpected ? columns : { sideBar: false, aiColumn: false };
+}
+
+export function isRitemarkWelcomeAloneExpected(): boolean {
+	return welcomeAloneExpected;
+}
+
+/** The columns the layout closed for the welcome alone, to show again when its slot is released. */
+export function ritemarkWelcomeAloneColumns(): { readonly sideBar: boolean; readonly aiColumn: boolean } {
+	return welcomeAloneColumns;
+}
+
+// --- The places row before the extensions are read (R9) ----------------------------------------------------------
+
+/**
+ * Sprint 152 (R9): a new profile's places row has the frame's places from its first frame. VS Code draws the places it
+ * stored last time (as placeholders, until their extension registers them), and a new profile has none, so its row was
+ * Documents alone until the extensions were read. With nothing stored, the manifest's places are stored as those
+ * placeholders before the row is made, in its order, with their titles and the built-in copy's icons; the extension's
+ * registration replaces each in place, and VS Code stores the real ones as it always does.
+ */
+export function ritemarkSeedPlaces(storageService: IStorageService, pinnedKey: string, placeholderKey: string, frame = ritemarkFrame): void {
+	if (!frame.places.length || storageService.get(pinnedKey, StorageScope.PROFILE) !== undefined) {
+		return;
+	}
+	const extension = ritemarkBuiltinExtensionLocation(frame);
+	storageService.store(pinnedKey, JSON.stringify(frame.places.map(entry => ({ id: entry.id, pinned: true, visible: true, order: entry.order }))), StorageScope.PROFILE, StorageTarget.USER);
+	storageService.store(placeholderKey, JSON.stringify(frame.places.map(entry => ({
+		id: entry.id,
+		name: entry.title,
+		iconUrl: extension && entry.icon ? joinPath(extension, entry.icon).toJSON() : undefined,
+		isBuiltin: true,
+		views: [{}], // shown while its views register, a moment after its container (paneCompositeBar.ts, shouldBeHidden)
+	}))), StorageScope.PROFILE, StorageTarget.MACHINE);
+}
+
+// --- The desk of a project opened for the first time (R3) --------------------------------------------------------
+
+/** `WebviewInput.typeId`, the serializer id a saved webview tab carries. */
+const WEBVIEW_EDITOR_TYPE_ID = 'workbench.editors.webviewInput';
+const MAIN_THREAD_WEBVIEW_PREFIX = 'mainThreadWebview-';
+
+let placedDesk = false;
+
+/**
+ * Sprint 152 (R3, A3): the desk of a project window with no saved tabs, as a restore brings it back: Home's and the
+ * Task board's tabs, pinned, Home in front, named and with their icons from the first frame. They are saved webview
+ * tabs (`WebviewEditorInputSerializer`), so they fill exactly as a relaunch's do: once the extension's serializers
+ * register, VS Code revives them, moving them to wherever the running copy of the extension is. With the board's flag
+ * off, Home stands alone. Undefined in a window with no folder, with no permanent tabs in the manifest, or with no
+ * saved webview tabs to restore (the plain desk, A3's fallback).
+ */
+export function ritemarkFirstDesk(accessor: ServicesAccessor, frame = ritemarkFrame, canRestore = () => !!Registry.as<IEditorFactoryRegistry>(EditorExtensions.EditorFactory).getEditorSerializer(WEBVIEW_EDITOR_TYPE_ID)): { grid: ISerializedGrid; group: number } | undefined {
+	const extension = ritemarkBuiltinExtensionLocation(frame);
+	if (!extension || !frame.extension || accessor.get(IWorkspaceContextService).getWorkbenchState() === WorkbenchState.EMPTY || !canRestore()) {
+		return undefined;
+	}
+	const configurationService = accessor.get(IConfigurationService);
+	const tabs = frame.permanentTabs.filter(entry => !entry.setting || configurationService.getValue(entry.setting) !== false);
+	if (!tabs.length) {
+		return undefined;
+	}
+	const media = joinPath(extension, 'media');
+	// The origin VS Code gives a panel the extension makes (mainThreadWebviewPanels.ts: one per view type and extension,
+	// kept in application storage), so the page's storage is the same whichever made the tab
+	const origins = new Memento<Record<string, string>>('mainThreadWebviewPanel.origins', accessor.get(IStorageService));
+	const originState = origins.getMemento(StorageScope.APPLICATION, StorageTarget.MACHINE);
+	const originOf = (providedId: string) => {
+		const key = JSON.stringify({ viewType: providedId, key: frame.extension });
+		if (typeof originState[key] !== 'string') {
+			originState[key] = generateUuid();
+			origins.saveMemento();
+		}
+		return originState[key];
+	};
+	const editors = tabs.map(entry => {
+		const providedId = entry.viewType.startsWith(MAIN_THREAD_WEBVIEW_PREFIX) ? entry.viewType.slice(MAIN_THREAD_WEBVIEW_PREFIX.length) : entry.viewType;
+		return ({
+		id: WEBVIEW_EDITOR_TYPE_ID,
+		value: JSON.stringify({
+			origin: originOf(providedId),
+			viewType: entry.viewType,
+			providedId,
+			title: entry.title,
+			options: { retainContextWhenHidden: true, allowScripts: true, localResourceRoots: [media.toJSON()] },
+			extensionLocation: extension.toJSON(),
+			extensionId: frame.extension,
+			state: undefined,
+			iconPath: entry.icon ? { light: joinPath(extension, entry.icon.light).toJSON(), dark: joinPath(extension, entry.icon.dark).toJSON() } : undefined,
+		}),
+		});
+	});
+	const front = Math.max(0, tabs.findIndex(entry => entry.viewType === frame.deskFront));
+	const group: ISerializedEditorGroupModel = { id: 1, editors, mru: [front, ...editors.map((_, index) => index).filter(index => index !== front)], sticky: editors.length - 1 };
+	return { grid: { orientation: Orientation.HORIZONTAL, width: 800, height: 600, root: { type: 'branch', size: 600, data: [{ type: 'leaf', size: 800, data: group }] } }, group: group.id };
+}
+
+/** editorPart.ts: the first desk was placed (its grid was made from `ritemarkFirstDesk`), so its tabs may be released. */
+export function ritemarkNoteFirstDeskPlaced(): void {
+	placedDesk = true;
+}
+
+/**
+ * Sprint 152 (R3): the tabs placed on a first desk wait for the extension to fill them. When it can't (it isn't there
+ * once the extensions are read, or its activation hasn't even begun after RITEMARK_SLOT_RELEASE_MS), they go. An
+ * activation that began may have registered the serializers and filled them before it failed, so its tabs stay:
+ * a placed tab with nothing to fill it would stay empty, and come back at every start (A3). An extension may dispose
+ * a permanent tab (patch 019 stops only people and commands).
+ */
+class RitemarkFirstDeskRelease extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkFirstDeskRelease';
+
+	constructor(
+		@IEditorService private readonly editorService: IEditorService,
+		@IExtensionService extensionService: IExtensionService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+		const id = ritemarkFrame.extension;
+		if (!placedDesk || !id) {
+			return;
+		}
+		const started = () => !!extensionService.getExtensionsStatus()[id]?.activationStarted;
+		extensionService.whenInstalledExtensionsRegistered().then(() => {
+			if (!this._store.isDisposed && !extensionService.extensions.some(extension => ExtensionIdentifier.equals(extension.identifier, id))) {
+				this.release('Ritemark is not installed');
+			}
+		});
+		this._register(disposableTimeout(() => {
+			if (!started()) {
+				this.release('Ritemark has not started');
+			}
+		}, RITEMARK_SLOT_RELEASE_MS));
+	}
+
+	private release(why: string): void {
+		const viewTypes = new Set(ritemarkFrame.permanentTabs.map(entry => entry.viewType));
+		const placed = this.editorService.editors.filter(editor => viewTypes.has((editor as { viewType?: unknown }).viewType as string));
+		if (placed.length) {
+			ritemarkSlotReleased(this.logService, 'the first desk\'s tabs', why);
+			placed.forEach(editor => editor.dispose());
+		}
+		this.dispose();
+	}
+}
+
+registerWorkbenchContribution2(RitemarkFirstDeskRelease.ID, RitemarkFirstDeskRelease, WorkbenchPhase.AfterRestored);
+
+// --- The AI column's release ---------------------------------------------------------------------------------------
+
+/**
+ * Sprint 152 (PR 1's review, finding 3): when Ritemark AI never registers in a project window (the extension not read
+ * at all), layout.ts closes the AI column as its slot's release. That closing is the shell's, not the person's, so it
+ * must not last: this note makes the next start show the column again with the layout. The person's own toggle
+ * afterwards takes it away, so a column the person closed stays closed (decision 2).
+ */
+export const RITEMARK_AI_COLUMN_RELEASED_KEY = 'ritemark.aiColumn.released';
+
+let aiColumnBroughtBack = false;
+
+/**
+ * The column was released twice in a row: it waits, closed, for Ritemark AI, and opens once when Ritemark AI is
+ * registered again (RitemarkAiColumnRelease), instead of opening and closing at every start while it is off.
+ */
+export const RITEMARK_AI_COLUMN_WAITING_KEY = 'ritemark.aiColumn.waiting';
+
+/**
+ * layout.ts: whether this start brought the released column back. If Ritemark AI is missing again, the column is
+ * released again and waits (RITEMARK_AI_COLUMN_WAITING_KEY) rather than being brought back at the next start: an
+ * extension that stays off (disabled, quarantined) would otherwise open and close the column at every start.
+ */
+export function ritemarkAiColumnBroughtBack(broughtBack?: boolean): boolean {
+	if (broughtBack !== undefined) {
+		aiColumnBroughtBack = broughtBack;
+	}
+	return aiColumnBroughtBack;
+}
+
+class RitemarkAiColumnRelease extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkAiColumnRelease';
+
+	constructor(
+		@IWorkbenchLayoutService layoutService: IWorkbenchLayoutService,
+		@IStorageService storageService: IStorageService,
+		@IExtensionService extensionService: IExtensionService,
+		@IViewDescriptorService viewDescriptorService: IViewDescriptorService,
+	) {
+		super();
+		this._register(layoutService.onDidChangePartVisibility(e => {
+			if (e.partId === Parts.AUXILIARYBAR_PART) {
+				storageService.remove(RITEMARK_AI_COLUMN_RELEASED_KEY, StorageScope.WORKSPACE);
+				storageService.remove(RITEMARK_AI_COLUMN_WAITING_KEY, StorageScope.WORKSPACE);
+			}
+		}));
+		// Ritemark AI is back after starts without it: the column opens once, where the person had it
+		extensionService.whenInstalledExtensionsRegistered().then(() => {
+			const aiColumn = ritemarkFrame.aiColumn;
+			if (!this._store.isDisposed && aiColumn && storageService.getBoolean(RITEMARK_AI_COLUMN_WAITING_KEY, StorageScope.WORKSPACE, false) && viewDescriptorService.getViewContainerById(aiColumn) && !layoutService.isVisible(Parts.AUXILIARYBAR_PART)) {
+				layoutService.setPartHidden(false, Parts.AUXILIARYBAR_PART);
+			}
+		});
+	}
+}
+
+registerWorkbenchContribution2(RitemarkAiColumnRelease.ID, RitemarkAiColumnRelease, WorkbenchPhase.BlockRestore);
