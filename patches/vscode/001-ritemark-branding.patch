diff --git a/src/vs/platform/theme/test/browser/ritemarkPhosphorFont.test.ts b/src/vs/platform/theme/test/browser/ritemarkPhosphorFont.test.ts
new file mode 100644
index 00000000000..0ab2cad0d20
--- /dev/null
+++ b/src/vs/platform/theme/test/browser/ritemarkPhosphorFont.test.ts
@@ -0,0 +1,29 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { getIconsStyleSheet } from '../../browser/iconsStyleSheet.js';
+
+/**
+ * Ritemark (Sprint 145, #582): the Phosphor icon font is declared once, in codicon.css, at the place the build puts it.
+ * The icon registry's style sheet names the family for Phosphor's icons and asks for no file of its own: its bare
+ * `phosphor.woff2` was a request at the app's root that the protocol refused at every start.
+ */
+suite('Ritemark Phosphor icon font', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('the icons\' style sheet names the family and loads no Phosphor file of its own', () => {
+		const styleSheet = getIconsStyleSheet(undefined);
+		const css = styleSheet.getCSS().toString();
+		styleSheet.dispose();
+		assert.deepStrictEqual({
+			familyNamed: /\.codicon-phosphor-settings:before \{[^}]*font-family: 'phosphor'/.test(css),
+			phosphorFile: /phosphor\\?\.woff2/.test(css), // CSS.escape writes the dot as \.
+			phosphorFontFace: /@font-face \{[^}]*font-family: 'phosphor'/.test(css),
+		}, { familyNamed: true, phosphorFile: false, phosphorFontFace: false });
+	});
+});
