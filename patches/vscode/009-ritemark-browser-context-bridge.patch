+import { localize, localize2 } from '../../../../../nls.js';
+import { Codicon } from '../../../../../base/common/codicons.js';
+import { VSBuffer } from '../../../../../base/common/buffer.js';
+import { Action2, MenuId, registerAction2 } from '../../../../../platform/actions/common/actions.js';
+import { BrowserViewCommandId, isInMemoryStorageScope } from '../../../../../platform/browserView/common/browserView.js';
+import { IPlaywrightService } from '../../../../../platform/browserView/common/playwrightService.js';
+import { ICommandService } from '../../../../../platform/commands/common/commands.js';
+import { ContextKeyExpr, IContextKey, IContextKeyService, RawContextKey } from '../../../../../platform/contextkey/common/contextkey.js';
+import { ServicesAccessor } from '../../../../../platform/instantiation/common/instantiation.js';
+import { ILogService } from '../../../../../platform/log/common/log.js';
+import { IEditorService } from '../../../../services/editor/common/editorService.js';
+import { BrowserActionCategory, BrowserActionGroup, BrowserEditor, BrowserEditorContribution } from '../browserEditor.js';
+import { IBrowserViewModel } from '../../common/browserView.js';
+import { DisposableStore } from '../../../../../base/common/lifecycle.js';
+
+const CONTEXT_RITEMARK_BROWSER_ANNOTATION_MODE = new RawContextKey<boolean>(
+	'ritemarkBrowserAnnotationMode',
+	false,
+	localize('ritemark.browser.annotationModeContext', 'Whether the active browser page sends a screenshot with each AI chat turn')
+);
+
+export interface IRitemarkBrowserContextDto {
+	readonly pageId?: string;
+	readonly url?: string;
+	readonly title?: string;
+	readonly focused?: boolean;
+	readonly visible?: boolean;
+	readonly loading?: boolean;
+	readonly sharedWithAgent?: boolean;
+	readonly annotationMode?: boolean;
+	readonly summary?: string;
+	readonly summaryTruncated?: boolean;
+	readonly screenshot?: { readonly mimeType: 'image/jpeg'; readonly base64: string };
+	readonly error?: string;
+	/** Ritemark (Sprint 134, R20): the page waits for the share question's answer on the AI's sheet. */
+	readonly needsAnswer?: boolean;
+	/** Ritemark (Sprint 134, R20): the answer was about a page no longer in front; nothing was shared. */
+	readonly stale?: boolean;
+}
+
+/** Ritemark (Sprint 134, R20): the AI sheet's answer to the share question. */
+interface IRitemarkShareAnswer {
+	readonly pageId?: string;
+	readonly answer?: 'share' | 'notNow';
+	readonly withoutAsking?: boolean;
+}
+
+function activeBrowserModel(accessor: ServicesAccessor): IBrowserViewModel | undefined {
+	const editor = accessor.get(IEditorService).activeEditorPane;
+	return editor instanceof BrowserEditor ? editor.model : undefined;
+}
+
+function dtoFromModel(model: IBrowserViewModel): IRitemarkBrowserContextDto {
+	return {
+		pageId: model.id,
+		url: model.url,
+		title: model.title,
+		focused: model.focused,
+		visible: model.visible,
+		loading: model.loading,
+		sharedWithAgent: model.ritemarkSharedWithAgent,
+		annotationMode: model.annotationMode,
+	};
+}
+
+function bytesToBase64(buffer: VSBuffer): string {
+	const bytes = buffer.buffer;
+	let binary = '';
+	const chunkSize = 0x8000;
+	for (let i = 0; i < bytes.length; i += chunkSize) {
+		const chunk = bytes.subarray(i, i + chunkSize);
+		binary += String.fromCharCode(...chunk);
+	}
+	return btoa(binary);
+}
+
+class RitemarkBrowserAnnotationContribution extends BrowserEditorContribution {
+	private readonly annotationContext: IContextKey<boolean>;
+
+	constructor(
+		editor: BrowserEditor,
+		@IContextKeyService contextKeyService: IContextKeyService,
+	) {
+		super(editor);
+		this.annotationContext = CONTEXT_RITEMARK_BROWSER_ANNOTATION_MODE.bindTo(contextKeyService);
+	}
+
+	protected override onModelAttached(model: IBrowserViewModel, store: DisposableStore, _isNew: boolean): void {
+		this.annotationContext.set(model.annotationMode);
+		store.add(model.onDidChangeAnnotationMode((annotate) => {
+			this.annotationContext.set(annotate);
+		}));
+	}
+
+	override onModelDetached(): void {
+		this.annotationContext.reset();
+	}
+}
+
+BrowserEditor.registerContribution(RitemarkBrowserAnnotationContribution);
+
+/**
+ * The Playwright session Ritemark reads and acts in (009 and 010). One session, so a summary's aria refs match the
+ * actions that follow; not upstream's '<default>', so Ritemark never shares Playwright state with VS Code's chat.
+ * A page shared by the person has a wildcard agent audience, so it is visible to this session.
+ */
+export const RITEMARK_PLAYWRIGHT_SESSION = 'ritemark';
+
+/** Extension command that keeps Browser Recent (extensions/ritemark/src/browser/browserNavigationRecorder.ts). */
+const RITEMARK_BROWSER_DID_NAVIGATE_COMMAND = 'ritemark.browser.didNavigate';
+
+interface IRitemarkBrowserNavigationDto {
+	readonly kind: 'navigate' | 'title' | 'favicon';
+	readonly pageId: string;
+	readonly url: string;
+	readonly title: string;
+	/** The page's main-frame load failed (the error page is showing). */
+	readonly failed: boolean;
+	/** The tab browses in an ephemeral (private) storage session. */
+	readonly ephemeral: boolean;
+	/** Sprint 134 (R18): the site's icon as a data URL, when the tab has one (Recent's rows show it). */
+	readonly favicon?: string;
+}
+
+/**
+ * Forwards top-level navigations and title changes of the browser tab this
+ * editor pane shows to the Ritemark extension, which keeps the Recent list.
+ * The extension owns every filtering rule; this only reports what the tab shows.
+ */
+class RitemarkBrowserHistoryContribution extends BrowserEditorContribution {
+	constructor(
+		editor: BrowserEditor,
+		@ICommandService private readonly commandService: ICommandService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super(editor);
+	}
+
+	protected override onModelAttached(model: IBrowserViewModel, store: DisposableStore, _isNew: boolean): void {
+		// A tab opened in the background loaded while no pane listened, so report
+		// what it shows now. The extension ignores a repeat of the tab's last address.
+		this.send(model, 'navigate', model.url, model.title);
+		store.add(model.onDidNavigate(e => this.send(model, 'navigate', e.url, e.title)));
+		store.add(model.onDidChangeTitle(e => this.send(model, 'title', model.url, e.title)));
+		store.add(model.onDidChangeFavicon(() => this.send(model, 'favicon', model.url, model.title)));
+	}
+
+	private send(model: IBrowserViewModel, kind: 'navigate' | 'title' | 'favicon', url: string, title: string): void {
+		if (!url) {
+			return;
+		}
+		const dto: IRitemarkBrowserNavigationDto = {
+			kind,
+			pageId: model.id,
+			url,
+			title,
+			failed: model.error !== undefined,
+			ephemeral: isInMemoryStorageScope(model.storageScope),
+			favicon: model.favicon,
+		};
+		this.commandService.executeCommand(RITEMARK_BROWSER_DID_NAVIGATE_COMMAND, dto).catch(err => {
+			this.logService.trace('[Ritemark] Browser Recent: navigation not delivered', err);
+		});
+	}
+}
+
+BrowserEditor.registerContribution(RitemarkBrowserHistoryContribution);
+
+class GetActiveBrowserContextAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.GetActiveContext,
+			title: localize2('ritemark.browser.getActiveContext', 'Get Active Browser Context'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	run(accessor: ServicesAccessor): IRitemarkBrowserContextDto {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		return dtoFromModel(model);
+	}
+}
+
+class GetActiveBrowserSummaryAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.GetActiveSummary,
+			title: localize2('ritemark.browser.getActiveSummary', 'Get Active Browser Summary'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserContextDto> {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		if (!model.ritemarkSharedWithAgent) {
+			return { ...dtoFromModel(model), error: 'Browser page is not shared with Ritemark AI context.' };
+		}
+
+		const playwrightService = accessor.get(IPlaywrightService);
+		const summary = await playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+		return { ...dtoFromModel(model), summary };
+	}
+}
+
+class CaptureActiveBrowserViewportAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.CaptureActiveViewport,
+			title: localize2('ritemark.browser.captureActiveViewport', 'Capture Active Browser Viewport'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserContextDto> {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		if (!model.annotationMode) {
+			return { ...dtoFromModel(model), error: 'Annotation mode is not enabled for the active browser tab.' };
+		}
+
+		const screenshot = await model.captureScreenshot({ quality: 90 });
+		return {
+			...dtoFromModel(model),
+			screenshot: {
+				mimeType: 'image/jpeg',
+				base64: bytesToBase64(screenshot),
+			},
+		};
+	}
+}
+
+class ToggleBrowserAnnotationModeAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.ToggleAnnotationMode,
+			title: localize2('ritemark.browser.toggleAnnotationMode', 'Include Screenshot in AI Chat Context'),
+			category: BrowserActionCategory,
+			icon: Codicon.deviceCamera,
+			f1: true,
+			toggled: ContextKeyExpr.equals(CONTEXT_RITEMARK_BROWSER_ANNOTATION_MODE.key, true),
+			menu: {
+				id: MenuId.BrowserActionsToolbar,
+				group: BrowserActionGroup.Tools,
+				order: 3,
+			},
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserContextDto> {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		await model.setAnnotationMode(!model.annotationMode);
+		return dtoFromModel(model);
+	}
+}
+
+class EnsureActiveBrowserSharedAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.EnsureActiveBrowserShared,
+			title: localize2('ritemark.browser.ensureActiveBrowserShared', 'Ensure Active Browser Is Shared with AI'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	/**
+	 * Ritemark (Sprint 134, R20): the share question waits on the AI's sheet, not in a dialog (#455). With no answer, a
+	 * page not yet shared is shared only when the person chose to share pages without asking; otherwise the result says
+	 * `needsAnswer` and nothing opens. With the sheet's answer for `pageId`: Share shares it (the box stores the choice),
+	 * Not now shares nothing, and an answer about a page no longer in front is `stale` and shares nothing.
+	 */
+	async run(accessor: ServicesAccessor, answer?: IRitemarkShareAnswer): Promise<IRitemarkBrowserContextDto> {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		if (answer?.answer) {
+			if (answer.pageId !== model.id) {
+				return { ...dtoFromModel(model), stale: true };
+			}
+			if (answer.answer === 'share' && !model.ritemarkSharedWithAgent) {
+				await model.shareWithAgentAnswered(answer.withoutAsking === true);
+			}
+			return dtoFromModel(model);
+		}
+		if (!model.ritemarkSharedWithAgent) {
+			if (!model.ritemarkSharesWithoutAsking) {
+				return { ...dtoFromModel(model), needsAnswer: true };
+			}
+			await model.setSharedWithAgent(true);
+		}
+		return dtoFromModel(model);
+	}
+}
+
+class GetBrowserAnnotationModeAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.GetAnnotationMode,
+			title: localize2('ritemark.browser.getAnnotationMode', 'Get Browser Annotation Mode'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	run(accessor: ServicesAccessor): IRitemarkBrowserContextDto {
+		const model = activeBrowserModel(accessor);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		return dtoFromModel(model);
+	}
+}
