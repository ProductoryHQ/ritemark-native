Ritemark Dev Launch Fallback: scripts fall back to OSS dev app if Ritemark.app missing
Sprint 36: Lets contributors run dev mode without first running a full prod build.
Sprint 55: Rebased onto VS Code 1.117.0
  - Upstream renamed binary from "Electron" to "$EXE_NAME" (= product.nameShort)
  - Fallback path updated to "Code - OSS.app/Contents/MacOS/code-oss"
---
diff --git a/scripts/code-cli.sh b/scripts/code-cli.sh
index ef466e50d07..0e8f5bebcac 100755
--- a/scripts/code-cli.sh
+++ b/scripts/code-cli.sh
@@ -14,6 +14,9 @@ function code() {
 		NAME=`node -p "require('./product.json').nameLong"`
 		EXE_NAME=`node -p "require('./product.json').nameShort"`
 		CODE="./.build/electron/$NAME.app/Contents/MacOS/$EXE_NAME"
+		if [[ ! -x "$CODE" && -x "./.build/electron/Code - OSS.app/Contents/MacOS/code-oss" ]]; then
+			CODE="./.build/electron/Code - OSS.app/Contents/MacOS/code-oss"
+		fi
 	else
 		NAME=`node -p "require('./product.json').applicationName"`
 		CODE=".build/electron/$NAME"
