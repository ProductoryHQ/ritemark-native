+	// --- Start Ritemark: shell watchdog
+	/**
+	 * Ritemark ships its editor extension as a built-in, but the seamless-update mechanism can
+	 * install a newer copy into the user extensions directory, which then wins the scanner.
+	 * If that user copy is incomplete it throws at module load, before `activate()` runs — so no
+	 * extension-side recovery can help, because the recovery code lives in the dead extension.
+	 *
+	 * This quarantines the failing user copy by renaming its directory. On the next window the
+	 * scanner cannot read its manifest, marks it invalid and filters it out, so the built-in copy
+	 * is used instead. Strictly scoped: only `ritemark.ritemark`, and only a copy that is
+	 * installed as a user extension — the built-in copy is never touched.
+	 *
+	 * @returns `true` when a copy was quarantined and the user was prompted to reload.
+	 */
+	private async _quarantineBrokenRitemarkUserExtension(extensionId: ExtensionIdentifier): Promise<boolean> {
+		if (!ExtensionIdentifier.equals(extensionId, RITEMARK_EXTENSION_ID)) {
+			return false;
+		}
+
+		try {
+			const failed = await this._extensionService.getExtension(extensionId.value);
+			if (!failed) {
+				return false;
+			}
+
+			// `isBuiltin` is unreliable here: a user copy that overrides a built-in has the flag
+			// set to true by `dedupExtensions`. Match the failing location against the installed
+			// user-type copy instead — that type is not rewritten.
+			const local = await this._extensionsWorkbenchService.queryLocal();
+			const userCopy = local.find(extension => extension.local
+				&& extension.local.type === ExtensionType.User
+				&& areSameExtensions(extension.identifier, { id: extensionId.value })
+				&& this._uriIdentityService.extUri.isEqual(extension.local.location, failed.extensionLocation));
+			if (!userCopy) {
+				// The built-in copy itself failed — quarantining it would leave no copy at all.
+				return false;
+			}
+
+			const quarantined = failed.extensionLocation.with({ path: `${failed.extensionLocation.path}${QUARANTINE_SUFFIX}` });
+			await this._fileService.move(failed.extensionLocation, quarantined, true);
+
+			this._notificationService.notify({
+				severity: Severity.Error,
+				message: localize('ritemark.updateBroken', "The installed Ritemark update could not be loaded and has been removed. Reload the window to go back to the version that came with the app."),
+				actions: {
+					primary: [toAction({ id: 'reload', label: localize('reload', "Reload Window"), run: () => this._hostService.reload() })]
+				}
+			});
+			return true;
+		} catch (err) {
+			// Never let the watchdog itself break activation-error reporting.
+			console.error(`Failed to quarantine ${RITEMARK_EXTENSION_ID}: ${err}`);
+			return false;
+		}
+	}
+	// --- End Ritemark
