+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark (Sprint 149, R2): Publish on a web page's bar, the kit's outline button (`.btn.ghost`): 10 in, radius 6,
+ * the input's hairline inside, the desk's fill, the globe at 14 and the word in 500 13. On this bar it takes the
+ * address field's height (25.5: its 1 border, 2 padding and 19.5 line, browser.css), so its edges line up with the
+ * address's, and its item gives back what it adds over the bar's 22 icons: the bar keeps its height and the page
+ * doesn't move when Publish comes or goes. Open in your browser is the bar's own icon button, as the camera beside it.
+ */
+.browser-actions-toolbar .action-item.ritemark-page-publish {
+	margin: -1.75px 0;
+	flex-shrink: 0; /* the toolbar lets its last item shrink; Publish moves into ⋯ whole when the bar is narrow, never clipped */
+}
+
+.browser-actions-toolbar .action-item.ritemark-page-publish > .action-label {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	box-sizing: border-box;
+	height: 25.5px;
+	padding: 0 10px;
+	border-radius: 6px;
+	box-shadow: inset 0 0 0 1px var(--vscode-input-border, var(--vscode-widget-border, transparent));
+	background-color: var(--vscode-ritemark-desk, var(--vscode-editor-background));
+	color: var(--vscode-foreground);
+	font-size: 13px;
+	font-weight: 500;
+	line-height: 25.5px;
+	white-space: nowrap;
+}
+
+.browser-actions-toolbar .action-item.ritemark-page-publish > .action-label:hover {
+	background-color: var(--vscode-toolbar-hoverBackground);
+}
+
+.browser-actions-toolbar .action-item.ritemark-page-publish > .action-label > .codicon {
+	font-size: 14px;
+	color: inherit;
+}
+
+/* The gap before Publish, without its line (the Experience lead, Sprint 149 answers, PR 2): the separator keeps the kit's
+   footprint (`.docbar .sep`: 6 each side of 1, 16 high, so the bar is no taller) and draws nothing; other separators stay upstream's */
+.browser-actions-toolbar .monaco-action-bar .action-item:has(+ .action-item.ritemark-page-publish) > .action-label.separator {
+	margin: 0 6px !important; /* !important: actionbar.css sets every separator's margin with !important */
+	background-color: transparent;
+}
