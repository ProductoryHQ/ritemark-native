+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize, localize2 } from '../../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../../platform/actions/common/actions.js';
+import { BrowserViewCommandId } from '../../../../../platform/browserView/common/browserView.js';
+import { IPlaywrightService } from '../../../../../platform/browserView/common/playwrightService.js';
+import { ServicesAccessor } from '../../../../../platform/instantiation/common/instantiation.js';
+import { IDialogService } from '../../../../../platform/dialogs/common/dialogs.js';
+import { ACTIVE_GROUP, IEditorService } from '../../../../services/editor/common/editorService.js';
+import { IEditorGroup, IEditorGroupsService } from '../../../../services/editor/common/editorGroupsService.js';
+import { BrowserViewUri } from '../../../../../platform/browserView/common/browserViewUri.js';
+import { BrowserActionCategory, BrowserEditor } from '../browserEditor.js';
+import { RITEMARK_PLAYWRIGHT_SESSION } from './ritemarkBrowserContextFeature.js';
+import { IBrowserViewModel, IBrowserViewWorkbenchService } from '../../common/browserView.js';
+import { IRitemarkBrowserPageDto, IRitemarkPageTarget, resolveRitemarkPageTarget, ritemarkActionArgs, ritemarkPagesReport } from '../../common/ritemarkBrowserPageTarget.js';
+import { generateUuid } from '../../../../../base/common/uuid.js';
+
+export interface IRitemarkBrowserActionResult {
+	readonly pageId?: string;
+	readonly summary?: string;
+	readonly error?: string;
+	readonly url?: string;
+	readonly title?: string;
+	/** Ritemark (#658): the page named by `pageId` is no longer open; nothing was done. */
+	readonly pageGone?: boolean;
+	/** Ritemark (#658): every browser page open in this window, by id only. The caller passes them back as `knownPageIds`. */
+	readonly pageIds?: readonly string[];
+	/** Ritemark (#658): the pages that are not in the caller's `knownPageIds` (without them, that opened during this action). */
+	readonly newPages?: readonly IRitemarkBrowserPageDto[];
+}
+
+/** The page `target` names, or the active browser tab when it names none; otherwise the result to return (#658). */
+const pause = (ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms));
+
+/**
+ * Ritemark (#658): the first read of a tab that has just opened can answer "Page not found" before the page is
+ * tracked. Wait for the load to finish (up to 5 s), then read; if the read fails or says so, wait a moment and read once more.
+ */
+async function summaryAfterLoad(model: IBrowserViewModel, playwrightService: IPlaywrightService): Promise<string> {
+	for (let waited = 0; model.loading && waited < 5000; waited += 100) {
+		await pause(100);
+	}
+	let first: string | undefined;
+	try {
+		first = await playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+	} catch {
+		first = undefined;
+	}
+	if (first !== undefined && !/Page not found/i.test(first)) {
+		return first;
+	}
+	await pause(500);
+	return playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+}
+
+export function targetModel(
+	target: IRitemarkPageTarget,
+	editorService: IEditorService,
+	browserViewWorkbenchService: IBrowserViewWorkbenchService,
+): IBrowserViewModel | IRitemarkBrowserActionResult {
+	const resolved = resolveRitemarkPageTarget(target, browserViewWorkbenchService, activeBrowserModelFromEditorService(editorService), { navigateToUrl: false });
+	return resolved.kind === 'page' ? resolved.model : resolved.kind === 'error' ? resolved.result : { error: 'No active integrated browser tab.' };
+}
+
+/**
+ * Ritemark (#658): the AI's actions never move what the person sees. An input action (click, fill, type, key, scroll,
+ * navigate into an existing page) on a page that is not in front is refused at once, before any question is asked:
+ * Playwright would wait for the element to be visible and time out, and bringing the tab forward would hide the
+ * person's document or tab. Reads (snapshot, summary) work on a hidden page and do not call this.
+ */
+export const RITEMARK_PAGE_NOT_IN_FRONT_ERROR = 'The page isn\'t in front. Ask the person to bring its browser tab forward. Nothing was done.';
+
+/**
+ * Ritemark (#658): a page is in front when the person can see its browser tab. All three must hold:
+ * - the tab is its editor group's front tab (`visibleEditorPanes` holds each group's active pane): of any desk, the
+ *   active one or not. A tab behind another editor is not in front;
+ * - the pane is visible. When the AI column is maximized the editor area is hidden: the layout hides the editor part,
+ *   which hides each group's active pane (`EditorPart` → `EditorGroupView` → `EditorPane.setVisible(false)`), while
+ *   `visibleEditorPanes` still lists it;
+ * - no other desk is maximized. A maximized desk hides the others in the editor grid, but their panes keep
+ *   `isVisible()` true, so the group is checked against the part's maximized group.
+ * Judged from the editors, not from `model.visible`, which is also false for a page that is in front but blank (the
+ * empty tab's welcome), whose load failed, or that a toast, menu, quick pick or hover covers for a moment: the AI may
+ * act in those.
+ */
+export function isPageInFront(
+	model: { readonly id: string },
+	editorService: Pick<IEditorService, 'visibleEditorPanes'>,
+	editorGroupsService: Pick<IEditorGroupsService, 'getPart'>,
+): boolean {
+	return editorService.visibleEditorPanes.some(pane =>
+		pane instanceof BrowserEditor
+		&& pane.model?.id === model.id
+		&& pane.group.activeEditorPane === pane
+		&& pane.isVisible()
+		&& isGroupShown(pane.group, editorGroupsService));
+}
+
+/** Ritemark (#658): false when another group of the group's editor part is maximized (⌘K ⌘M), hiding this one. */
+function isGroupShown(group: IEditorGroup, editorGroupsService: Pick<IEditorGroupsService, 'getPart'>): boolean {
+	const part = editorGroupsService.getPart(group);
+	if (!part.hasMaximizedGroup()) {
+		return true;
+	}
+	// `EditorPart.isGroupMaximized` is not on `IEditorPart`. Without it, the maximized group is the active one: activating
+	// another group leaves the maximized layout (`EditorPart.doRestoreGroup`), as upstream's own telemetry assumes.
+	const isGroupMaximized = (part as unknown as { isGroupMaximized?(group: IEditorGroup): boolean }).isGroupMaximized;
+	try {
+		return typeof isGroupMaximized === 'function' ? isGroupMaximized.call(part, group) : part.activeGroup.id === group.id;
+	} catch {
+		return false;
+	}
+}
+
+export function pageNotInFrontError(
+	model: { readonly id: string },
+	editorService: Pick<IEditorService, 'visibleEditorPanes'>,
+	editorGroupsService: Pick<IEditorGroupsService, 'getPart'>,
+): string | undefined {
+	return isPageInFront(model, editorService, editorGroupsService) ? undefined : RITEMARK_PAGE_NOT_IN_FRONT_ERROR;
+}
+
+export function isModel(value: IBrowserViewModel | IRitemarkBrowserActionResult): value is IBrowserViewModel {
+	return typeof (value as IBrowserViewModel).loadURL === 'function';
+}
+
+/** Runs an action and adds the window's pages to its result (#658). */
+async function withPages(
+	browserViewWorkbenchService: IBrowserViewWorkbenchService,
+	target: IRitemarkPageTarget,
+	run: () => Promise<IRitemarkBrowserActionResult>,
+): Promise<IRitemarkBrowserActionResult> {
+	const before = new Set(browserViewWorkbenchService.getKnownBrowserViews().keys());
+	const result = await run();
+	try {
+		return { ...result, ...ritemarkPagesReport(browserViewWorkbenchService, target, before, result.pageId) };
+	} catch {
+		return result;
+	}
+}
+
+async function ensureControlConsent(model: IBrowserViewModel, dialogService: IDialogService): Promise<boolean> {
+	if (model.sharedWithAgentForControl) {
+		return true;
+	}
+	// Ritemark (#658): the AI's page may not be the tab in front, so the question names it.
+	const result = await dialogService.confirm({
+		type: 'warning',
+		message: model.title
+			? localize('ritemark.browser.controlConsent.messageNamed', "Allow AI to control the browser tab \"{0}\"?", model.title)
+			: localize('ritemark.browser.controlConsent.message', "Allow AI to control this browser tab?"),
+		detail: localize('ritemark.browser.controlConsent.detail', "The AI agent will be able to navigate, click elements, fill forms, and scroll in this browser tab. You will always see actions happening in real time.\n\nGrant control only for tabs where you trust the AI's actions."),
+		primaryButton: localize('ritemark.browser.controlConsent.allow', "Allow Control"),
+		cancelButton: localize('ritemark.browser.controlConsent.deny', "Deny"),
+	});
+	if (result.confirmed) {
+		await model.setSharedWithAgentForControl(true);
+	}
+	return model.sharedWithAgentForControl;
+}
+
+/**
+ * What a result says about its page: the id, and the address and title only once the page is shared with the AI
+ * (Sprint 67 D5). Before that, the AI may learn the page's id and nothing else.
+ */
+function modelMeta(model: IBrowserViewModel): Pick<IRitemarkBrowserActionResult, 'pageId' | 'url' | 'title'> {
+	return model.ritemarkSharedWithAgent ? { pageId: model.id, url: model.url, title: model.title } : { pageId: model.id };
+}
+
+/** Ritemark (#658): a refusal names its page by id alone, shared or not: nothing was done, and nothing about the page goes back. */
+function refusal(model: IBrowserViewModel, error: string): IRitemarkBrowserActionResult {
+	return { pageId: model.id, error };
+}
+
+function isNavigationAbortError(err: unknown): boolean {
+	const message = err instanceof Error ? err.message : String(err);
+	return message.includes('(-3)') || message.includes('ERR_ABORTED');
+}
+
+class EnsureActiveBrowserControlSharedAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.EnsureActiveBrowserControlShared,
+			title: localize2('ritemark.browser.ensureActiveBrowserControlShared', 'Ensure Active Browser Has AI Control Consent'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const model = activeBrowserModelFromEditorService(editorService);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		try {
+			const granted = await ensureControlConsent(model, dialogService);
+			if (!granted) {
+				return refusal(model, 'Browser control consent was not granted.');
+			}
+			return { ...modelMeta(model) };
+		} catch (err) {
+			return { ...modelMeta(model), error: err instanceof Error ? err.message : String(err) };
+		}
+	}
+}
+
+interface IBrowserNavigateArgs extends IRitemarkPageTarget {
+	readonly url?: string;
+	readonly type?: 'url' | 'back' | 'forward' | 'reload';
+}
+
+class BrowserNavigateAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserNavigate,
+			title: localize2('ritemark.browser.agentNavigate', 'Navigate Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserNavigateArgs): Promise<IRitemarkBrowserActionResult> {
+		// ServicesAccessor is only valid during the synchronous portion of run().
+		// Capture all services up front before any await — otherwise later
+		// accessor.get() calls throw "Illegal state: service accessor is only
+		// valid during the invocation of its target method".
+		const dialogService = accessor.get(IDialogService);
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		const safeArgs = args ?? {};
+		const type = safeArgs.type ?? 'url';
+		return withPages(browserViewWorkbenchService, safeArgs, () =>
+			runNavigateInternal({ args: safeArgs, type, dialogService, editorService, editorGroupsService, playwrightService, browserViewWorkbenchService }));
+	}
+}
+
+export async function runNavigateInternal(ctx: {
+	args: IBrowserNavigateArgs;
+	type: 'url' | 'back' | 'forward' | 'reload';
+	dialogService: IDialogService;
+	editorService: IEditorService;
+	editorGroupsService: IEditorGroupsService;
+	playwrightService: IPlaywrightService;
+	browserViewWorkbenchService: IBrowserViewWorkbenchService;
+}): Promise<IRitemarkBrowserActionResult> {
+	const { args, type, dialogService, editorService, editorGroupsService, playwrightService, browserViewWorkbenchService } = ctx;
+	try {
+		if (type === 'url' && !args.url) {
+			return { error: 'navigate: url is required when type is "url".' };
+		}
+		// Ritemark (#658): the named page, or a new tab. Navigate never loads an address into some other open tab.
+		const resolved = resolveRitemarkPageTarget(args, browserViewWorkbenchService, activeBrowserModelFromEditorService(editorService), { navigateToUrl: type === 'url' });
+		if (resolved.kind === 'error') {
+			return resolved.result;
+		}
+		const model = resolved.kind === 'page' ? resolved.model : await openNewBrowserTab(editorService, args.url);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		// An existing page must be in front (a new tab is); the control question is asked only about a page the person can see.
+		const notInFront = resolved.kind === 'page' ? pageNotInFrontError(model, editorService, editorGroupsService) : undefined;
+		if (notInFront) {
+			return refusal(model, notInFront);
+		}
+		const granted = await ensureControlConsent(model, dialogService);
+		if (!granted) {
+			return refusal(model, 'Browser control consent was not granted for this tab.');
+		}
+		try {
+			if (type === 'url') {
+				if (args.url && model.url !== args.url) {
+					await model.loadURL(args.url);
+				}
+			} else if (type === 'back') {
+				await model.goBack();
+			} else if (type === 'forward') {
+				await model.goForward();
+			} else if (type === 'reload') {
+				await model.reload(false);
+			} else {
+				return refusal(model, `navigate: unknown type "${type}".`);
+			}
+		} catch (err) {
+			if (!isNavigationAbortError(err)) {
+				return { ...modelMeta(model), error: err instanceof Error ? err.message : 'navigate failed.' };
+			}
+		}
+		try {
+			const summary = await summaryAfterLoad(model, playwrightService);
+			return { ...modelMeta(model), summary };
+		} catch (err) {
+			return {
+				...modelMeta(model),
+				error: `Navigated to ${args.url ?? '(URL)'}, but reading the page summary failed: ${err instanceof Error ? err.message : String(err)}. The page may still be loading — try again.`,
+			};
+		}
+	} catch (err) {
+		return { error: err instanceof Error ? err.message : String(err) };
+	}
+}
+
+function activeBrowserModelFromEditorService(editorService: IEditorService): IBrowserViewModel | undefined {
+	const editor = editorService.activeEditorPane;
+	return editor instanceof BrowserEditor ? editor.model : undefined;
+}
+
+/**
+ * Ritemark (#658): a new browser tab for the address. It used to fall back to the first visible browser pane, or to
+ * the first browser tab in tab order, and load the address there: into a page the AI was not given.
+ *
+ * This is the one case where a tab comes forward. It cannot open in the background: sharing a tab with the AI asks the
+ * person a question, which must not be asked about a tab they cannot see. A new tab is what the person asked for when
+ * the AI has no page to act in.
+ */
+async function openNewBrowserTab(
+	editorService: IEditorService,
+	urlForNewTab: string | undefined,
+): Promise<IBrowserViewModel | undefined> {
+	if (!urlForNewTab) {
+		return undefined;
+	}
+	const resource = BrowserViewUri.forId(generateUuid());
+	const opened = await editorService.openEditor(
+		{ resource, options: { viewState: { url: urlForNewTab } } },
+		ACTIVE_GROUP,
+	);
+	return opened instanceof BrowserEditor ? opened.model : undefined;
+}
+
+/**
+ * Shared runner for the four "invoke Playwright function" actions: click,
+ * fill, type, scroll. Each captures its services up front (to avoid the
+ * "Illegal state: service accessor only valid during invocation" error when
+ * accessor.get is called after an await), then defers to this helper.
+ */
+async function runPlaywrightInvoke(ctx: {
+	editorService: IEditorService;
+	editorGroupsService: IEditorGroupsService;
+	dialogService: IDialogService;
+	playwrightService: IPlaywrightService;
+	browserViewWorkbenchService: IBrowserViewWorkbenchService;
+	target: IRitemarkPageTarget;
+	validate: () => string | null;
+	functionBody: string;
+	invokeArgs: unknown[];
+}): Promise<IRitemarkBrowserActionResult> {
+	const { browserViewWorkbenchService, target } = ctx;
+	return withPages(browserViewWorkbenchService, target, () => invokeInTarget(ctx));
+}
+
+export async function invokeInTarget(ctx: {
+	editorService: IEditorService;
+	editorGroupsService: IEditorGroupsService;
+	dialogService: IDialogService;
+	playwrightService: IPlaywrightService;
+	browserViewWorkbenchService: IBrowserViewWorkbenchService;
+	target: IRitemarkPageTarget;
+	validate: () => string | null;
+	functionBody: string;
+	invokeArgs: unknown[];
+}): Promise<IRitemarkBrowserActionResult> {
+	const { editorService, editorGroupsService, dialogService, playwrightService, browserViewWorkbenchService, target, validate, functionBody, invokeArgs } = ctx;
+	try {
+		const found = targetModel(target, editorService, browserViewWorkbenchService);
+		if (!isModel(found)) {
+			return found;
+		}
+		const model = found;
+		const validationError = validate();
+		if (validationError) {
+			return refusal(model, validationError);
+		}
+		// Being in front is decided first: the control question is never asked about a page that is not in front.
+		const notInFront = pageNotInFrontError(model, editorService, editorGroupsService);
+		if (notInFront) {
+			return refusal(model, notInFront);
+		}
+		const granted = await ensureControlConsent(model, dialogService);
+		if (!granted) {
+			return refusal(model, 'Browser control consent was not granted for this tab.');
+		}
+		const result = await playwrightService.invokeFunction(RITEMARK_PLAYWRIGHT_SESSION, model.id, functionBody, invokeArgs);
+		if (result.error) {
+			return { ...modelMeta(model), summary: result.summary, error: result.error };
+		}
+		return { ...modelMeta(model), summary: result.summary };
+	} catch (err) {
+		return { error: err instanceof Error ? err.message : String(err) };
+	}
+}
+
+interface IBrowserClickArgs extends IRitemarkPageTarget {
+	readonly ref?: string;
+	readonly selector?: string;
+	readonly button?: 'left' | 'right' | 'middle';
+	readonly dblClick?: boolean;
+}
+
+function clickFunctionBody(): string {
+	return `async (page, options) => {
+		const locator = options.ref ? page.locator('aria-ref=' + options.ref) : page.locator(options.selector);
+		if (options.dblClick) {
+			await locator.dblclick({ button: options.button || 'left' });
+		} else {
+			await locator.click({ button: options.button || 'left' });
+		}
+	}`;
+}
+
+class BrowserClickAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserClick,
+			title: localize2('ritemark.browser.agentClick', 'Click in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserClickArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		return runPlaywrightInvoke({
+			editorService,
+			editorGroupsService,
+			dialogService,
+			playwrightService,
+			browserViewWorkbenchService,
+			target: args ?? {},
+			validate: () => (!args.ref && !args.selector) ? 'click: either "ref" or "selector" is required.' : null,
+			functionBody: clickFunctionBody(),
+			invokeArgs: [ritemarkActionArgs(args)],
+		});
+	}
+}
+
+interface IBrowserFillArgs extends IRitemarkPageTarget {
+	readonly ref?: string;
+	readonly selector?: string;
+	readonly value: string;
+}
+
+function fillFunctionBody(): string {
+	return `async (page, args) => {
+		const locator = args.ref ? page.locator('aria-ref=' + args.ref) : page.locator(args.selector);
+		await locator.fill(args.value);
+	}`;
+}
+
+class BrowserFillAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserFill,
+			title: localize2('ritemark.browser.agentFill', 'Fill Input in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserFillArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		return runPlaywrightInvoke({
+			editorService,
+			editorGroupsService,
+			dialogService,
+			playwrightService,
+			browserViewWorkbenchService,
+			target: args ?? {},
+			validate: () => {
+				if (!args.ref && !args.selector) return 'fill: either "ref" or "selector" is required.';
+				if (typeof args.value !== 'string') return 'fill: "value" must be a string.';
+				return null;
+			},
+			functionBody: fillFunctionBody(),
+			invokeArgs: [ritemarkActionArgs(args)],
+		});
+	}
+}
+
+interface IBrowserTypeArgs extends IRitemarkPageTarget {
+	readonly text?: string;
+	readonly key?: string;
+}
+
+function typeFunctionBody(): string {
+	return `async (page, args) => {
+		if (args.key) {
+			await page.keyboard.press(args.key);
+		} else if (typeof args.text === 'string') {
+			const focused = await page.evaluate(() => {
+				const el = document.activeElement;
+				if (!el) {
+					return { editable: false, description: 'no focused element' };
+				}
+				const tagName = el.tagName.toLowerCase();
+				const inputType = tagName === 'input' ? (el.getAttribute('type') || '').toLowerCase() : null;
+				const nonTextInputTypes = ['button', 'checkbox', 'color', 'file', 'hidden', 'image', 'radio', 'range', 'reset', 'submit'];
+				const editable = tagName === 'textarea'
+					|| (tagName === 'input' && !nonTextInputTypes.includes(inputType || ''))
+					|| (el instanceof HTMLElement && el.isContentEditable);
+				const label = el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.textContent?.slice(0, 80) || null;
+				return { editable, tagName, inputType, label };
+			});
+			if (!focused.editable) {
+				throw new Error('type: no editable element is focused. Use browser_fill with a ref/selector, or browser_click an input first.');
+			}
+			await page.keyboard.type(args.text);
+		}
+	}`;
+}
+
+class BrowserTypeAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserType,
+			title: localize2('ritemark.browser.agentType', 'Type Keystrokes in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserTypeArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		return runPlaywrightInvoke({
+			editorService,
+			editorGroupsService,
+			dialogService,
+			playwrightService,
+			browserViewWorkbenchService,
+			target: args ?? {},
+			validate: () => (typeof args.text !== 'string' && !args.key) ? 'type: either "text" or "key" is required.' : null,
+			functionBody: typeFunctionBody(),
+			invokeArgs: [ritemarkActionArgs(args)],
+		});
+	}
+}
+
+interface IBrowserScrollArgs extends IRitemarkPageTarget {
+	readonly direction?: 'up' | 'down' | 'top' | 'bottom' | 'into-view';
+	readonly amount?: number;
+	readonly ref?: string;
+	readonly selector?: string;
+}
+
+function scrollFunctionBody(): string {
+	return `async (page, args) => {
+		const direction = args.direction || 'down';
+		const amount = typeof args.amount === 'number' ? args.amount : 600;
+		if (direction === 'into-view') {
+			const locator = args.ref ? page.locator('aria-ref=' + args.ref) : page.locator(args.selector);
+			await locator.scrollIntoViewIfNeeded();
+			return;
+		}
+		if (direction === 'top') {
+			await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
+			return;
+		}
+		if (direction === 'bottom') {
+			await page.evaluate(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'instant' }));
+			return;
+		}
+		const delta = direction === 'up' ? -amount : amount;
+		await page.mouse.wheel(0, delta);
+	}`;
+}
+
+class BrowserScrollAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserScroll,
+			title: localize2('ritemark.browser.agentScroll', 'Scroll Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserScrollArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const editorGroupsService = accessor.get(IEditorGroupsService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		return runPlaywrightInvoke({
+			editorService,
+			editorGroupsService,
+			dialogService,
+			playwrightService,
+			browserViewWorkbenchService,
+			target: args ?? {},
+			validate: () => (args.direction === 'into-view' && !args.ref && !args.selector)
+				? 'scroll: "ref" or "selector" required when direction is "into-view".'
+				: null,
+			functionBody: scrollFunctionBody(),
+			invokeArgs: [ritemarkActionArgs(args)],
+		});
+	}
+}
+
+// Sprint 78: browser_snapshot — read-only ARIA outline, no control consent required.
+// Mirrors the existing GetActiveSummary bridge (including its sharedWithAgent
+// read-consent guard) but returns the same IRitemarkBrowserActionResult shape
+// as the other agent actions so it fits cleanly into the MCP tool family.
+class BrowserSnapshotAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserSnapshot,
+			title: localize2('ritemark.browser.agentSnapshot', 'Snapshot Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args?: IRitemarkPageTarget): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const browserViewWorkbenchService = accessor.get(IBrowserViewWorkbenchService);
+		const target = args ?? {};
+		return withPages(browserViewWorkbenchService, target, () => this.snapshot(target, editorService, playwrightService, browserViewWorkbenchService));
+	}
+
+	private async snapshot(
+		target: IRitemarkPageTarget,
+		editorService: IEditorService,
+		playwrightService: IPlaywrightService,
+		browserViewWorkbenchService: IBrowserViewWorkbenchService,
+	): Promise<IRitemarkBrowserActionResult> {
+		try {
+			const found = targetModel(target, editorService, browserViewWorkbenchService);
+			if (!isModel(found)) {
+				return found;
+			}
+			const model = found;
+			// Snapshot is read-only — no control consent needed, but it must respect
+			// the same read-consent gate as the GetActiveSummary bridge: never expose
+			// URL, title, or page content for a tab the user has not shared with AI.
+			if (!model.ritemarkSharedWithAgent) {
+				return { error: 'Browser page is not shared with Ritemark AI context. Ask the user to share the browser tab with AI first.' };
+			}
+			try {
+				const summary = await playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+				return { ...modelMeta(model), summary };
+			} catch (err) {
+				return {
+					...modelMeta(model),
+					error: `Snapshot failed: ${err instanceof Error ? err.message : String(err)}. The browser tab may not be tracked yet — navigate to a page first.`,
+				};
+			}
+		} catch (err) {
+			return { error: err instanceof Error ? err.message : String(err) };
+		}
+	}
+}
+
+registerAction2(EnsureActiveBrowserControlSharedAction);
+registerAction2(BrowserNavigateAction);
+registerAction2(BrowserClickAction);
+registerAction2(BrowserFillAction);
+registerAction2(BrowserTypeAction);
+registerAction2(BrowserScrollAction);
+registerAction2(BrowserSnapshotAction);
