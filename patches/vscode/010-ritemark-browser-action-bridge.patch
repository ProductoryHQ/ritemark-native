+					);
+					if (existing) {
+						return {
+							editor: existing,
+							options: { ...options, pinned: true },
+						};
+					}
+
+					const browserInput = browserViewWorkbenchService.getOrCreateLazy({
+						id: generateUuid(),
+						url: fileUrl,
+					});
+					void browserInput.resolve();
+					return {
+						editor: browserInput,
+						options: { ...options, pinned: true },
+					};
+				},
+			},
+		);
