+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize, localize2 } from '../../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../../platform/actions/common/actions.js';
+import { BrowserViewCommandId } from '../../../../../platform/browserView/common/browserView.js';
+import { IPlaywrightService } from '../../../../../platform/browserView/common/playwrightService.js';
+import { BrowserViewUri } from '../../../../../platform/browserView/common/browserViewUri.js';
+import { ServicesAccessor } from '../../../../../platform/instantiation/common/instantiation.js';
+import { IDialogService } from '../../../../../platform/dialogs/common/dialogs.js';
+import { ACTIVE_GROUP, IEditorService } from '../../../../services/editor/common/editorService.js';
+import { BrowserActionCategory, BrowserEditor } from '../browserEditor.js';
+import { RITEMARK_PLAYWRIGHT_SESSION } from './ritemarkBrowserContextFeature.js';
+import { IBrowserViewModel } from '../../common/browserView.js';
+import { Schemas } from '../../../../../base/common/network.js';
+import { generateUuid } from '../../../../../base/common/uuid.js';
+
+export interface IRitemarkBrowserActionResult {
+	readonly pageId?: string;
+	readonly summary?: string;
+	readonly error?: string;
+	readonly url?: string;
+	readonly title?: string;
+}
+
+async function ensureControlConsent(model: IBrowserViewModel, dialogService: IDialogService): Promise<boolean> {
+	if (model.sharedWithAgentForControl) {
+		return true;
+	}
+	const result = await dialogService.confirm({
+		type: 'warning',
+		message: localize('ritemark.browser.controlConsent.message', "Allow AI to control this browser tab?"),
+		detail: localize('ritemark.browser.controlConsent.detail', "The AI agent will be able to navigate, click elements, fill forms, and scroll in this browser tab. You will always see actions happening in real time.\n\nGrant control only for tabs where you trust the AI's actions."),
+		primaryButton: localize('ritemark.browser.controlConsent.allow', "Allow Control"),
+		cancelButton: localize('ritemark.browser.controlConsent.deny', "Deny"),
+	});
+	if (result.confirmed) {
+		await model.setSharedWithAgentForControl(true);
+	}
+	return model.sharedWithAgentForControl;
+}
+
+function modelMeta(model: IBrowserViewModel): Pick<IRitemarkBrowserActionResult, 'pageId' | 'url' | 'title'> {
+	return { pageId: model.id, url: model.url, title: model.title };
+}
+
+function isNavigationAbortError(err: unknown): boolean {
+	const message = err instanceof Error ? err.message : String(err);
+	return message.includes('(-3)') || message.includes('ERR_ABORTED');
+}
+
+class EnsureActiveBrowserControlSharedAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.EnsureActiveBrowserControlShared,
+			title: localize2('ritemark.browser.ensureActiveBrowserControlShared', 'Ensure Active Browser Has AI Control Consent'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const model = activeBrowserModelFromEditorService(editorService);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		try {
+			const granted = await ensureControlConsent(model, dialogService);
+			if (!granted) {
+				return { ...modelMeta(model), error: 'Browser control consent was not granted.' };
+			}
+			return { ...modelMeta(model) };
+		} catch (err) {
+			return { ...modelMeta(model), error: err instanceof Error ? err.message : String(err) };
+		}
+	}
+}
+
+interface IBrowserNavigateArgs {
+	readonly url?: string;
+	readonly type?: 'url' | 'back' | 'forward' | 'reload';
+}
+
+class BrowserNavigateAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserNavigate,
+			title: localize2('ritemark.browser.agentNavigate', 'Navigate Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserNavigateArgs): Promise<IRitemarkBrowserActionResult> {
+		// ServicesAccessor is only valid during the synchronous portion of run().
+		// Capture all services up front before any await — otherwise later
+		// accessor.get() calls throw "Illegal state: service accessor is only
+		// valid during the invocation of its target method".
+		const dialogService = accessor.get(IDialogService);
+		const editorService = accessor.get(IEditorService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		const type = args.type ?? 'url';
+		return runNavigateInternal({ args, type, dialogService, editorService, playwrightService });
+	}
+}
+
+async function runNavigateInternal(ctx: {
+	args: IBrowserNavigateArgs;
+	type: 'url' | 'back' | 'forward' | 'reload';
+	dialogService: IDialogService;
+	editorService: IEditorService;
+	playwrightService: IPlaywrightService;
+}): Promise<IRitemarkBrowserActionResult> {
+	const { args, type, dialogService, editorService, playwrightService } = ctx;
+	try {
+		const model = type === 'url'
+			? await getOrCreateBrowserModelFromEditorService(editorService, args.url)
+			: activeBrowserModelFromEditorService(editorService);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		const granted = await ensureControlConsent(model, dialogService);
+		if (!granted) {
+			return { ...modelMeta(model), error: 'Browser control consent was not granted for this tab.' };
+		}
+		try {
+			if (type === 'url') {
+				if (!args.url) {
+					return { ...modelMeta(model), error: 'navigate: url is required when type is "url".' };
+				}
+				if (model.url !== args.url) {
+					await model.loadURL(args.url);
+				}
+			} else if (type === 'back') {
+				await model.goBack();
+			} else if (type === 'forward') {
+				await model.goForward();
+			} else if (type === 'reload') {
+				await model.reload(false);
+			} else {
+				return { ...modelMeta(model), error: `navigate: unknown type "${type}".` };
+			}
+		} catch (err) {
+			if (!isNavigationAbortError(err)) {
+				return { ...modelMeta(model), error: err instanceof Error ? err.message : 'navigate failed.' };
+			}
+		}
+		try {
+			const summary = await playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+			return { ...modelMeta(model), summary };
+		} catch (err) {
+			return {
+				...modelMeta(model),
+				error: `Navigated to ${args.url ?? '(URL)'}, but reading the page summary failed: ${err instanceof Error ? err.message : String(err)}. The page may still be loading — try again.`,
+			};
+		}
+	} catch (err) {
+		return { error: err instanceof Error ? err.message : String(err) };
+	}
+}
+
+function activeBrowserModelFromEditorService(editorService: IEditorService): IBrowserViewModel | undefined {
+	const editor = editorService.activeEditorPane;
+	return editor instanceof BrowserEditor ? editor.model : undefined;
+}
+
+async function getOrCreateBrowserModelFromEditorService(
+	editorService: IEditorService,
+	urlForNewTab?: string,
+): Promise<IBrowserViewModel | undefined> {
+	const activePane = editorService.activeEditorPane;
+	if (activePane instanceof BrowserEditor) {
+		return activePane.model;
+	}
+	for (const pane of editorService.visibleEditorPanes) {
+		if (pane instanceof BrowserEditor) {
+			return pane.model;
+		}
+	}
+	const existingBrowserInput = editorService.editors.find((input) =>
+		input.resource?.scheme === Schemas.vscodeBrowser,
+	);
+	if (existingBrowserInput) {
+		const opened = await editorService.openEditor(existingBrowserInput);
+		if (opened instanceof BrowserEditor) {
+			return opened.model;
+		}
+	}
+	if (!urlForNewTab) {
+		return undefined;
+	}
+	const resource = BrowserViewUri.forId(generateUuid());
+	const opened = await editorService.openEditor(
+		{ resource, options: { viewState: { url: urlForNewTab } } },
+		ACTIVE_GROUP,
+	);
+	return opened instanceof BrowserEditor ? opened.model : undefined;
+}
+
+/**
+ * Shared runner for the four "invoke Playwright function" actions: click,
+ * fill, type, scroll. Each captures its services up front (to avoid the
+ * "Illegal state: service accessor only valid during invocation" error when
+ * accessor.get is called after an await), then defers to this helper.
+ */
+async function runPlaywrightInvoke(ctx: {
+	editorService: IEditorService;
+	dialogService: IDialogService;
+	playwrightService: IPlaywrightService;
+	validate: () => string | null;
+	functionBody: string;
+	invokeArgs: unknown[];
+}): Promise<IRitemarkBrowserActionResult> {
+	const { editorService, dialogService, playwrightService, validate, functionBody, invokeArgs } = ctx;
+	try {
+		const model = activeBrowserModelFromEditorService(editorService);
+		if (!model) {
+			return { error: 'No active integrated browser tab.' };
+		}
+		const granted = await ensureControlConsent(model, dialogService);
+		if (!granted) {
+			return { ...modelMeta(model), error: 'Browser control consent was not granted for this tab.' };
+		}
+		const validationError = validate();
+		if (validationError) {
+			return { ...modelMeta(model), error: validationError };
+		}
+		const result = await playwrightService.invokeFunction(RITEMARK_PLAYWRIGHT_SESSION, model.id, functionBody, invokeArgs);
+		if (result.error) {
+			return { ...modelMeta(model), summary: result.summary, error: result.error };
+		}
+		return { ...modelMeta(model), summary: result.summary };
+	} catch (err) {
+		return { error: err instanceof Error ? err.message : String(err) };
+	}
+}
+
+interface IBrowserClickArgs {
+	readonly ref?: string;
+	readonly selector?: string;
+	readonly button?: 'left' | 'right' | 'middle';
+	readonly dblClick?: boolean;
+}
+
+function clickFunctionBody(): string {
+	return `async (page, options) => {
+		const locator = options.ref ? page.locator('aria-ref=' + options.ref) : page.locator(options.selector);
+		if (options.dblClick) {
+			await locator.dblclick({ button: options.button || 'left' });
+		} else {
+			await locator.click({ button: options.button || 'left' });
+		}
+	}`;
+}
+
+class BrowserClickAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserClick,
+			title: localize2('ritemark.browser.agentClick', 'Click in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserClickArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		return runPlaywrightInvoke({
+			editorService,
+			dialogService,
+			playwrightService,
+			validate: () => (!args.ref && !args.selector) ? 'click: either "ref" or "selector" is required.' : null,
+			functionBody: clickFunctionBody(),
+			invokeArgs: [args],
+		});
+	}
+}
+
+interface IBrowserFillArgs {
+	readonly ref?: string;
+	readonly selector?: string;
+	readonly value: string;
+}
+
+function fillFunctionBody(): string {
+	return `async (page, args) => {
+		const locator = args.ref ? page.locator('aria-ref=' + args.ref) : page.locator(args.selector);
+		await locator.fill(args.value);
+	}`;
+}
+
+class BrowserFillAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserFill,
+			title: localize2('ritemark.browser.agentFill', 'Fill Input in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserFillArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		return runPlaywrightInvoke({
+			editorService,
+			dialogService,
+			playwrightService,
+			validate: () => {
+				if (!args.ref && !args.selector) return 'fill: either "ref" or "selector" is required.';
+				if (typeof args.value !== 'string') return 'fill: "value" must be a string.';
+				return null;
+			},
+			functionBody: fillFunctionBody(),
+			invokeArgs: [args],
+		});
+	}
+}
+
+interface IBrowserTypeArgs {
+	readonly text?: string;
+	readonly key?: string;
+}
+
+function typeFunctionBody(): string {
+	return `async (page, args) => {
+		if (args.key) {
+			await page.keyboard.press(args.key);
+		} else if (typeof args.text === 'string') {
+			const focused = await page.evaluate(() => {
+				const el = document.activeElement;
+				if (!el) {
+					return { editable: false, description: 'no focused element' };
+				}
+				const tagName = el.tagName.toLowerCase();
+				const inputType = tagName === 'input' ? (el.getAttribute('type') || '').toLowerCase() : null;
+				const nonTextInputTypes = ['button', 'checkbox', 'color', 'file', 'hidden', 'image', 'radio', 'range', 'reset', 'submit'];
+				const editable = tagName === 'textarea'
+					|| (tagName === 'input' && !nonTextInputTypes.includes(inputType || ''))
+					|| (el instanceof HTMLElement && el.isContentEditable);
+				const label = el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.textContent?.slice(0, 80) || null;
+				return { editable, tagName, inputType, label };
+			});
+			if (!focused.editable) {
+				throw new Error('type: no editable element is focused. Use browser_fill with a ref/selector, or browser_click an input first.');
+			}
+			await page.keyboard.type(args.text);
+		}
+	}`;
+}
+
+class BrowserTypeAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserType,
+			title: localize2('ritemark.browser.agentType', 'Type Keystrokes in Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserTypeArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		return runPlaywrightInvoke({
+			editorService,
+			dialogService,
+			playwrightService,
+			validate: () => (typeof args.text !== 'string' && !args.key) ? 'type: either "text" or "key" is required.' : null,
+			functionBody: typeFunctionBody(),
+			invokeArgs: [args],
+		});
+	}
+}
+
+interface IBrowserScrollArgs {
+	readonly direction?: 'up' | 'down' | 'top' | 'bottom' | 'into-view';
+	readonly amount?: number;
+	readonly ref?: string;
+	readonly selector?: string;
+}
+
+function scrollFunctionBody(): string {
+	return `async (page, args) => {
+		const direction = args.direction || 'down';
+		const amount = typeof args.amount === 'number' ? args.amount : 600;
+		if (direction === 'into-view') {
+			const locator = args.ref ? page.locator('aria-ref=' + args.ref) : page.locator(args.selector);
+			await locator.scrollIntoViewIfNeeded();
+			return;
+		}
+		if (direction === 'top') {
+			await page.evaluate(() => window.scrollTo({ top: 0, behavior: 'instant' }));
+			return;
+		}
+		if (direction === 'bottom') {
+			await page.evaluate(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'instant' }));
+			return;
+		}
+		const delta = direction === 'up' ? -amount : amount;
+		await page.mouse.wheel(0, delta);
+	}`;
+}
+
+class BrowserScrollAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserScroll,
+			title: localize2('ritemark.browser.agentScroll', 'Scroll Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor, args: IBrowserScrollArgs): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const dialogService = accessor.get(IDialogService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		return runPlaywrightInvoke({
+			editorService,
+			dialogService,
+			playwrightService,
+			validate: () => (args.direction === 'into-view' && !args.ref && !args.selector)
+				? 'scroll: "ref" or "selector" required when direction is "into-view".'
+				: null,
+			functionBody: scrollFunctionBody(),
+			invokeArgs: [args],
+		});
+	}
+}
+
+// Sprint 78: browser_snapshot — read-only ARIA outline, no control consent required.
+// Mirrors the existing GetActiveSummary bridge (including its sharedWithAgent
+// read-consent guard) but returns the same IRitemarkBrowserActionResult shape
+// as the other agent actions so it fits cleanly into the MCP tool family.
+class BrowserSnapshotAction extends Action2 {
+	constructor() {
+		super({
+			id: BrowserViewCommandId.BrowserSnapshot,
+			title: localize2('ritemark.browser.agentSnapshot', 'Snapshot Active Browser (AI)'),
+			category: BrowserActionCategory,
+			f1: false,
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<IRitemarkBrowserActionResult> {
+		const editorService = accessor.get(IEditorService);
+		const playwrightService = accessor.get(IPlaywrightService);
+		try {
+			const model = activeBrowserModelFromEditorService(editorService);
+			if (!model) {
+				return { error: 'No active integrated browser tab.' };
+			}
+			// Snapshot is read-only — no control consent needed, but it must respect
+			// the same read-consent gate as the GetActiveSummary bridge: never expose
+			// URL, title, or page content for a tab the user has not shared with AI.
+			if (!model.ritemarkSharedWithAgent) {
+				return { error: 'Browser page is not shared with Ritemark AI context. Ask the user to share the browser tab with AI first.' };
+			}
+			try {
+				const summary = await playwrightService.getSummary(RITEMARK_PLAYWRIGHT_SESSION, model.id);
+				return { ...modelMeta(model), summary };
+			} catch (err) {
+				return {
+					...modelMeta(model),
+					error: `Snapshot failed: ${err instanceof Error ? err.message : String(err)}. The browser tab may not be tracked yet — navigate to a page first.`,
+				};
+			}
+		} catch (err) {
+			return { error: err instanceof Error ? err.message : String(err) };
+		}
+	}
+}
+
