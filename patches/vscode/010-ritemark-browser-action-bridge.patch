+/*
+ * Ritemark (Sprint 149, R2, PR 2): the page's bar. At the right end of the browser's bar, after the address and the
+ * camera, as the Experience lead drew it (experience 39, frame 1, redrawn 4 November with the address kept):
+ *   - Open in your browser, an icon button (Phosphor arrow-square-out), on every local page;
+ *   - Publish, the outline button with the globe, on a project page only, and only once the extension sets
+ *     `ritemark.publish.ready` (PR 4), so nobody can press it before it works.
+ * Both call the extension (extensions/ritemark/src/browser/pageCommands.ts) with the tab's address. The bar, the
+ * address, back, forward and reload stay the browser's own (Jarmo, 4 November); the session is unchanged (decision 4).
+ */
+
+export const OPEN_PAGE_IN_BROWSER_ID = 'workbench.action.browser.ritemarkOpenPageInBrowser';
+export const PUBLISH_PAGE_ID = 'workbench.action.browser.ritemarkPublishPage';
+
+/** The bar's group for Publish: after the tools (camera, Open in your browser), so the gap of a separator stands before it. */
+const RITEMARK_PAGE_GROUP = '6_ritemark_page';
+
+// Phosphor 400 (Regular): the font patch 001 registers (iconRegistry.ts) and codicon.css declares, its definition
+// shared, not copied; the glyphs by code point
+const phosphorFont = { id: 'phosphor', definition: getIconRegistry().getIconFont('phosphor') ?? { weight: '400', src: [] } };
+const openPageIcon = getIconRegistry().registerIcon('ritemark-page-open-in-browser', { font: phosphorFont, fontCharacter: '\\e5de' }, localize('ritemark.page.openInBrowserIcon', "Icon of Open in your browser on a web page's bar (Phosphor arrow-square-out)."));
+const publishPageIcon = getIconRegistry().registerIcon('ritemark-page-publish', { font: phosphorFont, fontCharacter: '\\e28e' }, localize('ritemark.page.publishIcon', "Icon of Publish on a web page's bar (Phosphor globe-simple)."));
+
+/**
+ * Keeps the tab's two keys on the bar's own context: whether the address is a local page, and whether that page is in
+ * the open project. They follow every navigation and a change of the project's folders.
+ */
+class RitemarkBrowserPageContribution extends BrowserEditorContribution {
+	private readonly _localPage: IContextKey<boolean>;
+	private readonly _projectPage: IContextKey<boolean>;
+
+	constructor(
+		editor: BrowserEditor,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IWorkspaceContextService private readonly _workspaceContextService: IWorkspaceContextService,
+	) {
+		super(editor);
+		this._localPage = RITEMARK_BROWSER_LOCAL_PAGE.bindTo(contextKeyService);
+		this._projectPage = RITEMARK_BROWSER_PROJECT_PAGE.bindTo(contextKeyService);
+		this._register(this._workspaceContextService.onDidChangeWorkspaceFolders(() => this._update(this.editor.model?.url ?? this.editor.input?.url)));
+	}
+
+	override prerenderInput(input: BrowserEditorInput): void {
+		this._update(input.url);
+	}
+
+	protected override onModelAttached(model: IBrowserViewModel, store: DisposableStore): void {
+		this._update(model.url);
+		store.add(model.onDidNavigate(event => {
+			if (this.editor.model === model) { // not a tab this pane showed before, navigating behind it
+				this._update(event.url);
+			}
+		}));
+	}
+
+	override onModelDetached(): void {
+		this._localPage.reset();
+		this._projectPage.reset();
+	}
+
+	override getActionViewItem(action: IAction, options: IActionViewItemOptions, instantiationService: IInstantiationService): IActionViewItem | undefined {
+		if (action.id === PUBLISH_PAGE_ID && action instanceof MenuItemAction) {
+			return instantiationService.createInstance(RitemarkPublishActionViewItem, action, { hoverDelegate: options.hoverDelegate });
+		}
+		return undefined;
+	}
+
+	private _update(url: string | undefined): void {
+		const kind = ritemarkBrowserPageKind(url, file => !!this._workspaceContextService.getWorkspaceFolder(file));
+		this._localPage.set(kind.local);
+		this._projectPage.set(kind.project);
+	}
+}
+
+/** Publish as the lead drew it: an outline button with the globe and its word, not an icon alone. */
+class RitemarkPublishActionViewItem extends MenuEntryActionViewItem {
