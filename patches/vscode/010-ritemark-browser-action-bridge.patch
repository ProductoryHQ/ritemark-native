@@ -0,0 +1,94 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize } from '../../../../nls.js';
+import { Schemas } from '../../../../base/common/network.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ContextKeyExpr, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+
+/*
+ * Ritemark (Sprint 149, R2): what the page on the desk is, for its bar's Open in your browser and Publish.
+ *
+ * A browser tab's resource is `vscode-browser:`, never the file, so no `resourceExtname` clause can
+ * see a page. These two keys are set per tab, on the bar's own scoped context, from the address the
+ * tab shows (ritemarkBrowserPageFeature.ts), and they follow it: a link to a website in the same tab
+ * clears both, and back sets them again.
+ *
+ * Pure, so the rules are tested under node (test/common/ritemarkBrowserPage.test.ts).
+ */
+
+/** A `file:` address of a `.html`/`.htm` file, inside the project or not. Gates Open in your browser. */
+export const RITEMARK_BROWSER_LOCAL_PAGE = new RawContextKey<boolean>('ritemarkBrowserLocalPage', false, localize('ritemark.browserLocalPage', "Whether the browser tab shows a web page file from this computer"));
+
+/** A local page inside one of the open project's folders. Gates Publish. */
+export const RITEMARK_BROWSER_PROJECT_PAGE = new RawContextKey<boolean>('ritemarkBrowserProjectPage', false, localize('ritemark.browserProjectPage', "Whether the browser tab shows a web page file from the open project"));
+
+/** Set by the Ritemark extension once publishing works (Sprint 149, PR 4); until then Publish never shows. */
+export const RITEMARK_PUBLISH_READY_KEY = 'ritemark.publish.ready';
+
+/** Open in your browser: every local page. */
+export const RITEMARK_OPEN_PAGE_IN_BROWSER_WHEN = RITEMARK_BROWSER_LOCAL_PAGE.isEqualTo(true);
+
+/** Publish: a project page, and only once the extension says publishing is ready. */
+export const RITEMARK_PUBLISH_PAGE_WHEN = ContextKeyExpr.and(
+	RITEMARK_BROWSER_PROJECT_PAGE.isEqualTo(true),
+	ContextKeyExpr.equals(RITEMARK_PUBLISH_READY_KEY, true),
+);
+
+/** Upstream's Open in External Browser (in the bar's ⋯): everything but a local page, which has its own button. */
+export const RITEMARK_UPSTREAM_OPEN_EXTERNAL_WHEN = RITEMARK_BROWSER_LOCAL_PAGE.negate();
+
+/** The extension's commands the two buttons call (extensions/ritemark/src/browser/pageCommands.ts). */
+export const RITEMARK_OPEN_PAGE_IN_SYSTEM_BROWSER_COMMAND = 'ritemark.page.openInSystemBrowser';
+export const RITEMARK_PUBLISH_PAGE_COMMAND = 'ritemark.page.publish';
+
+/**
+ * Whether a tab's address is on this computer (`file:`), a page or any other file. Upstream's Open in External Browser
+ * (All commands) sends such an address to the extension's guarded opener, never to the system's opener as it is: a
+ * `.html` that is a link to `run.command` would run it, and any other file would open in its own app.
+ */
+export function ritemarkIsLocalAddress(url: string | undefined): boolean {
+	return !!url && /^\s*file:/i.test(url);
+}
+
+export interface IRitemarkBrowserPageKind {
+	readonly local: boolean;
+	readonly project: boolean;
+}
+
+const NOT_A_PAGE: IRitemarkBrowserPageKind = { local: false, project: false };
+
+/**
+ * The file a tab's address names, when it is a local page: `file:` and a `.html`/`.htm` path. The query
+ * and fragment are dropped (a page's `#section` is the same file).
+ */
+export function ritemarkLocalPageFile(url: string | undefined): URI | undefined {
+	if (!url) {
+		return undefined;
+	}
+	let uri: URI;
+	try {
+		uri = URI.parse(url, true);
+	} catch {
+		return undefined;
+	}
+	if (uri.scheme !== Schemas.file || !/\.html?$/i.test(uri.path)) {
+		return undefined;
+	}
+	return uri.with({ query: '', fragment: '' });
+}
+
+/**
+ * What a tab's address is: a local page, and a project page when `isInProject` says the file is inside
+ * the open project. The workbench answers that by the workspace's folders; the extension checks the
+ * boundary again by real path before anything is published (pageCommands.ts).
+ */
+export function ritemarkBrowserPageKind(url: string | undefined, isInProject: (file: URI) => boolean): IRitemarkBrowserPageKind {
+	const file = ritemarkLocalPageFile(url);
+	if (!file) {
+		return NOT_A_PAGE;
+	}
+	return { local: true, project: isInProject(file) };
+}
