--- /dev/null
+++ b/src/vs/workbench/contrib/browserView/test/common/ritemarkBrowserPageTarget.test.ts
@@ -0,0 +1,123 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { IRitemarkKnownPages, IRitemarkTargetPage, resolveRitemarkPageTarget, RITEMARK_NO_ACTIVE_PAGE_ERROR, RITEMARK_PAGE_GONE_ERROR, RITEMARK_PAGE_NOT_SHARED_ERROR, ritemarkActionArgs, ritemarkPagesReport } from '../../common/ritemarkBrowserPageTarget.js';
+
+/** Ritemark (#658): the page an AI action acts in is the one named by id, never the tab in front. */
+suite('Ritemark browser page target', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	function page(id: string, shared = true): IRitemarkTargetPage {
+		return { id, url: `http://127.0.0.1/${id}`, title: `Page ${id}`, ritemarkSharedWithAgent: shared };
+	}
+
+	function windowOf(...models: IRitemarkTargetPage[]): IRitemarkKnownPages<IRitemarkTargetPage> {
+		const views = new Map(models.map(model => [model.id, { model }] as const));
+		return { getKnownBrowserViews: () => views };
+	}
+
+	const a = page('a');
+	const b = page('b');
+	const c = page('c');
+	const threePages = windowOf(a, b, c);
+
+	test('three pages, another one active: an action acts in the turn\'s page', () => {
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, a, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, b, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, undefined, { navigateToUrl: false }),
+			],
+			[{ kind: 'page', model: c }, { kind: 'page', model: c }, { kind: 'page', model: c }],
+		);
+	});
+
+	test('a page that has gone is an error, never the active tab', () => {
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'gone' }, threePages, a, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'gone' }, threePages, a, { navigateToUrl: true }),
+				resolveRitemarkPageTarget({ pageId: 'gone', newTab: true }, threePages, a, { navigateToUrl: true }),
+			],
+			[
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+			],
+		);
+	});
+
+	test('navigate never loads an address into another open tab', () => {
+		assert.deepStrictEqual(
+			[
+				// The turn's page: the address loads there, whichever tab is in front.
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, a, { navigateToUrl: true }),
+				// The turn has no page: a new tab, even with browser tabs open and one in front.
+				resolveRitemarkPageTarget({ newTab: true }, threePages, a, { navigateToUrl: true }),
+				// No page named and no browser tab in front (a document is): a new tab, not the first browser tab.
+				resolveRitemarkPageTarget({}, threePages, undefined, { navigateToUrl: true }),
+				// Back, forward and reload without a page and with no browser tab in front: nothing to act in.
+				resolveRitemarkPageTarget({}, threePages, undefined, { navigateToUrl: false }),
+			],
+			[
+				{ kind: 'page', model: c },
+				{ kind: 'newTab' },
+				{ kind: 'newTab' },
+				{ kind: 'error', result: { error: RITEMARK_NO_ACTIVE_PAGE_ERROR } },
+			],
+		);
+	});
+
+	test('a page the AI was not given must be shared already', () => {
+		const popup = page('popup', false);
+		const withPopup = windowOf(a, b, c, popup);
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'popup', requireShared: true }, withPopup, popup, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'b', requireShared: true }, withPopup, popup, { navigateToUrl: false }),
+				// The turn's own page keeps the control question, which shares it on Allow.
+				resolveRitemarkPageTarget({ pageId: 'popup' }, withPopup, a, { navigateToUrl: false }),
+			],
+			[
+				{ kind: 'error', result: { pageId: 'popup', error: RITEMARK_PAGE_NOT_SHARED_ERROR } },
+				{ kind: 'page', model: b },
+				{ kind: 'page', model: popup },
+			],
+		);
+	});
+
+	test('new pages are named once, a page not shared by its id alone', () => {
+		const popup = page('popup', false);
+		const shared = page('shared');
+		const after = windowOf(a, b, c, popup, shared);
+		assert.deepStrictEqual(
+			[
+				ritemarkPagesReport(after, {}, new Set(['a', 'b', 'c']), 'c'),
+				ritemarkPagesReport(after, { knownPageIds: ['a', 'b', 'c', 'popup', 'shared'] }, new Set(['a', 'b', 'c', 'popup', 'shared']), 'c'),
+				ritemarkPagesReport(after, { knownPageIds: ['a', 'b', 'c', 'popup'] }, new Set(['a', 'b', 'c', 'popup', 'shared']), 'c'),
+			],
+			[
+				{
+					pageIds: ['a', 'b', 'c', 'popup', 'shared'],
+					newPages: [
+						{ pageId: 'popup', shared: false },
+						{ pageId: 'shared', shared: true, title: 'Page shared', url: 'http://127.0.0.1/shared' },
+					],
+				},
+				{ pageIds: ['a', 'b', 'c', 'popup', 'shared'], newPages: [] },
+				{ pageIds: ['a', 'b', 'c', 'popup', 'shared'], newPages: [{ pageId: 'shared', shared: true, title: 'Page shared', url: 'http://127.0.0.1/shared' }] },
+			],
+		);
+	});
+
+	test('the page target does not reach the function that runs in the page', () => {
+		assert.deepStrictEqual(
+			ritemarkActionArgs({ selector: '#btn', pageId: 'c', requireShared: true, knownPageIds: ['a'], newTab: false }),
+			{ selector: '#btn' },
+		);
+	});
+});
diff --git a/src/vs/workbench/contrib/browserView/test/electron-browser/features/ritemarkBrowserActionFeature.test.ts b/src/vs/workbench/contrib/browserView/test/electron-browser/features/ritemarkBrowserActionFeature.test.ts
new file mode 100644
index 00000000000..dd63f850d69
--- /dev/null
+++ b/src/vs/workbench/contrib/browserView/test/electron-browser/features/ritemarkBrowserActionFeature.test.ts
@@ -0,0 +1,270 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { createStubInstance } from 'sinon';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { IDialogService } from '../../../../../../platform/dialogs/common/dialogs.js';
+import { IPlaywrightService } from '../../../../../../platform/browserView/common/playwrightService.js';
+import { IEditorService } from '../../../../../services/editor/common/editorService.js';
+import { IEditorGroupsService } from '../../../../../services/editor/common/editorGroupsService.js';
+import { IBrowserViewModel, IBrowserViewWorkbenchService } from '../../../common/browserView.js';
+import { RITEMARK_PAGE_GONE_ERROR } from '../../../common/ritemarkBrowserPageTarget.js';
+import { BrowserEditor } from '../../../electron-browser/browserEditor.js';
+import { invokeInTarget, isModel, RITEMARK_PAGE_NOT_IN_FRONT_ERROR, runNavigateInternal, targetModel } from '../../../electron-browser/features/ritemarkBrowserActionFeature.js';
+
+/**
+ * Ritemark (#658): the real action path (`targetModel`, `invokeInTarget`, `runNavigateInternal`), with a fake editor
+ * service whose active browser is another page. The AI's action goes to the turn's page by id; it never acts in the
+ * active tab, and it never brings a tab forward or asks about one the person cannot see. "In front" is the front tab
+ * of an editor group (`visibleEditorPanes`), whose pane is visible (not under a maximized AI column) and whose group is
+ * not hidden by another maximized desk; not the model's `visible`, which is false for a blank, failed or covered page.
+ */
+suite('Ritemark browser actions (#658)', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	interface IFakePage extends Pick<IBrowserViewModel, 'id' | 'url' | 'title' | 'visible' | 'error' | 'ritemarkSharedWithAgent' | 'sharedWithAgentForControl'> {
+		/** The page's tab is the front tab of its group (any desk). */
+		inFront: boolean;
+		/** The page's group (desk); 1 unless set. */
+		group?: number;
+		/** The pane is hidden with the editor area: the AI column is maximized (`EditorPane.isVisible()` is false). */
+		paneHidden?: boolean;
+		loaded: string[];
+		loadURL(url: string): Promise<void>;
+		reload(): Promise<void>;
+		setSharedWithAgentForControl(shared: boolean): Promise<void>;
+	}
+
+	function page(id: string, inFront: boolean): IFakePage {
+		const fake: IFakePage = {
+			id, url: `http://127.0.0.1/${id}`, title: `Page ${id}`, visible: inFront, error: undefined, inFront,
+			ritemarkSharedWithAgent: true, sharedWithAgentForControl: true,
+			loaded: [],
+			async loadURL(url: string) { fake.loaded.push(url); },
+			async reload() { fake.loaded.push('(reload)'); },
+			async setSharedWithAgentForControl(shared: boolean) { (fake as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = shared; },
+		};
+		return fake;
+	}
+
+	function browserPane(model: IFakePage): BrowserEditor {
+		const pane = createStubInstance(BrowserEditor);
+		Object.defineProperty(pane, 'model', { value: model });
+		// The pane is its group's active pane, as `visibleEditorPanes` lists them.
+		Object.defineProperty(pane, 'group', { value: { id: model.group ?? 1, activeEditorPane: pane } });
+		pane.isVisible.returns(!model.paneHidden);
+		return pane as unknown as BrowserEditor;
+	}
+
+	function setup(opts: {
+		pages: IFakePage[];
+		active: IFakePage | undefined;
+		confirm?: boolean;
+		/** The maximized desk (⌘K ⌘M), if any. */
+		maximizedGroup?: number;
+		/** The part has no `isGroupMaximized` (it is not on `IEditorPart`): the maximized desk is then the active group. */
+		noIsGroupMaximized?: boolean;
+	}) {
+		const log = { openEditor: 0, confirm: 0, invoked: [] as string[], opened: [] as unknown[] };
+		// The pane a new tab opens in (the one case where a tab comes forward).
+		const newTab = page('new', true);
+		(newTab as { url: string }).url = 'about:blank';
+		(newTab as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = false;
+		const newPane = browserPane(newTab);
+		const editorService = {
+			activeEditorPane: opts.active ? browserPane(opts.active) : undefined,
+			// The front tab of each group: the pages in front (a document in front of a page leaves it out).
+			get visibleEditorPanes() { return opts.pages.filter(p => p.inFront).map(browserPane); },
+			findEditors: () => [],
+			openEditor: async (...args: unknown[]) => { log.openEditor++; log.opened.push(args); return newPane; },
+		} as unknown as IEditorService;
+		const part = {
+			hasMaximizedGroup: () => opts.maximizedGroup !== undefined,
+			activeGroup: { id: opts.maximizedGroup ?? 1 },
+			...(opts.noIsGroupMaximized ? {} : { isGroupMaximized: (group: { id: number }) => group.id === opts.maximizedGroup }),
+		};
+		const editorGroupsService = { getPart: () => part } as unknown as IEditorGroupsService;
+		const views = new Map(opts.pages.map(p => [p.id, { model: p }] as const));
+		const browserViewWorkbenchService = { getKnownBrowserViews: () => views } as unknown as IBrowserViewWorkbenchService;
+		const dialogService = { confirm: async () => { log.confirm++; return { confirmed: opts.confirm ?? true }; } } as unknown as IDialogService;
+		const playwrightService = {
+			invokeFunction: async (_session: string, id: string) => { log.invoked.push(id); return { summary: `summary ${id}` }; },
+			getSummary: async (_session: string, id: string) => `summary ${id}`,
+		} as unknown as IPlaywrightService;
+		return { log, editorService, editorGroupsService, browserViewWorkbenchService, dialogService, playwrightService, newTab };
+	}
+
+	test('targetModel finds the turn\'s page by id, not the active browser tab', () => {
+		const a = page('a', true);
+		const c = page('c', false);
+		const s = setup({ pages: [a, page('b', false), c], active: a });
+		const found = targetModel({ pageId: 'c' }, s.editorService, s.browserViewWorkbenchService);
+		assert.ok(isModel(found));
+		assert.strictEqual((found as unknown as IFakePage).id, 'c');
+		assert.deepStrictEqual(targetModel({ pageId: 'gone' }, s.editorService, s.browserViewWorkbenchService), { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR });
+	});
+
+	test('an input action in the turn\'s page, which is in front, acts in it and not in the active tab', async () => {
+		const a = page('a', false);
+		const c = page('c', true);
+		const s = setup({ pages: [a, c], active: a });
+		const result = await invokeInTarget({ ...s, target: { pageId: 'c' }, validate: () => null, functionBody: '', invokeArgs: [] });
+		assert.strictEqual(result.error, undefined);
