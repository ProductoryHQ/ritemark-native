+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { IRitemarkKnownPages, IRitemarkTargetPage, resolveRitemarkPageTarget, RITEMARK_NO_ACTIVE_PAGE_ERROR, RITEMARK_PAGE_GONE_ERROR, RITEMARK_PAGE_NOT_SHARED_ERROR, ritemarkActionArgs, ritemarkPagesReport } from '../../common/ritemarkBrowserPageTarget.js';
+
+/** Ritemark (#658): the page an AI action acts in is the one named by id, never the tab in front. */
+suite('Ritemark browser page target', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	function page(id: string, shared = true): IRitemarkTargetPage {
+		return { id, url: `http://127.0.0.1/${id}`, title: `Page ${id}`, ritemarkSharedWithAgent: shared };
+	}
+
+	function windowOf(...models: IRitemarkTargetPage[]): IRitemarkKnownPages<IRitemarkTargetPage> {
+		const views = new Map(models.map(model => [model.id, { model }] as const));
+		return { getKnownBrowserViews: () => views };
+	}
+
+	const a = page('a');
+	const b = page('b');
+	const c = page('c');
+	const threePages = windowOf(a, b, c);
+
+	test('three pages, another one active: an action acts in the turn\'s page', () => {
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, a, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, b, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, undefined, { navigateToUrl: false }),
+			],
+			[{ kind: 'page', model: c }, { kind: 'page', model: c }, { kind: 'page', model: c }],
+		);
+	});
+
+	test('a page that has gone is an error, never the active tab', () => {
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'gone' }, threePages, a, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'gone' }, threePages, a, { navigateToUrl: true }),
+				resolveRitemarkPageTarget({ pageId: 'gone', newTab: true }, threePages, a, { navigateToUrl: true }),
+			],
+			[
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+				{ kind: 'error', result: { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } },
+			],
+		);
+	});
+
+	test('navigate never loads an address into another open tab', () => {
+		assert.deepStrictEqual(
+			[
+				// The turn's page: the address loads there, whichever tab is in front.
+				resolveRitemarkPageTarget({ pageId: 'c' }, threePages, a, { navigateToUrl: true }),
+				// The turn has no page: a new tab, even with browser tabs open and one in front.
+				resolveRitemarkPageTarget({ newTab: true }, threePages, a, { navigateToUrl: true }),
+				// No page named and no browser tab in front (a document is): a new tab, not the first browser tab.
+				resolveRitemarkPageTarget({}, threePages, undefined, { navigateToUrl: true }),
+				// Back, forward and reload without a page and with no browser tab in front: nothing to act in.
+				resolveRitemarkPageTarget({}, threePages, undefined, { navigateToUrl: false }),
+			],
+			[
+				{ kind: 'page', model: c },
+				{ kind: 'newTab' },
+				{ kind: 'newTab' },
+				{ kind: 'error', result: { error: RITEMARK_NO_ACTIVE_PAGE_ERROR } },
+			],
+		);
+	});
+
+	test('a page the AI was not given must be shared already', () => {
+		const popup = page('popup', false);
+		const withPopup = windowOf(a, b, c, popup);
+		assert.deepStrictEqual(
+			[
+				resolveRitemarkPageTarget({ pageId: 'popup', requireShared: true }, withPopup, popup, { navigateToUrl: false }),
+				resolveRitemarkPageTarget({ pageId: 'b', requireShared: true }, withPopup, popup, { navigateToUrl: false }),
+				// The turn's own page keeps the control question, which shares it on Allow.
+				resolveRitemarkPageTarget({ pageId: 'popup' }, withPopup, a, { navigateToUrl: false }),
+			],
+			[
+				{ kind: 'error', result: { pageId: 'popup', error: RITEMARK_PAGE_NOT_SHARED_ERROR } },
+				{ kind: 'page', model: b },
+				{ kind: 'page', model: popup },
+			],
+		);
+	});
+
+	test('new pages are named once, a page not shared by its id alone', () => {
+		const popup = page('popup', false);
+		const shared = page('shared');
+		const after = windowOf(a, b, c, popup, shared);
+		assert.deepStrictEqual(
+			[
+				ritemarkPagesReport(after, {}, new Set(['a', 'b', 'c']), 'c'),
+				ritemarkPagesReport(after, { knownPageIds: ['a', 'b', 'c', 'popup', 'shared'] }, new Set(['a', 'b', 'c', 'popup', 'shared']), 'c'),
+				ritemarkPagesReport(after, { knownPageIds: ['a', 'b', 'c', 'popup'] }, new Set(['a', 'b', 'c', 'popup', 'shared']), 'c'),
+			],
+			[
+				{
+					pageIds: ['a', 'b', 'c', 'popup', 'shared'],
+					newPages: [
+						{ pageId: 'popup', shared: false },
+						{ pageId: 'shared', shared: true, title: 'Page shared', url: 'http://127.0.0.1/shared' },
+					],
+				},
+				{ pageIds: ['a', 'b', 'c', 'popup', 'shared'], newPages: [] },
+				{ pageIds: ['a', 'b', 'c', 'popup', 'shared'], newPages: [{ pageId: 'shared', shared: true, title: 'Page shared', url: 'http://127.0.0.1/shared' }] },
+			],
+		);
+	});
+
+	test('the page target does not reach the function that runs in the page', () => {
+		assert.deepStrictEqual(
+			ritemarkActionArgs({ selector: '#btn', pageId: 'c', requireShared: true, knownPageIds: ['a'], newTab: false }),
+			{ selector: '#btn' },
+		);
+	});
+});
