@@ -0,0 +1,125 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * Ritemark (#658): which browser page an AI action acts in.
+ *
+ * The extension names the page the AI's turn was given, and an action finds that page by its id. A tab or desk
+ * brought to the front during the turn (a popup, the person's own click) never moves the AI's actions, and a page
+ * that has gone is an error, never the active tab instead. Navigate with an address loads it into the named page, or
+ * opens a new tab; it never loads it into some other open tab. Without `pageId` (a caller that names no page), an
+ * action acts in the active browser tab, and navigate with an address opens a new tab when no browser tab is active.
+ *
+ * Pure: the action feature (`ritemarkBrowserActionFeature.ts`) passes the window's pages and the active one.
+ */
+
+export interface IRitemarkPageTarget {
+	/** The turn's page, or a page a tool result named. */
+	readonly pageId?: string;
+	/** The page is not the turn's (the AI named it from a tool result): it must be shared already; no action shares it. */
+	readonly requireShared?: boolean;
+	/** The page ids the caller knew after its last action, so a new page is named once. */
+	readonly knownPageIds?: readonly string[];
+	/** navigate with an address only: the turn has no page, so the address opens in a new tab. */
+	readonly newTab?: boolean;
+}
+
+/** What the target logic reads of a browser page (an `IBrowserViewModel`). */
+export interface IRitemarkTargetPage {
+	readonly id: string;
+	readonly url: string;
+	readonly title: string;
+	readonly ritemarkSharedWithAgent: boolean;
+}
+
+/** The window's browser pages by id (`IBrowserViewWorkbenchService.getKnownBrowserViews()`). */
+export interface IRitemarkKnownPages<M extends IRitemarkTargetPage> {
+	getKnownBrowserViews(): ReadonlyMap<string, { readonly model: M | undefined }>;
+}
+
+/** A browser page that opened since the caller last looked. Title and address only when it is shared. */
+export interface IRitemarkBrowserPageDto {
+	readonly pageId: string;
+	readonly shared: boolean;
+	readonly title?: string;
+	readonly url?: string;
+}
+
+/** The fields of an action's result that the target decides when it finds no page to act in. */
+export interface IRitemarkTargetError {
+	readonly pageId?: string;
+	readonly pageGone?: boolean;
+	readonly error: string;
+}
+
+export const RITEMARK_PAGE_GONE_ERROR = 'The page you were given is no longer open (its tab was closed). Nothing was done. Ask the user which page to use.';
+export const RITEMARK_PAGE_NOT_SHARED_ERROR = 'This page is not shared with you, so nothing was done. Ask the user to share it with the AI (bring it to the front and answer Share this page), then try again.';
+export const RITEMARK_NO_ACTIVE_PAGE_ERROR = 'No active integrated browser tab.';
+
+export type RitemarkPageResolution<M> =
+	| { readonly kind: 'page'; readonly model: M }
+	| { readonly kind: 'newTab' }
+	| { readonly kind: 'error'; readonly result: IRitemarkTargetError };
+
+/**
+ * The page an action acts in. `navigateToUrl`: the action is navigate with an address, which may open a new tab.
+ */
+export function resolveRitemarkPageTarget<M extends IRitemarkTargetPage>(
+	target: IRitemarkPageTarget,
+	pages: IRitemarkKnownPages<M>,
+	activeModel: M | undefined,
+	options: { readonly navigateToUrl: boolean },
+): RitemarkPageResolution<M> {
+	if (typeof target.pageId === 'string') {
+		const model = pages.getKnownBrowserViews().get(target.pageId)?.model;
+		if (!model) {
+			return { kind: 'error', result: { pageId: target.pageId, pageGone: true, error: RITEMARK_PAGE_GONE_ERROR } };
+		}
+		if (target.requireShared && !model.ritemarkSharedWithAgent) {
+			// Nothing about the page (address, title) goes back: it is not shared.
+			return { kind: 'error', result: { pageId: model.id, error: RITEMARK_PAGE_NOT_SHARED_ERROR } };
+		}
+		return { kind: 'page', model };
+	}
+	if (options.navigateToUrl && (target.newTab || !activeModel)) {
+		return { kind: 'newTab' };
+	}
+	return activeModel ? { kind: 'page', model: activeModel } : { kind: 'error', result: { error: RITEMARK_NO_ACTIVE_PAGE_ERROR } };
+}
+
+/**
+ * The window's pages after an action, by id, and the ones new to the caller: those not in its `knownPageIds`, or,
+ * when it sent none, not open when the action started (`before`). The page the action acted in is not new.
+ */
+export function ritemarkPagesReport<M extends IRitemarkTargetPage>(
+	pages: IRitemarkKnownPages<M>,
+	target: IRitemarkPageTarget,
+	before: ReadonlySet<string>,
+	actedPageId: string | undefined,
+): { pageIds: string[]; newPages: IRitemarkBrowserPageDto[] } {
+	const known = pages.getKnownBrowserViews();
+	const baseline = target.knownPageIds ? new Set(target.knownPageIds) : before;
+	const newPages: IRitemarkBrowserPageDto[] = [];
+	for (const [id, input] of known) {
+		if (baseline.has(id) || id === actedPageId) {
+			continue;
+		}
+		const model = input.model;
+		newPages.push(model?.ritemarkSharedWithAgent
+			? { pageId: id, shared: true, title: model.title, url: model.url }
+			: { pageId: id, shared: false });
+	}
+	return { pageIds: [...known.keys()], newPages };
+}
+
+/** The action's own arguments, without the page target, for the function that runs in the page. */
+export function ritemarkActionArgs<T extends IRitemarkPageTarget>(args: T | undefined): Omit<T, keyof IRitemarkPageTarget> {
+	const rest: Record<string, unknown> = { ...args };
+	delete rest.pageId;
+	delete rest.requireShared;
+	delete rest.knownPageIds;
+	delete rest.newTab;
+	return rest as Omit<T, keyof IRitemarkPageTarget>;
+}
