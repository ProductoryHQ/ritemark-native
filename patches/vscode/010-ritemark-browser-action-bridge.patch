+
+		// Sprint 69: route file:// HTML opens directly to BrowserEditor. Replaces
+		// the extension-side BrowserHtmlOpenRedirector reactive-listener approach
+		// which produced visible text-tab → close → browser-tab flicker. By
+		// registering at the editor resolver level (workbench, not extension)
+		// the text editor never opens in the first place — zero flicker.
+		//
+		// Reuse rule: if a BrowserEditorInput already exists with the same file
+		// URL, focus that one instead of creating a new tab. Avoids tab pile-up
+		// when the user clicks the same .html file repeatedly.
+		//
+		// Sprint 135: upstream registers its own file:/**/*.{html,htm,mhtml,mht} entry above at
+		// option priority (a resource-backed tab with a read-only address bar). Ritemark's entry
+		// stays the default, as a plain page.
+		editorResolverService.registerEditor(
+			'**/*.{html,htm}',
+			{
+				id: BrowserEditorInput.EDITOR_ID,
+				label: localize('ritemark.browser.htmlEditorLabel', "Ritemark Browser"),
+				priority: RegisteredEditorPriority.default,
+			},
+			{
+				canSupportResource: resource => resource.scheme === Schemas.file && /\.html?$/i.test(resource.path),
+				singlePerResource: false,
+			},
+			{
+				createEditorInput: ({ resource, options }) => {
+					const fileUrl = resource.toString();
+
+					const existing = editorService.editors.find((input): input is BrowserEditorInput =>
+						input instanceof BrowserEditorInput && input.url === fileUrl,
+					);
+					if (existing) {
+						return {
+							editor: existing,
+							options: { ...options, pinned: true },
+						};
+					}
+
+					const browserInput = browserViewWorkbenchService.getOrCreateLazy({
+						id: generateUuid(),
+						url: fileUrl,
+					});
+					void browserInput.resolve();
+					return {
+						editor: browserInput,
+						options: { ...options, pinned: true },
+					};
+				},
+			},
+		);
 	}
 }
 
