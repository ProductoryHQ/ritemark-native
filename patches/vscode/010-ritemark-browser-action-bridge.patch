+import assert from 'assert';
+import { createStubInstance } from 'sinon';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { isIMenuItem, MenuId, MenuRegistry } from '../../../../../../platform/actions/common/actions.js';
+import { BrowserViewCommandId } from '../../../../../../platform/browserView/common/browserView.js';
+import { CommandsRegistry, ICommandService } from '../../../../../../platform/commands/common/commands.js';
+import { ContextKeyExpression, IContext } from '../../../../../../platform/contextkey/common/contextkey.js';
+import { ServicesAccessor } from '../../../../../../platform/instantiation/common/instantiation.js';
+import { IOpenerService } from '../../../../../../platform/opener/common/opener.js';
+import { IEditorService } from '../../../../../services/editor/common/editorService.js';
+import { IBrowserViewModel } from '../../../common/browserView.js';
+import {
+	RITEMARK_BROWSER_LOCAL_PAGE,
+	RITEMARK_BROWSER_PROJECT_PAGE,
+	RITEMARK_OPEN_PAGE_IN_SYSTEM_BROWSER_COMMAND,
+	RITEMARK_PUBLISH_READY_KEY,
+} from '../../../common/ritemarkBrowserPage.js';
+import { BrowserEditor } from '../../../electron-browser/browserEditor.js';
+import '../../../electron-browser/features/browserNavigationFeatures.js';
+import { OPEN_PAGE_IN_BROWSER_ID, PUBLISH_PAGE_ID } from '../../../electron-browser/features/ritemarkBrowserPageFeature.js';
+
+/**
+ * Ritemark (Sprint 149, PR 2, round 2): the page's bar and upstream's Open in External Browser, as they are registered.
+ * - Upstream's action, from All commands, never hands a `file:` address to the system's opener: it goes to the
+ *   extension's guarded `ritemark.page.openInSystemBrowser`, which opens a real `.html` file and refuses the rest.
+ * - The menu items' `when` and Publish's `precondition` are read from the registries, so deleting one fails here.
+ */
+suite('Ritemark browser page bar, as registered', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	function runOpenExternal(url: string) {
+		const log = { commands: [] as unknown[][], opened: [] as unknown[][] };
+		const commandService: Partial<ICommandService> = {
+			executeCommand: async (id: string, ...args: unknown[]) => { log.commands.push([id, ...args]); return undefined; },
+		};
+		const openerService: Partial<IOpenerService> = {
+			open: async (target, options) => { log.opened.push([String(target), options]); return true; },
+		};
+		const pane = createStubInstance(BrowserEditor);
+		Object.defineProperty(pane, 'model', { value: { url } as Partial<IBrowserViewModel> });
+		const services = new Map<unknown, unknown>([
+			[ICommandService, commandService],
+			[IOpenerService, openerService],
+			[IEditorService, { activeEditorPane: pane }],
+		]);
+		const accessor = { get: (id: unknown) => services.get(id) } as unknown as ServicesAccessor;
+		const command = CommandsRegistry.getCommand(BrowserViewCommandId.OpenExternal);
+		assert.ok(command, 'upstream\'s Open in External Browser is registered');
+		return { log, done: Promise.resolve(command.handler(accessor, pane)) };
+	}
+
+	test('Open in External Browser sends every file: address to the guarded opener, never to the system\'s', async () => {
+		const results: Record<string, { commands: unknown[][]; opened: string[] }> = {};
+		const addresses = {
+			page: 'file:///Users/mari/Leadership%20programme/index.html',
+			notAPage: 'file:///Users/mari/Leadership%20programme/run.command',
+			folder: 'file:///Users/mari/Leadership%20programme/',
+			upperCase: 'FILE:///Users/mari/page.html',
+			website: 'https://example.com/page.html',
+		};
+		for (const [name, url] of Object.entries(addresses)) {
+			const { log, done } = runOpenExternal(url);
+			await done;
+			results[name] = { commands: log.commands, opened: log.opened.map(o => o[0] as string) };
+		}
+		const guarded = (url: string) => ({ commands: [[RITEMARK_OPEN_PAGE_IN_SYSTEM_BROWSER_COMMAND, url]], opened: [] });
+		assert.deepStrictEqual(results, {
+			page: guarded(addresses.page),
+			notAPage: guarded(addresses.notAPage), // the extension refuses it: "This works on a web page file (.html) …"
+			folder: guarded(addresses.folder),
+			upperCase: guarded(addresses.upperCase),
+			website: { commands: [], opened: [addresses.website] },
+		});
+	});
+
+	function registered(commandId: string) {
+		const item = MenuRegistry.getMenuItems(MenuId.BrowserActionsToolbar).filter(isIMenuItem).find(i => i.command.id === commandId);
+		assert.ok(item, `${commandId} is on the bar`);
+		return item;
+	}
+
+	function shown(expr: ContextKeyExpression | undefined, values: Record<string, unknown>): boolean {
+		const context: IContext = { getValue: <T>(key: string) => values[key] as T };
+		return !expr || expr.evaluate(context);
+	}
+
+	test('the bar\'s registered items show where they should, and Publish can\'t run anywhere else', () => {
+		const local = RITEMARK_BROWSER_LOCAL_PAGE.key;
+		const project = RITEMARK_BROWSER_PROJECT_PAGE.key;
+		const states: Record<string, Record<string, unknown>> = {
+			'project page, publishing not ready': { [local]: true, [project]: true },
+			'project page, publishing ready': { [local]: true, [project]: true, [RITEMARK_PUBLISH_READY_KEY]: true },
+			'page outside the project, publishing ready': { [local]: true, [project]: false, [RITEMARK_PUBLISH_READY_KEY]: true },
+			'website, publishing ready': { [local]: false, [project]: false, [RITEMARK_PUBLISH_READY_KEY]: true },
+		};
+		const open = registered(OPEN_PAGE_IN_BROWSER_ID);
+		const publish = registered(PUBLISH_PAGE_ID);
+		const upstream = registered(BrowserViewCommandId.OpenExternal);
+		const bar: Record<string, string[]> = {};
+		for (const [name, values] of Object.entries(states)) {
+			bar[name] = [
+				...(shown(open.when, values) ? ['Open in your browser'] : []),
+				...(shown(publish.when, values) ? ['Publish'] : []),
+				...(shown(publish.command.precondition, values) ? ['Publish can run'] : []),
+				...(shown(upstream.when, values) ? ['⋯ Open in External Browser'] : []),
+			];
+		}
+		assert.deepStrictEqual(bar, {
+			'project page, publishing not ready': ['Open in your browser'],
+			'project page, publishing ready': ['Open in your browser', 'Publish', 'Publish can run'],
+			'page outside the project, publishing ready': ['Open in your browser'],
+			'website, publishing ready': ['⋯ Open in External Browser'],
+		});
+		assert.strictEqual(publish.command.tooltip, 'Get a link anyone can open');
+		assert.strictEqual(open.command.tooltip, 'Open in your browser');
+	});
+});
