+		this.options.label = true;
+		this.options.icon = false;
+		super.render(container);
+		container.classList.add('ritemark-page-publish');
+	}
+
+	protected override updateLabel(): void {
+		if (this.label) {
+			reset(this.label, renderIcon(publishPageIcon), $('span.ritemark-page-publish-label', undefined, this._commandAction.label));
+		}
+	}
+}
+
+/** The address of the tab the bar belongs to (the toolbar passes its editor), else of the browser tab in front. */
+function pageUrl(accessor: ServicesAccessor, browserEditor: unknown): string | undefined {
+	const editor = browserEditor instanceof BrowserEditor ? browserEditor : accessor.get(IEditorService).activeEditorPane;
+	return editor instanceof BrowserEditor ? editor.model?.url ?? editor.input?.url : undefined;
+}
+
+class RitemarkOpenPageInBrowserAction extends Action2 {
+	constructor() {
+		super({
+			id: OPEN_PAGE_IN_BROWSER_ID,
+			title: localize2('ritemark.page.openInBrowser', "Open in your browser"),
+			tooltip: localize('ritemark.page.openInBrowserTooltip', "Open in your browser"),
+			category: BrowserActionCategory,
+			icon: openPageIcon,
+			f1: false,
+			menu: {
+				id: MenuId.BrowserActionsToolbar,
+				group: BrowserActionGroup.Tools,
+				order: 4, // right of the camera (patch 009, order 3)
+				when: RITEMARK_OPEN_PAGE_IN_BROWSER_WHEN,
+			},
+		});
+	}
+
+	async run(accessor: ServicesAccessor, browserEditor?: unknown): Promise<void> {
+		const commandService = accessor.get(ICommandService);
+		const url = pageUrl(accessor, browserEditor);
+		if (ritemarkLocalPageFile(url)) {
+			// Only through the extension, which opens the file the name resolves to and only when that is a page itself: a
+			// `.html` that is a link to a program would run it (security review of PR 2). No fallback to the system opener.
+			await commandService.executeCommand(RITEMARK_OPEN_PAGE_IN_SYSTEM_BROWSER_COMMAND, url);
+		}
+	}
+}
+
+class RitemarkPublishPageAction extends Action2 {
+	constructor() {
+		super({
+			id: PUBLISH_PAGE_ID,
+			title: localize2('ritemark.page.publish', "Publish"),
+			tooltip: localize('ritemark.page.publishTooltip', "Get a link anyone can open"),
+			category: BrowserActionCategory,
+			icon: publishPageIcon,
+			f1: false,
+			// as its menu item's: a keybinding set in Keyboard Shortcuts can't reach it on another tab, or before PR 4
+			precondition: RITEMARK_PUBLISH_PAGE_WHEN,
+			menu: {
+				id: MenuId.BrowserActionsToolbar,
+				group: RITEMARK_PAGE_GROUP,
+				order: 1,
+				when: RITEMARK_PUBLISH_PAGE_WHEN,
+			},
+		});
+	}
+
+	async run(accessor: ServicesAccessor, browserEditor?: unknown): Promise<void> {
+		const commandService = accessor.get(ICommandService);
+		const url = pageUrl(accessor, browserEditor);
+		if (ritemarkLocalPageFile(url)) {
+			await commandService.executeCommand(RITEMARK_PUBLISH_PAGE_COMMAND, url);
+		}
+	}
+}
+
+BrowserEditor.registerContribution(RitemarkBrowserPageContribution);
+registerAction2(RitemarkOpenPageInBrowserAction);
+registerAction2(RitemarkPublishPageAction);
