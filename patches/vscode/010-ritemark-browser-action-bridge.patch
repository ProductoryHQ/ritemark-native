+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { createStubInstance } from 'sinon';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { IDialogService } from '../../../../../../platform/dialogs/common/dialogs.js';
+import { IPlaywrightService } from '../../../../../../platform/browserView/common/playwrightService.js';
+import { IEditorService } from '../../../../../services/editor/common/editorService.js';
+import { IBrowserViewModel, IBrowserViewWorkbenchService } from '../../../common/browserView.js';
+import { RITEMARK_PAGE_GONE_ERROR } from '../../../common/ritemarkBrowserPageTarget.js';
+import { BrowserEditor } from '../../../electron-browser/browserEditor.js';
+import { invokeInTarget, isModel, RITEMARK_PAGE_NOT_IN_FRONT_ERROR, runNavigateInternal, targetModel } from '../../../electron-browser/features/ritemarkBrowserActionFeature.js';
+
+/**
+ * Ritemark (#658): the real action path (`targetModel`, `invokeInTarget`, `runNavigateInternal`), with a fake editor
+ * service whose active browser is another page. The AI's action goes to the turn's page by id; it never acts in the
+ * active tab, and it never brings a tab forward or asks about one the person cannot see.
+ */
+suite('Ritemark browser actions (#658)', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	interface IFakePage extends Pick<IBrowserViewModel, 'id' | 'url' | 'title' | 'visible' | 'ritemarkSharedWithAgent' | 'sharedWithAgentForControl'> {
+		loaded: string[];
+		loadURL(url: string): Promise<void>;
+		setSharedWithAgentForControl(shared: boolean): Promise<void>;
+	}
+
+	function page(id: string, visible: boolean): IFakePage {
+		const fake: IFakePage = {
+			id, url: `http://127.0.0.1/${id}`, title: `Page ${id}`, visible,
+			ritemarkSharedWithAgent: true, sharedWithAgentForControl: true,
+			loaded: [],
+			async loadURL(url: string) { fake.loaded.push(url); },
+			async setSharedWithAgentForControl(shared: boolean) { (fake as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = shared; },
+		};
+		return fake;
+	}
+
+	function setup(opts: { pages: IFakePage[]; active: IFakePage | undefined; control?: boolean }) {
+		const log = { openEditor: 0, confirm: 0, invoked: [] as string[], opened: [] as unknown[] };
+		const pane = createStubInstance(BrowserEditor);
+		if (opts.active) {
+			Object.defineProperty(pane, 'model', { value: opts.active });
+		}
+		// The pane a new tab opens in (the one case where a tab comes forward).
+		const newTab = page('new', true);
+		(newTab as { url: string }).url = 'about:blank';
+		(newTab as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = false;
+		const newPane = createStubInstance(BrowserEditor);
+		Object.defineProperty(newPane, 'model', { value: newTab });
+		const editorService = {
+			activeEditorPane: opts.active ? pane : undefined,
+			findEditors: () => [],
+			openEditor: async (...args: unknown[]) => { log.openEditor++; log.opened.push(args); return newPane; },
+		} as unknown as IEditorService;
+		const views = new Map(opts.pages.map(p => [p.id, { model: p }] as const));
+		const browserViewWorkbenchService = { getKnownBrowserViews: () => views } as unknown as IBrowserViewWorkbenchService;
+		const dialogService = { confirm: async () => { log.confirm++; return { confirmed: true }; } } as unknown as IDialogService;
+		const playwrightService = {
+			invokeFunction: async (_session: string, id: string) => { log.invoked.push(id); return { summary: `summary ${id}` }; },
+			getSummary: async (_session: string, id: string) => `summary ${id}`,
+		} as unknown as IPlaywrightService;
+		return { log, editorService, browserViewWorkbenchService, dialogService, playwrightService, newTab };
+	}
+
+	test('targetModel finds the turn\'s page by id, not the active browser tab', () => {
+		const a = page('a', true);
+		const c = page('c', false);
+		const s = setup({ pages: [a, page('b', false), c], active: a });
+		const found = targetModel({ pageId: 'c' }, s.editorService, s.browserViewWorkbenchService);
+		assert.ok(isModel(found));
+		assert.strictEqual((found as unknown as IFakePage).id, 'c');
+		assert.deepStrictEqual(targetModel({ pageId: 'gone' }, s.editorService, s.browserViewWorkbenchService), { pageId: 'gone', pageGone: true, error: RITEMARK_PAGE_GONE_ERROR });
+	});
+
+	test('an input action in the turn\'s page, which is in front, acts in it and not in the active tab', async () => {
+		const a = page('a', false);
+		const c = page('c', true);
+		const s = setup({ pages: [a, c], active: a });
+		const result = await invokeInTarget({ ...s, target: { pageId: 'c' }, validate: () => null, functionBody: '', invokeArgs: [] });
+		assert.strictEqual(result.error, undefined);
+		assert.strictEqual(result.pageId, 'c');
+		assert.deepStrictEqual(s.log.invoked, ['c']);
+		assert.strictEqual(s.log.openEditor, 0, 'no editor is opened or revealed');
+	});
+
+	test('a page that is not in front is refused at once: no question, nothing opened, nothing done', async () => {
+		for (const control of [true, false]) {
+			const a = page('a', true); // another browser tab in front
+			const c = page('c', false);
+			(c as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = control;
+			const s = setup({ pages: [a, c], active: a });
+			const result = await invokeInTarget({ ...s, target: { pageId: 'c' }, validate: () => null, functionBody: '', invokeArgs: [] });
+			assert.strictEqual(result.error, RITEMARK_PAGE_NOT_IN_FRONT_ERROR);
+			assert.strictEqual(s.log.confirm, 0, 'the control question is never asked about a page that is not in front');
+			assert.strictEqual(s.log.openEditor, 0, 'nothing is brought forward');
+			assert.deepStrictEqual(s.log.invoked, []);
+		}
+	});
+
+	test('the control question is asked about a page in front', async () => {
+		const c = page('c', true);
+		(c as { sharedWithAgentForControl: boolean }).sharedWithAgentForControl = false;
+		const s = setup({ pages: [c], active: undefined });
+		await invokeInTarget({ ...s, target: { pageId: 'c' }, validate: () => null, functionBody: '', invokeArgs: [] });
+		assert.strictEqual(s.log.confirm, 1);
+	});
+
+	test('navigate with the turn\'s page loads the address there, never in the active tab', async () => {
+		const a = page('a', true);
+		const c = page('c', true);
+		const s = setup({ pages: [a, c], active: a });
+		const result = await runNavigateInternal({ ...s, args: { pageId: 'c', url: 'http://127.0.0.1/next' }, type: 'url' });
+		assert.strictEqual(result.error, undefined);
+		assert.deepStrictEqual([a.loaded, c.loaded], [[], ['http://127.0.0.1/next']]);
+		assert.strictEqual(s.log.openEditor, 0);
+	});
+
+	test('navigate into an existing page that is not in front is refused: nothing loaded, no question, nothing opened', async () => {
+		const a = page('a', true);
+		const c = page('c', false);
+		const s = setup({ pages: [a, c], active: a });
+		const result = await runNavigateInternal({ ...s, args: { pageId: 'c', url: 'http://127.0.0.1/next' }, type: 'url' });
+		assert.strictEqual(result.error, RITEMARK_PAGE_NOT_IN_FRONT_ERROR);
+		assert.deepStrictEqual([a.loaded, c.loaded], [[], []]);
+		assert.deepStrictEqual([s.log.confirm, s.log.openEditor], [0, 0]);
+	});
+
+	test('navigate with no page opens a new tab (the one tab that comes forward), asks about it in front, and loads the address there', async () => {
+		const a = page('a', true);
+		const s = setup({ pages: [a], active: a });
+		const result = await runNavigateInternal({ ...s, args: { newTab: true, url: 'http://127.0.0.1/new' }, type: 'url' });
+		assert.strictEqual(result.error, undefined);
+		assert.deepStrictEqual(a.loaded, [], 'the tab in front is not retargeted');
+		assert.deepStrictEqual(s.newTab.loaded, ['http://127.0.0.1/new']);
+		assert.strictEqual(s.log.openEditor, 1);
+		assert.strictEqual(s.log.confirm, 1, 'the new tab is in front, so the control question is about a page the person sees');
+	});
+});
