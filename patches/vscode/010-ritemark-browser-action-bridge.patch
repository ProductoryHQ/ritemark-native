+			results.push(await invokeInTarget({ ...s, target: { pageId: 'c' }, validate: () => null, functionBody: '', invokeArgs: [] }));
+			results.push(await runNavigateInternal({ ...s, args: { pageId: 'c', url: 'http://127.0.0.1/next' }, type: 'url' }));
