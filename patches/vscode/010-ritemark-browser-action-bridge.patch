@@ -0,0 +1,106 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { extUri } from '../../../../../base/common/resources.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { ContextKeyExpression, IContext } from '../../../../../platform/contextkey/common/contextkey.js';
+import {
+	RITEMARK_BROWSER_LOCAL_PAGE,
+	RITEMARK_BROWSER_PROJECT_PAGE,
+	RITEMARK_OPEN_PAGE_IN_BROWSER_WHEN,
+	RITEMARK_PUBLISH_PAGE_WHEN,
+	RITEMARK_PUBLISH_READY_KEY,
+	RITEMARK_UPSTREAM_OPEN_EXTERNAL_WHEN,
+	ritemarkBrowserPageKind,
+	ritemarkLocalPageFile,
+} from '../../common/ritemarkBrowserPage.js';
+
+/** Ritemark (Sprint 149, R2): the page's bar shows Open in your browser on a local page, Publish on a project page once ready. */
+suite('Ritemark browser page bar', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const project = URI.file('/Users/mari/Leadership programme');
+	const inProject = (file: URI) => extUri.isEqualOrParent(file, project);
+
+	const addresses: Record<string, string> = {
+		projectPage: 'file:///Users/mari/Leadership%20programme/Harbour%20programme.html',
+		projectPageInFolder: 'file:///Users/mari/Leadership%20programme/pages/Index.HTM#part-2',
+		outsidePage: 'file:///Users/mari/Downloads/Elsewhere.html',
+		siblingFolderPage: 'file:///Users/mari/Leadership%20programme%20old/page.html',
+		projectNotAPage: 'file:///Users/mari/Leadership%20programme/brief.md',
+		projectFolderItself: 'file:///Users/mari/Leadership%20programme/',
+		website: 'https://example.com/page.html',
+		localServer: 'http://127.0.0.1:8080/index.html',
+		blank: '',
+	};
+
+	test('each address is a local page, a project page, or neither', () => {
+		const kinds: Record<string, string> = {};
+		for (const [name, url] of Object.entries(addresses)) {
+			const kind = ritemarkBrowserPageKind(url, inProject);
+			kinds[name] = kind.project ? 'project' : kind.local ? 'local' : 'neither';
+		}
+		assert.deepStrictEqual(kinds, {
+			projectPage: 'project',
+			projectPageInFolder: 'project',
+			outsidePage: 'local',
+			siblingFolderPage: 'local',
+			projectNotAPage: 'neither',
+			projectFolderItself: 'neither',
+			website: 'neither',
+			localServer: 'neither',
+			blank: 'neither',
+		});
+	});
+
+	test('the page\'s file drops the address\'s fragment and query', () => {
+		assert.deepStrictEqual(
+			[
+				ritemarkLocalPageFile(addresses.projectPageInFolder)?.toString(),
+				ritemarkLocalPageFile('file:///tmp/page.html?x=1')?.toString(),
+				ritemarkLocalPageFile(undefined),
+			],
+			['file:///Users/mari/Leadership%20programme/pages/Index.HTM', 'file:///tmp/page.html', undefined],
+		);
+	});
+
+	function context(values: Record<string, unknown>): IContext {
+		return { getValue: <T>(key: string) => values[key] as T };
+	}
+
+	function shown(when: ContextKeyExpression | undefined, values: Record<string, unknown>): boolean {
+		return !when || when.evaluate(context(values));
+	}
+
+	test('Open in your browser shows on every local page; Publish only on a project page once publishing is ready', () => {
+		const local = RITEMARK_BROWSER_LOCAL_PAGE.key;
+		const projectKey = RITEMARK_BROWSER_PROJECT_PAGE.key;
+		const states: Record<string, Record<string, unknown>> = {
+			'project page, publishing not ready (PR 2 alone)': { [local]: true, [projectKey]: true },
+			'project page, publishing ready': { [local]: true, [projectKey]: true, [RITEMARK_PUBLISH_READY_KEY]: true },
+			'page outside the project, publishing ready': { [local]: true, [projectKey]: false, [RITEMARK_PUBLISH_READY_KEY]: true },
+			'website, publishing ready': { [local]: false, [projectKey]: false, [RITEMARK_PUBLISH_READY_KEY]: true },
+			'a tab with no keys yet': {},
+		};
+		const bar: Record<string, string[]> = {};
+		for (const [name, values] of Object.entries(states)) {
+			bar[name] = [
+				...(shown(RITEMARK_OPEN_PAGE_IN_BROWSER_WHEN, values) ? ['Open in your browser'] : []),
+				...(shown(RITEMARK_PUBLISH_PAGE_WHEN, values) ? ['Publish'] : []),
+				// upstream's Open in External Browser, in ⋯, stays for everything but a local page
+				...(shown(RITEMARK_UPSTREAM_OPEN_EXTERNAL_WHEN, values) ? ['⋯ Open in External Browser'] : []),
+			];
+		}
+		assert.deepStrictEqual(bar, {
+			'project page, publishing not ready (PR 2 alone)': ['Open in your browser'],
+			'project page, publishing ready': ['Open in your browser', 'Publish'],
+			'page outside the project, publishing ready': ['Open in your browser'],
+			'website, publishing ready': ['⋯ Open in External Browser'],
+			'a tab with no keys yet': ['⋯ Open in External Browser'],
+		});
+	});
+});
diff --git a/src/vs/workbench/contrib/browserView/test/common/ritemarkBrowserPageTarget.test.ts b/src/vs/workbench/contrib/browserView/test/common/ritemarkBrowserPageTarget.test.ts
