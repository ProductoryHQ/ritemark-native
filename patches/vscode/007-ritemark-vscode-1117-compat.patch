+	private revealCopilotChatViewState(): void {
+		try {
+			const workspaceStateRaw = this.storageService.get(ChatViewContainerId, StorageScope.WORKSPACE);
+			if (workspaceStateRaw) {
+				const workspaceState = JSON.parse(workspaceStateRaw) as Record<string, { collapsed?: boolean; isHidden?: boolean; size?: number; order?: number }>;
+				if (workspaceState[ChatViewId]?.isHidden === true) {
+					workspaceState[ChatViewId] = { ...workspaceState[ChatViewId], isHidden: false };
+					this.storageService.store(ChatViewContainerId, JSON.stringify(workspaceState), StorageScope.WORKSPACE, StorageTarget.MACHINE);
+				}
+			}
+
+			const globalStateKey = `${ChatViewContainerId}.hidden`;
+			const globalStateRaw = this.storageService.get(globalStateKey, StorageScope.PROFILE);
+			if (globalStateRaw) {
+				const globalState = JSON.parse(globalStateRaw) as Array<{ id: string; isHidden?: boolean; order?: number }>;
+				let changed = false;
+				const nextGlobalState = globalState.map(item => {
+					if (item.id === ChatViewId && item.isHidden === true) {
+						changed = true;
+						return { ...item, isHidden: false };
+					}
+					return item;
+				});
+				if (changed) {
+					this.storageService.store(globalStateKey, JSON.stringify(nextGlobalState), StorageScope.PROFILE, StorageTarget.USER);
+				}
+			}
+
+			const pinnedViewletsKey = 'workbench.activity.pinnedViewlets2';
+			const pinnedViewletsRaw = this.storageService.get(pinnedViewletsKey, StorageScope.PROFILE);
+			if (pinnedViewletsRaw) {
+				const pinnedViewlets = JSON.parse(pinnedViewletsRaw) as Array<{ id: string; pinned?: boolean; visible?: boolean; order?: number }>;
+				if (Array.isArray(pinnedViewlets)) {
+					let changed = false;
+					const oldChatViewlet = pinnedViewlets.find(item => item.id === ChatViewContainerId);
+					if (oldChatViewlet?.pinned !== false || oldChatViewlet?.visible !== false) {
+						if (oldChatViewlet) {
+							oldChatViewlet.pinned = false;
+							oldChatViewlet.visible = false;
+							changed = true;
+						}
+					}
+
+					const launcherViewlet = pinnedViewlets.find(item => item.id === RITEMARK_COPILOT_CHAT_ACTIVITY_BAR_LAUNCHER_ID);
+					if (launcherViewlet) {
+						if (launcherViewlet.pinned !== true || launcherViewlet.visible !== true || launcherViewlet.order !== 0.5) {
+							launcherViewlet.pinned = true;
+							launcherViewlet.visible = true;
+							launcherViewlet.order = 0.5;
+							changed = true;
+						}
+					} else {
+						pinnedViewlets.push({ id: RITEMARK_COPILOT_CHAT_ACTIVITY_BAR_LAUNCHER_ID, pinned: true, visible: true, order: 0.5 });
+						changed = true;
+					}
+
+					if (changed) {
+						this.storageService.store(pinnedViewletsKey, JSON.stringify(pinnedViewlets), StorageScope.PROFILE, StorageTarget.USER);
+					}
+				}
+			}
+		} catch (error) {
+			this.logService.warn('[chat setup] Failed to reveal Copilot Chat view state', error);
+		}
+	}
+
+	private hideCopilotChatViewState(): void {
