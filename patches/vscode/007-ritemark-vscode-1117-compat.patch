+	private revealCopilotChatViewState(): void {
+		try {
+			const chatViewContainer = this.viewDescriptorService.getViewContainerById(ChatViewContainerId);
+			if (chatViewContainer && this.viewDescriptorService.getViewContainerLocation(chatViewContainer) !== ViewContainerLocation.Sidebar) {
+				this.viewDescriptorService.moveViewContainerToLocation(chatViewContainer, ViewContainerLocation.Sidebar, undefined, 'ritemark-copilot-chat');
+			}
+
+			const workspaceStateRaw = this.storageService.get(ChatViewContainerId, StorageScope.WORKSPACE);
+			if (workspaceStateRaw) {
+				const workspaceState = JSON.parse(workspaceStateRaw) as Record<string, { collapsed?: boolean; isHidden?: boolean; size?: number; order?: number }>;
+				if (workspaceState[ChatViewId]?.isHidden === true) {
+					workspaceState[ChatViewId] = { ...workspaceState[ChatViewId], isHidden: false };
+					this.storageService.store(ChatViewContainerId, JSON.stringify(workspaceState), StorageScope.WORKSPACE, StorageTarget.MACHINE);
+				}
+			}
+
+			const globalStateKey = `${ChatViewContainerId}.hidden`;
+			const globalStateRaw = this.storageService.get(globalStateKey, StorageScope.PROFILE);
+			if (globalStateRaw) {
+				const globalState = JSON.parse(globalStateRaw) as Array<{ id: string; isHidden?: boolean; order?: number }>;
+				let changed = false;
+				const nextGlobalState = globalState.map(item => {
+					if (item.id === ChatViewId && item.isHidden === true) {
+						changed = true;
+						return { ...item, isHidden: false };
+					}
+					return item;
+				});
+				if (changed) {
+					this.storageService.store(globalStateKey, JSON.stringify(nextGlobalState), StorageScope.PROFILE, StorageTarget.USER);
+				}
+			}
+
+			const pinnedViewletsKey = 'workbench.activity.pinnedViewlets2';
+			const pinnedViewletsRaw = this.storageService.get(pinnedViewletsKey, StorageScope.PROFILE);
+			if (pinnedViewletsRaw) {
+				const pinnedViewlets = JSON.parse(pinnedViewletsRaw) as Array<{ id: string; pinned?: boolean; visible?: boolean; order?: number }>;
+				if (Array.isArray(pinnedViewlets)) {
+					const chatViewlet = pinnedViewlets.find(item => item.id === ChatViewContainerId);
+					if (chatViewlet) {
+						if (chatViewlet.pinned !== true) {
+							chatViewlet.pinned = true;
+							this.storageService.store(pinnedViewletsKey, JSON.stringify(pinnedViewlets), StorageScope.PROFILE, StorageTarget.USER);
+						}
+					} else {
+						const sourceControlViewlet = pinnedViewlets.find(item => item.id === 'workbench.view.scm');
+						pinnedViewlets.push({ id: ChatViewContainerId, pinned: true, visible: false, order: (sourceControlViewlet?.order ?? 2) + 1 });
+						this.storageService.store(pinnedViewletsKey, JSON.stringify(pinnedViewlets), StorageScope.PROFILE, StorageTarget.USER);
+					}
+				}
+			}
+
+			const pinnedPanelsKey = 'workbench.auxiliarybar.pinnedPanels';
+			const pinnedPanelsRaw = this.storageService.get(pinnedPanelsKey, StorageScope.PROFILE);
+			if (pinnedPanelsRaw) {
+				const pinnedPanels = JSON.parse(pinnedPanelsRaw) as Array<{ id: string; pinned?: boolean; visible?: boolean; order?: number }>;
+				if (Array.isArray(pinnedPanels)) {
+					const chatPanel = pinnedPanels.find(item => item.id === ChatViewContainerId);
+					if (chatPanel) {
+						if (chatPanel.pinned !== true || chatPanel.visible !== true) {
+							chatPanel.pinned = true;
+							chatPanel.visible = true;
+							this.storageService.store(pinnedPanelsKey, JSON.stringify(pinnedPanels), StorageScope.PROFILE, StorageTarget.USER);
+						}
+					} else {
+						const ritemarkPanel = pinnedPanels.find(item => item.id === 'workbench.view.extension.ritemark-ai');
+						pinnedPanels.push({ id: ChatViewContainerId, pinned: true, visible: true, order: (ritemarkPanel?.order ?? 0) + 1 });
+						this.storageService.store(pinnedPanelsKey, JSON.stringify(pinnedPanels), StorageScope.PROFILE, StorageTarget.USER);
+					}
+				}
+			}
+		} catch (error) {
+			this.logService.warn('[chat setup] Failed to reveal Copilot Chat view state', error);
+		}
+	}
+
+	private async checkExtensionInstallation(context: ChatEntitlementContext): Promise<void> {
+
+		if (!defaultChat.chatExtensionId) {
+			return;
+		}
+
+		if (this.environmentService.isExtensionDevelopment) {
+			await this.extensionService.whenInstalledExtensionsRegistered();
+			if (this.extensionService.extensions.find(ext => ExtensionIdentifier.equals(ext.identifier, defaultChat.chatExtensionId))) {
+				await context.update({ installed: true, disabled: false, untrusted: false, disabledInWorkspace: false });
+				this.revealCopilotChatViewState();
+				return;
+			}
+		}
+
+		await this.extensionsWorkbenchService.queryLocal();
+
+		this._register(Event.runAndSubscribe<IExtension | undefined>(this.extensionsWorkbenchService.onChange, e => {
+			if (e && !ExtensionIdentifier.equals(e.identifier.id, defaultChat.chatExtensionId)) {
+				return;
+			}
+
+			const defaultChatExtension = this.extensionsWorkbenchService.local.find(value => ExtensionIdentifier.equals(value.identifier.id, defaultChat.chatExtensionId));
+			const installed = !!defaultChatExtension?.local;
+
+			let disabled: boolean;
+			let untrusted = false;
+			let disabledInWorkspace = false;
+			if (installed) {
+				disabled = !this.extensionEnablementService.isEnabled(defaultChatExtension.local);
+				if (disabled) {
+					const state = this.extensionEnablementService.getEnablementState(defaultChatExtension.local);
+					if (state === EnablementState.DisabledByTrustRequirement) {
+						disabled = false;
+						untrusted = true;
+					} else if (state === EnablementState.DisabledWorkspace) {
+						disabledInWorkspace = true;
+					}
+				}
+			} else {
+				disabled = false;
+			}
+
+			context.update({ installed, disabled, untrusted, disabledInWorkspace });
+			if (installed && !disabled && !disabledInWorkspace) {
+				this.revealCopilotChatViewState();
+			}
+		}));
+	}
