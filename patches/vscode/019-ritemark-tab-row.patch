@@ -0,0 +1,254 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: tabs that do not fit fold away, and say so (R7).
+ *
+ * Every tab shows its whole name. When the row is full, the tabs used longest ago fold (never Home,
+ * Tasks or the open document) rather than shorten the others' names, and "N ⌄" at the right end of
+ * the row, before the +, lists them in Ritemark's menu. The tabs control decides which fold
+ * (`ritemarkFoldTabs` in multiEditorTabsControl.ts); this file draws the button and its menu.
+ */
+
+import { $, addDisposableListener, append, clearNode, EventType, getWindow } from '../../../../base/browser/dom.js';
+import { StandardKeyboardEvent } from '../../../../base/browser/keyboardEvent.js';
+import { getDefaultHoverDelegate } from '../../../../base/browser/ui/hover/hoverDelegateFactory.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { KeyCode } from '../../../../base/common/keyCodes.js';
+import { Disposable, DisposableStore, IDisposable, toDisposable } from '../../../../base/common/lifecycle.js';
+import { dirname, extname, isEqual } from '../../../../base/common/resources.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { IContextViewService } from '../../../../platform/contextview/browser/contextView.js';
+import { IHoverService } from '../../../../platform/hover/browser/hover.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { IActivityService, NumberBadge } from '../../../services/activity/common/activity.js';
+import { EditorResourceAccessor, SideBySideEditor, Verbosity } from '../../../common/editor.js';
+import { EditorInput } from '../../../common/editor/editorInput.js';
+import { IEditorGroupView } from './editor.js';
+import { ritemarkMenuButton, ritemarkShowMenuUnder } from './ritemarkNewTab.js';
+
+/** The Tasks place's view container: its badge is what waits on you, set by the extension (Sprint 134, R6). */
+export const RITEMARK_TASKS_CONTAINER = 'workbench.view.extension.ritemark-tasks';
+
+/** The extension's Task board tab. */
+export function ritemarkIsTaskBoard(editor: EditorInput): boolean {
+	const viewType = (editor as { viewType?: unknown }).viewType;
+	return typeof viewType === 'string' && viewType.endsWith('ritemark.taskBoard');
+}
+
+/** The Tasks place's count: the same number on the place and on the tab, so the two never differ. */
+export function ritemarkTasksCount(activityService: IActivityService): number {
+	for (const activity of activityService.getViewContainerActivities(RITEMARK_TASKS_CONTAINER)) {
+		if (activity.badge instanceof NumberBadge) {
+			return activity.badge.number;
+		}
+	}
+	return 0;
+}
+
+/** "Task board, 1 waits for you": the tab's tooltip and accessible name with the count in words. */
+export function ritemarkTabCountWords(base: string, count: number): string {
+	return count === 1
+		? localize('ritemark.tabCount.one', "{0}, 1 waits for you", base)
+		: localize('ritemark.tabCount.many', "{0}, {1} wait for you", base, count);
+}
+
+/** The count at the tab icon's lower right, as the places row draws it; up to "99+", nothing when nothing waits. */
+export function ritemarkShowTabCount(tab: HTMLElement, count: number): void {
+	let badge = tab.querySelector<HTMLElement>(':scope > .ritemark-tab-count');
+	if (count <= 0) {
+		badge?.remove();
+		return;
+	}
+	if (!badge) {
+		badge = append(tab, $('span.ritemark-tab-count', { 'aria-hidden': 'true' }));
+	}
+	badge.textContent = count > 99 ? '99+' : String(count);
+}
+
+function iconOf(editor: EditorInput): ThemeIcon {
+	const resource = EditorResourceAccessor.getOriginalUri(editor, { supportSideBySide: SideBySideEditor.PRIMARY });
+	if (!resource) {
+		return editor.typeId.includes('terminal') ? Codicon.terminal : editor.typeId.includes('webview') ? Codicon.globe : Codicon.file;
+	}
+	switch (extname(resource).toLowerCase()) {
+		case '.md': case '.markdown': case '.txt': return Codicon.fileText;
+		case '.csv': case '.xlsx': return Codicon.table;
+		default: return Codicon.file;
+	}
+}
+
+export class RitemarkFoldedTabs extends Disposable {
+
+	private readonly button: HTMLElement;
+	private readonly count: HTMLElement;
+	private readonly hover;
+	private folded: readonly EditorInput[] = [];
+	private open = false;
+	private hiddenAt = 0;
+	private renderMenu: (() => void) | undefined;
+
+	constructor(
+		container: HTMLElement,
+		private readonly group: IEditorGroupView,
+		@IContextViewService private readonly contextViewService: IContextViewService,
+		@IWorkspaceContextService private readonly workspaceService: IWorkspaceContextService,
+		@IHoverService hoverService: IHoverService,
+	) {
+		super();
+
+		this.button = append(container, $('a.ritemark-more-tabs', { role: 'button', tabIndex: 0, 'aria-haspopup': 'menu', 'aria-expanded': 'false' }));
+		this.count = append(this.button, $('span.ritemark-more-tabs-count'));
+		append(this.button, renderIcon(Codicon.chevronDown));
+		this.button.style.display = 'none';
+		this.hover = this._register(hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), this.button, ''));
+		this._register(toDisposable(() => this.button.remove()));
+		this._register(ritemarkMenuButton(this.button, () => this.show(), () => this.open, () => this.hiddenAt, () => this.contextViewService.hideContextView()));
+	}
+
+	/** Its width with its gap, 0 while it is hidden. */
+	get outerWidth(): number {
+		return this.button.style.display === 'none' ? 0 : this.button.offsetWidth + 8;
+	}
+
+	/** Show the count (a number while measuring, the folded tabs once known); hide at none. */
+	update(folded: readonly EditorInput[] | number): void {
+		const count = typeof folded === 'number' ? folded : folded.length;
+		if (typeof folded !== 'number') {
+			this.folded = folded;
+		}
+		this.button.style.display = count > 0 ? '' : 'none';
+		this.count.textContent = String(count);
+		const label = count === 1 ? localize('ritemark.moreTabs.one', "1 more tab") : localize('ritemark.moreTabs', "{0} more tabs", count);
+		this.button.setAttribute('aria-label', label);
+		this.hover.update(label);
+		if (typeof folded !== 'number') {
+			if (this.open && count === 0) {
+				this.contextViewService.hideContextView();
+			} else {
+				this.renderMenu?.();
+			}
+		}
+	}
+
+	private show(): void {
+		if (this.open) {
+			this.contextViewService.hideContextView();
+			return;
+		}
+		if (!this.folded.length) {
+			return;
+		}
+		this.open = true;
+		this.button.classList.add('open');
+		this.button.setAttribute('aria-expanded', 'true');
+		ritemarkShowMenuUnder(this.contextViewService, this.button, container => this.renderInto(container), () => {
+			this.open = false;
+			this.hiddenAt = Date.now();
+			this.renderMenu = undefined;
+			this.button.classList.remove('open');
+			this.button.setAttribute('aria-expanded', 'false');
+		});
+	}
+
+	private renderInto(container: HTMLElement): IDisposable {
+		const disposables = new DisposableStore();
+		const menu = append(container, $('.ritemark-new-tab-menu.ritemark-more-tabs-menu', { role: 'menu' }));
+		const close = () => this.contextViewService.hideContextView();
+		let items: HTMLElement[] = [];
+
+		const render = (focusIndex = 0) => {
+			disposables.clear();
+			clearNode(menu);
+			const editors = this.folded;
+			const head = editors.length === 1 ? localize('ritemark.moreTabs.headOne', "1 more tab") : localize('ritemark.moreTabs.head', "{0} more tabs", editors.length);
+			menu.setAttribute('aria-label', head);
+			append(menu, $('.ritemark-new-tab-menu-head', { 'aria-hidden': 'true' }, head));
+			const list = append(menu, $('.ritemark-more-tabs-list'));
+			items = [];
+			for (const editor of editors) {
+				const item = append(list, $('a.ritemark-more-tabs-item', { role: 'menuitem', tabIndex: -1, 'aria-label': editor.getTitle(Verbosity.MEDIUM) ?? editor.getName() }));
+				append(item, renderIcon(iconOf(editor)));
+				append(item, $('span.ritemark-more-tabs-name', undefined, editor.getName()));
+				const where = this.folderOf(editor);
+				if (where) {
+					append(item, $('span.ritemark-more-tabs-where', undefined, where));
+				}
+				const x = append(item, $('a.ritemark-more-tabs-close', { role: 'button', 'aria-label': localize('ritemark.moreTabs.closeNamed', "Close {0}", editor.getName()) }));
+				append(x, renderIcon(Codicon.close));
+				disposables.add(addDisposableListener(x, EventType.CLICK, e => {
+					e.stopPropagation();
+					this.closeOne(editor);
+				}));
+				disposables.add(addDisposableListener(item, EventType.CLICK, () => {
+					close();
+					this.group.openEditor(editor);
+				}));
+				disposables.add(addDisposableListener(item, EventType.MOUSE_ENTER, () => item.focus()));
+				items.push(item);
+			}
+			append(menu, $('.ritemark-more-tabs-separator'));
+			const all = append(menu, $('a.ritemark-new-tab-menu-item.ritemark-more-tabs-close-all', { role: 'menuitem', tabIndex: -1 }, editors.length === 1 ? localize('ritemark.moreTabs.closeThisOne', "Close this tab") : localize('ritemark.moreTabs.closeThese', "Close these {0} tabs", editors.length)));
+			disposables.add(addDisposableListener(all, EventType.CLICK, () => {
+				close();
+				this.group.closeEditors([...this.folded]);
+			}));
+			disposables.add(addDisposableListener(all, EventType.MOUSE_ENTER, () => all.focus()));
+			items.push(all);
+			getWindow(menu).setTimeout(() => items[Math.min(focusIndex, items.length - 1)]?.focus(), 0);
+		};
