+			disposables.dispose();
+		});
+	}
+
+	/** The folder a tab's file is in, or nothing at the project's top level (its name would say only the project's). */
+	private folderOf(editor: EditorInput): string | undefined {
+		const resource = EditorResourceAccessor.getOriginalUri(editor, { supportSideBySide: SideBySideEditor.PRIMARY });
+		const root = resource ? this.workspaceService.getWorkspaceFolder(resource) : null;
