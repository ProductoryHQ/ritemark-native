+import { RITEMARK_TASKS_CONTAINER, ritemarkIsTaskBoard, ritemarkShowTabCount, ritemarkTabCountWords, ritemarkTasksCount } from '../../../../browser/parts/editor/ritemarkFoldedTabs.js';
+import { IActivity, IActivityService, IconBadge, NumberBadge } from '../../../../services/activity/common/activity.js';
+import { Codicon } from '../../../../../base/common/codicons.js';
+import { EditorInput } from '../../../../common/editor/editorInput.js';
+
+/** Only what the count reads: the Tasks place's activities. */
+function activityService(activities: Record<string, IActivity[]>): IActivityService {
+	return {
+		_serviceBrand: undefined,
+		onDidChangeActivity: Event.None,
+		getViewContainerActivities: (id: string) => activities[id] ?? [],
+		showViewContainerActivity: () => Disposable.None,
+		showViewActivity: () => Disposable.None,
+		showAccountsActivity: () => Disposable.None,
+		showGlobalActivity: () => Disposable.None,
+		getActivity: () => [],
+	} as IActivityService;
+}
+
+/**
+ * Ritemark 2.0 (Sprint 134, R6): the Task board tab carries the Tasks place's count, drawn as the places row
+ * draws it, up to "99+", and says it in words in its tooltip and accessible name.
+ */
+suite('Ritemark Tasks tab count', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('the count is the Tasks place\'s number badge, nothing else', () => {
+		assert.strictEqual(ritemarkTasksCount(activityService({})), 0);
+		assert.strictEqual(ritemarkTasksCount(activityService({ [RITEMARK_TASKS_CONTAINER]: [{ badge: new NumberBadge(3, () => '3') }] })), 3);
+		assert.strictEqual(ritemarkTasksCount(activityService({ [RITEMARK_TASKS_CONTAINER]: [{ badge: new IconBadge(Codicon.sync, () => 'Syncing') }] })), 0);
+		assert.strictEqual(ritemarkTasksCount(activityService({ 'workbench.view.extension.other': [{ badge: new NumberBadge(5, () => '5') }] })), 0);
+	});
+
+	test('the badge shows the count up to 99+, and goes when nothing waits', () => {
+		const tab = $('div.tab');
+		ritemarkShowTabCount(tab, 0);
+		assert.strictEqual(tab.querySelector('.ritemark-tab-count'), null);
+		ritemarkShowTabCount(tab, 2);
+		assert.strictEqual(tab.querySelector('.ritemark-tab-count')?.textContent, '2');
+		assert.strictEqual(tab.querySelector('.ritemark-tab-count')?.getAttribute('aria-hidden'), 'true');
+		ritemarkShowTabCount(tab, 140);
+		assert.strictEqual(tab.querySelectorAll('.ritemark-tab-count').length, 1);
+		assert.strictEqual(tab.querySelector('.ritemark-tab-count')?.textContent, '99+');
+		ritemarkShowTabCount(tab, 0);
+		assert.strictEqual(tab.querySelector('.ritemark-tab-count'), null);
+	});
