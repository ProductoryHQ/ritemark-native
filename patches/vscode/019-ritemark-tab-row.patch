+import { StandardKeyboardEvent } from '../../../../base/browser/keyboardEvent.js';
+import { AnchorAlignment } from '../../../../base/browser/ui/contextview/contextview.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { KeyCode } from '../../../../base/common/keyCodes.js';
+import { DisposableStore, IDisposable, toDisposable } from '../../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextViewService } from '../../../../platform/contextview/browser/contextView.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IHoverService } from '../../../../platform/hover/browser/hover.js';
+import { getDefaultHoverDelegate } from '../../../../base/browser/ui/hover/hoverDelegateFactory.js';
+import { ritemarkCloseOnLeave } from '../ritemarkMenu.js';
+
+interface INewTabKind {
+	readonly label: string;
+	readonly detail: string;
+	readonly icon: ThemeIcon;
+	readonly command: string;
+}
+
+const KINDS: readonly INewTabKind[] = [
+	{ label: localize('ritemark.newTab.text', "Text"), detail: localize('ritemark.newTab.textDetail', "A new document in this project"), icon: Codicon.fileText, command: 'ritemark.newDocument' },
+	{ label: localize('ritemark.newTab.table', "Table"), detail: localize('ritemark.newTab.tableDetail', "CSV data, rows and columns"), icon: Codicon.table, command: 'ritemark.newTable' },
+	{ label: localize('ritemark.newTab.web', "Web page"), detail: localize('ritemark.newTab.webDetail', "Open a site, or a recent page"), icon: Codicon.globe, command: 'ritemark.browser.newTab' },
+	{ label: localize('ritemark.newTab.terminal', "Terminal"), detail: localize('ritemark.newTab.terminalDetail', "A command line in this project's folder"), icon: Codicon.terminal, command: 'workbench.action.createTerminalEditor' },
+];
+
+/** Ritemark 2.0: the +'s kinds, which an empty desk offers as tiles (ritemarkEmptyDesk.ts, Sprint 133). */
+export const RITEMARK_NEW_TAB_KINDS = KINDS;
+
+/**
+ * Show a Ritemark menu under a button at the right end of the tab row: it opens leftward, over the
+ * desk. Anchored to the button itself, so the context view corrects for the window's zoom.
+ */
+export function ritemarkShowMenuUnder(contextViewService: IContextViewService, button: HTMLElement, render: (container: HTMLElement) => IDisposable, onHide: () => void): void {
+	const leave = ritemarkCloseOnLeave(button, () => contextViewService.hideContextView());
+	contextViewService.showContextView({
+		getAnchor: () => button,
+		anchorAlignment: AnchorAlignment.RIGHT,
+		render,
+		onHide: () => {
+			leave.dispose();
+			onHide();
+		}
+	});
+}
+
+/**
+ * A button that toggles its menu. A press on the button while its menu is open closes the menu (the
+ * menu hides itself on any press outside it, just before this one); it must not open it again on the
+ * click that follows.
+ */
+export function ritemarkMenuButton(button: HTMLElement, show: () => void, isOpen: () => boolean, hiddenAt: () => number, hide: () => void): IDisposable {
+	const disposables = new DisposableStore();
+	let pressedWhileOpen = false;
+	disposables.add(addDisposableListener(button, EventType.MOUSE_DOWN, e => {
+		e.preventDefault();
+		e.stopPropagation(); // the editor group would focus its editor (a webview), and the window's blur would close the menu
+		pressedWhileOpen = isOpen() || Date.now() - hiddenAt() < 50;
+	}));
+	disposables.add(addDisposableListener(button, EventType.CLICK, () => {
+		if (pressedWhileOpen) {
+			pressedWhileOpen = false;
+			if (isOpen()) {
+				hide();
+			}
+			return;
+		}
+		show();
+	}));
+	disposables.add(addDisposableListener(button, EventType.KEY_DOWN, e => {
+		const event = new StandardKeyboardEvent(e);
+		if (event.equals(KeyCode.Enter) || event.equals(KeyCode.Space) || event.equals(KeyCode.DownArrow)) {
+			event.preventDefault();
+			show();
+		}
+	}));
+	return disposables;
+}
+
+/** The + at the right end of the tab row. `beforeRun` makes its group the active one. */
+export function createRitemarkNewTabButton(accessor: ServicesAccessor, container: HTMLElement, beforeRun: () => void): IDisposable {
+	const commandService = accessor.get(ICommandService);
+	const contextViewService = accessor.get(IContextViewService);
+	const hoverService = accessor.get(IHoverService);
+	const disposables = new DisposableStore();
+
+	const label = localize('ritemark.newTab', "New tab");
+	const button = append(container, $('a.ritemark-new-tab', { role: 'button', tabIndex: 0, 'aria-haspopup': 'menu', 'aria-expanded': 'false', 'aria-label': label }));
+	append(button, renderIcon(Codicon.add));
+	disposables.add(hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), button, label));
+	disposables.add(toDisposable(() => button.remove()));
+
+	let open = false;
+	let hiddenAt = 0;
+	const hide = () => contextViewService.hideContextView();
+	const show = () => {
+		if (open) {
+			hide();
+			return;
+		}
+		open = true;
+		button.classList.add('open');
+		button.setAttribute('aria-expanded', 'true');
+		ritemarkShowMenuUnder(contextViewService, button, menuContainer => renderMenu(menuContainer, kind => {
+			hide();
+			beforeRun();
+			commandService.executeCommand(kind.command);
+		}, () => {
+			hide();
+			button.focus();
+		}), () => {
+			open = false;
+			hiddenAt = Date.now();
+			button.classList.remove('open');
+			button.setAttribute('aria-expanded', 'false');
+		});
+	};
+	disposables.add(ritemarkMenuButton(button, show, () => open, () => hiddenAt, hide));
+
+	return disposables;
+}
+
+function renderMenu(container: HTMLElement, run: (kind: INewTabKind) => void, close: () => void): IDisposable {
+	const disposables = new DisposableStore();
+	const menu = append(container, $('.ritemark-new-tab-menu', { role: 'menu', 'aria-label': localize('ritemark.newTab.menu', "New tab") }));
+	append(menu, $('.ritemark-new-tab-menu-head', { 'aria-hidden': 'true' }, localize('ritemark.newTab.head', "New tab")));
+
+	const items: HTMLElement[] = [];
+	for (const kind of KINDS) {
+		const item = append(menu, $('a.ritemark-new-tab-menu-item', { role: 'menuitem', tabIndex: -1, 'aria-label': kind.label }));
+		append(append(item, $('span.ritemark-new-tab-menu-icon')), renderIcon(kind.icon));
+		const text = append(item, $('span.ritemark-new-tab-menu-text'));
+		append(text, $('span.ritemark-new-tab-menu-label', undefined, kind.label));
+		append(text, $('span.ritemark-new-tab-menu-detail', undefined, kind.detail));
+		disposables.add(addDisposableListener(item, EventType.CLICK, () => run(kind)));
+		disposables.add(addDisposableListener(item, EventType.MOUSE_ENTER, () => item.focus()));
+		items.push(item);
+	}
+
+	disposables.add(addDisposableListener(menu, EventType.KEY_DOWN, e => {
+		const event = new StandardKeyboardEvent(e);
+		const index = items.indexOf(getWindow(menu).document.activeElement as HTMLElement);
+		if (event.equals(KeyCode.DownArrow) || event.equals(KeyCode.UpArrow)) {
+			const step = event.equals(KeyCode.DownArrow) ? 1 : -1;
+			items[(index + step + items.length) % items.length].focus();
+		} else if ((event.equals(KeyCode.Enter) || event.equals(KeyCode.Space)) && index >= 0) {
+			run(KINDS[index]);
+		} else if (event.equals(KeyCode.Escape) || event.equals(KeyCode.Tab)) {
+			close();
+		} else {
+			return;
+		}
+		event.preventDefault();
+		event.stopPropagation();
+	}));
+
+	getWindow(menu).setTimeout(() => items[0].focus(), 0);
+	return disposables;
+}
+
+/**
+ * Sprint 134 (R8): New tab, from the File menu and ⌘T (Ctrl+T), opens the front desk's + menu, as a click on its +
+ * does. The extension names it in the File menu and binds the keys.
+ */
+CommandsRegistry.registerCommand('ritemark.newTab', () => {
+	const document = getActiveWindow().document;
+	const plus = document.querySelector<HTMLElement>('.part.editor .editor-group-container.active .ritemark-new-tab')
+		?? document.querySelector<HTMLElement>('.part.editor .ritemark-new-tab');
+	plus?.click();
+});
