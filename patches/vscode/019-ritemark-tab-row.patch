+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0 (Sprint 133, R6, S49): an empty desk offers what the + offers first, as three tiles: Text, Table and
+ * Web page (experience 2, decision 6: one pattern for starting something, wherever you are). Each tile runs the +'s own
+ * command in this desk. Drawn by ritemarkSurfaces.css (`.ritemark-empty-desk`).
+ */
+
+import { $, addDisposableListener, append, EventHelper, EventType } from '../../../../base/browser/dom.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { onUnexpectedError } from '../../../../base/common/errors.js';
+import { DisposableStore, IDisposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { RITEMARK_NEW_TAB_KINDS } from './ritemarkNewTab.js';
+
+/** The tiles' short lines (the kit's `.tile`); the +'s menu says more. */
+const TILE_LINES: Record<string, string> = {
+	'ritemark.newDocument': localize('ritemark.emptyDesk.text', "A new document"),
+	'ritemark.newTable': localize('ritemark.emptyDesk.table', "CSV data"),
+	'ritemark.browser.newTab': localize('ritemark.emptyDesk.web', "Open a site"),
+};
+
+/** Ritemark 2.0: the three tiles of an empty desk, in the editor group's watermark. */
+export function renderRitemarkEmptyDesk(container: HTMLElement, commandService: ICommandService, activateGroup: (() => void) | undefined): IDisposable {
+	const disposables = new DisposableStore();
+	const desk = append(container, $('.ritemark-empty-desk', { role: 'group', 'aria-label': localize('ritemark.emptyDesk', "Start something new") }));
+	disposables.add({ dispose: () => desk.remove() });
+
+	for (const kind of RITEMARK_NEW_TAB_KINDS.filter(candidate => TILE_LINES[candidate.command] !== undefined)) {
+		const tile = append(desk, $('button.ritemark-empty-desk-tile', { type: 'button' }));
+		append(tile, $('span.ritemark-empty-desk-icon', undefined, renderIcon(kind.icon)));
+		const text = append(tile, $('span.ritemark-empty-desk-text'));
+		append(text, $('b', undefined, kind.label));
+		append(text, $('span', undefined, TILE_LINES[kind.command]));
+
+		// The group opens an untitled file on a double click on its empty space: not on a tile
+		disposables.add(addDisposableListener(tile, EventType.DBLCLICK, e => EventHelper.stop(e, true)));
+		disposables.add(addDisposableListener(tile, EventType.CLICK, e => {
+			EventHelper.stop(e, true);
+			activateGroup?.();
+			commandService.executeCommand(kind.command).catch(onUnexpectedError);
+		}));
+	}
+
+	return disposables;
+}
