+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark (Sprint 146, R8, #568; the Experience lead's answers for the sprint, section 6): a tab's menu holds the usual
+ * tab items, not VS Code's developer ones. One filter where the tab row builds the menu (editorTabsControl.ts), so it
+ * catches an item whatever registered it: the workbench, the chat contribution or a built-in extension. It names what
+ * goes, so an item no one has named still shows. The commands stay registered, and All commands still runs them
+ * (decision 4). A terminal tab's menu has none of them: its own extras went at their source in Sprint 132.
+ */
+
+import { IAction, Separator, toAction } from '../../../../base/common/actions.js';
+import { localize } from '../../../../nls.js';
+import { REOPEN_WITH_COMMAND_ID } from './editorCommands.js';
+
+/** What a tab's menu leaves out, by command ID, with the reason the Experience lead gave. */
+export const RITEMARK_TAB_MENU_LEAVES_OUT: ReadonlyMap<string, string> = new Map([
+	['workbench.action.chat.attachFile', 'Add File to Chat adds the file to Copilot Chat, not to Ritemark\'s AI; the composer\'s + is Ritemark\'s way'],
+	['github.copilot.chat.copilotCLI.addFileReference', 'Add File to Copilot CLI hands the file to Copilot too, not to Ritemark\'s AI (the built-in Copilot, while a Copilot CLI session runs)'],
+	['markdown.showPreview', 'Open Preview: Ritemark\'s editor already shows the document as it reads'],
+	[REOPEN_WITH_COMMAND_ID, 'Reopen Editor With… lists editors by their developer names; View: Reopen Editor With… stays in All commands'],
+	['markdown.findAllFileReferences', 'Find File References is a code tool'],
+	['typescript.findAllFileReferences', 'Find File References is a code tool (the same item on a script file\'s tab)'],
+]);
+
+/** Reveal in Explorer View (contrib/files' REVEAL_IN_EXPLORER_COMMAND_ID) reads as the left column names the tree. */
+const REVEAL_IN_DOCUMENTS = 'revealInExplorer';
+
+/**
+ * A tab's menu as Ritemark shows it: the left-out items gone, Reveal in Explorer View named Show in Documents, and no
+ * separator left at either end or twice in a row where a group emptied.
+ */
+export function ritemarkTabMenuActions(actions: readonly IAction[]): IAction[] {
+	const kept: IAction[] = [];
+	for (const action of actions) {
+		if (RITEMARK_TAB_MENU_LEAVES_OUT.has(action.id)) {
+			continue;
+		}
+		if (action.id === Separator.ID) {
+			if (kept.length && kept[kept.length - 1].id !== Separator.ID) {
+				kept.push(action);
+			}
+			continue;
+		}
+		kept.push(action.id === REVEAL_IN_DOCUMENTS ? toAction({
+			id: action.id,
+			label: localize('ritemark.tabMenu.showInDocuments', "Show in Documents"),
+			enabled: action.enabled,
+			class: action.class,
+			run: (...args: unknown[]) => action.run(...args)
+		}) : action);
+	}
+	while (kept.length && kept[kept.length - 1].id === Separator.ID) {
+		kept.pop();
+	}
+	return kept;
+}
