+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { timeout } from '../../../../../base/common/async.js';
+import { Emitter } from '../../../../../base/common/event.js';
+import { DisposableStore } from '../../../../../base/common/lifecycle.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { upcastPartial } from '../../../../../base/test/common/mock.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { runWithFakedTimers } from '../../../../../base/test/common/virtualScheduling/runWithFakedTimers.js';
+import { IShellLaunchConfig } from '../../../../../platform/terminal/common/terminal.js';
+import { EditorInput } from '../../../../common/editor/editorInput.js';
+import { IEditorService } from '../../../../services/editor/common/editorService.js';
+import { ITerminalGroupService, ITerminalInstance, ITerminalInstanceService, ITerminalService } from '../../browser/terminal.js';
+import { RITEMARK_RESTORED_TERMINALS_WAIT_MS, ritemarkNextTerminalName, RitemarkRestoredTerminalNames, RitemarkTerminalTabs } from '../../browser/ritemarkTerminalTabs.js';
+import { ILogService, NullLogService } from '../../../../../platform/log/common/log.js';
+
+interface IOpened { resource: string; inactive: boolean; preserveFocus: boolean }
+
+/**
+ * Ritemark 2.0 (Sprint 132, R8): a terminal is a tab. Terminals that land in the panel move onto the desk, behind
+ * the open document at start and in front later; hidden ones stay where they are. Plain new terminals are named
+ * "Terminal", "Terminal 2", ...; a terminal with a name of its own keeps it. Sprint 145 (#501): terminals that come
+ * back onto an empty desk wait for its first document, or a minute, and then open behind it. Sprint 152: the minute is
+ * the desk's front slot's release, logged; a restored terminal's tab has its saved name from the first frame.
+ */
+suite('Ritemark terminal tabs', () => {
+
+	const disposables = new DisposableStore();
+	teardown(() => disposables.clear());
+
+	function terminal(id: number, config: Partial<IShellLaunchConfig> = {}): ITerminalInstance {
+		const instance = upcastPartial<ITerminalInstance>({
+			instanceId: id,
+			resource: URI.from({ scheme: 'vscode-terminal', path: `/${id}` }),
+			title: config.name ?? 'zsh',
+			shellLaunchConfig: { ...config },
+			rename: async (name?: string) => { (instance as { title: string }).title = name ?? ''; },
+		});
+		return instance;
+	}
+
+	/** An editor in front on the desk: a document, or a terminal tab. */
+	function editor(resource: URI): EditorInput {
+		return upcastPartial<EditorInput>({ resource });
+	}
+
+	function setUp(panel: ITerminalInstance[], { deskEmpty = false, logService = new NullLogService() as ILogService } = {}) {
+		const onDidCreateInstance = disposables.add(new Emitter<ITerminalInstance>());
+		const onDidActiveEditorChange = disposables.add(new Emitter<void>());
+		let active: EditorInput | undefined = deskEmpty ? undefined : editor(URI.file('/project/Plan.md'));
+		const onDidChangeInstances = disposables.add(new Emitter<void>());
+		let connect!: () => void;
+		const whenConnected = new Promise<void>(resolve => connect = resolve);
+		const all: ITerminalInstance[] = [...panel];
+		const opened: IOpened[] = [];
+		const terminalService = upcastPartial<ITerminalService>({
+			get instances() { return all; },
+			onDidCreateInstance: onDidCreateInstance.event,
+			onDidDisposeInstance: disposables.add(new Emitter<ITerminalInstance>()).event,
+			whenConnected,
+			createOnInstanceCapabilityEvent: (() => disposables.add(new Emitter<unknown>())) as unknown as ITerminalService['createOnInstanceCapabilityEvent'],
+		});
+		const terminalGroupService = upcastPartial<ITerminalGroupService>({
+			get instances() { return panel; },
+			onDidChangeInstances: onDidChangeInstances.event,
+		});
+		const editorService = upcastPartial<IEditorService>({
+			get activeEditor() { return active; },
+			onDidActiveEditorChange: onDidActiveEditorChange.event,
+			openEditor: (async (input: { resource: URI; options: { inactive: boolean; preserveFocus: boolean } }) => {
+				opened.push({ resource: input.resource.path, inactive: input.options.inactive, preserveFocus: input.options.preserveFocus });
+				return undefined;
+			}) as unknown as IEditorService['openEditor'],
+		});
+		disposables.add(new RitemarkTerminalTabs(terminalService, terminalGroupService, editorService, logService));
+		const create = (instance: ITerminalInstance) => {
+			all.push(instance);
+			onDidCreateInstance.fire(instance);
+		};
+		const show = (next: EditorInput) => {
+			active = next;
+			onDidActiveEditorChange.fire();
+		};
+		return { connect, opened, panel, create, show, changed: () => onDidChangeInstances.fire() };
+	}
+
+	test('panel terminals move onto the desk: behind the document at start, in front later; hidden ones stay', async () => {
+		const { connect, opened, panel, changed } = setUp([terminal(1), terminal(2, { hideFromUser: true })]);
+
+		connect();
+		await timeout(0);
+		const atStart = opened.splice(0);
+		panel.splice(0, panel.length, terminal(3));
+		changed();
+		await timeout(10);
+
+		assert.deepStrictEqual({ atStart, later: opened }, {
+			atStart: [{ resource: '/1', inactive: true, preserveFocus: true }],
+			later: [{ resource: '/3', inactive: false, preserveFocus: true }],
+		});
+	});
+
+	test('#501: onto an empty desk, restored terminals wait for its first document, past a terminal tab and the sweep, then open behind it', async () => {
+		const restored = terminal(1);
+		const { connect, opened, panel, show, changed } = setUp([restored], { deskEmpty: true });
+
+		connect();
+		await timeout(0);
+		const atStart = opened.splice(0);
+		panel.push(terminal(2)); // one an extension asks for meanwhile comes to the front, as asked
+		changed();
+		await timeout(10);
+		const meanwhile = opened.splice(0);
+		show(editor(URI.from({ scheme: 'vscode-terminal', path: '/2' }))); // a terminal tab is not a document
+		await timeout(0);
+		const afterTerminalTab = opened.splice(0);
+		panel.splice(0, panel.length, restored);
+		show(editor(URI.file('/project/Welcome')));
+		await timeout(0);
+
+		assert.deepStrictEqual({ atStart, meanwhile, afterTerminalTab, afterDocument: opened }, {
+			atStart: [],
+			meanwhile: [{ resource: '/2', inactive: false, preserveFocus: true }],
+			afterTerminalTab: [],
+			afterDocument: [{ resource: '/1', inactive: true, preserveFocus: true }],
+		});
+	});
+
+	test('#501: with no document within the wait, restored terminals open anyway; one closed meanwhile does not', () => runWithFakedTimers({}, async () => {
+		const kept = terminal(1);
+		const logged: string[] = [];
+		const logService = new class extends NullLogService { override warn(message: string) { logged.push(message); } }();
+		const { connect, opened, panel } = setUp([kept, terminal(2)], { deskEmpty: true, logService });
+
+		connect();
+		await timeout(0);
+		panel.splice(1, 1);
+		await timeout(RITEMARK_RESTORED_TERMINALS_WAIT_MS - 1);
+		const beforeTheMinute = opened.splice(0);
+		await timeout(2);
+
+		assert.deepStrictEqual({ beforeTheMinute, after: opened, logged }, {
+			beforeTheMinute: [],
+			after: [{ resource: '/1', inactive: true, preserveFocus: true }],
+			logged: ['[ritemark] slot released: the desk\'s front (restored terminals) (no document came)'],
+		});
+	}));
+
+	test('plain terminals are named Terminal, Terminal 2; named, task and revived ones keep their names', () => {
+		const { create } = setUp([]);
+		const first = terminal(1);
+		const second = terminal(2);
+		const codex = terminal(3, { name: 'Install Codex' });
+		const task = terminal(4, { type: 'Task' });
+		const revived = terminal(5, { attachPersistentProcess: upcastPartial<NonNullable<IShellLaunchConfig['attachPersistentProcess']>>({ id: 7 }) });
+
+		[first, second, codex, task, revived].forEach(create);
+
+		assert.deepStrictEqual([first, second, codex, task, revived].map(instance => instance.title), ['Terminal', 'Terminal 2', 'Install Codex', 'zsh', 'zsh']);
+	});
+
+	test('Sprint 152: a restored terminal has its saved name as it is made, before its tab draws; a new one is left to the namer', () => {
+		const onDidCreateInstance = disposables.add(new Emitter<ITerminalInstance>());
+		disposables.add(new RitemarkRestoredTerminalNames(upcastPartial<ITerminalInstanceService>({ onDidCreateInstance: onDidCreateInstance.event })));
+		const nameless = (id: number, config: Partial<IShellLaunchConfig>) => {
+			const instance = terminal(id, config);
+			(instance as { title: string }).title = '';
+			return instance;
+		};
+		const restored = nameless(1, { attachPersistentProcess: upcastPartial<NonNullable<IShellLaunchConfig['attachPersistentProcess']>>({ id: 7, title: 'Terminal 2' }) });
+		const fresh = nameless(2, {});
+
+		[restored, fresh].forEach(instance => onDidCreateInstance.fire(instance));
+
+		assert.deepStrictEqual([restored, fresh].map(instance => instance.title), ['Terminal 2', '']);
+	});
+
+	test('the next name is the lowest free one', () => {
+		assert.deepStrictEqual([
+			ritemarkNextTerminalName([]),
+			ritemarkNextTerminalName(['Terminal']),
+			ritemarkNextTerminalName(['Terminal', 'Terminal 3']),
+			ritemarkNextTerminalName(['zsh', 'Terminal 2']),
+		], ['Terminal', 'Terminal 2', 'Terminal 2', 'Terminal']);
+	});
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+});
