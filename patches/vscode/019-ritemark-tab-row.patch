@@ -0,0 +1,141 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { timeout } from '../../../../../base/common/async.js';
+import { DisposableStore } from '../../../../../base/common/lifecycle.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { SyncDescriptor } from '../../../../../platform/instantiation/common/descriptors.js';
+import { Registry } from '../../../../../platform/registry/common/platform.js';
+import { EditorExtensions, EditorsOrder, IEditorFactoryRegistry } from '../../../../common/editor.js';
+import { createEditorParts, ITestInstantiationService, registerTestEditor, TestEditorPart, TestFileEditorInput, workbenchInstantiationService, workbenchTeardown } from '../../../../test/browser/workbenchTestServices.js';
+import { GroupDirection, IEditorGroupsService } from '../../common/editorGroupsService.js';
+
+/** A tab the group takes for the extension's Task board: a webview of that view type. */
+class TestTaskBoardInput extends TestFileEditorInput {
+	readonly viewType = 'mainThreadWebview-ritemark.taskBoard';
+}
+
+/**
+ * Ritemark 2.0 (Sprint 132, R9): a pinned Home or Task board tab keeps the front of the row. A person or a
+ * command cannot close, unpin or move it to another group, no tab moves in front of it, and Close all and
+ * Close others leave it. Only the extension removes it, by disposing it.
+ */
+suite('Ritemark permanent tabs', () => {
+
+	const TEST_EDITOR_ID = 'MyFileEditorForRitemarkPermanentTabs';
+	const TEST_EDITOR_INPUT_ID = 'testEditorInputForRitemarkPermanentTabs';
+
+	const disposables = new DisposableStore();
+	let instantiationService: ITestInstantiationService | undefined;
+
+	setup(() => {
+		disposables.add(registerTestEditor(TEST_EDITOR_ID, [new SyncDescriptor(TestFileEditorInput)], TEST_EDITOR_INPUT_ID));
+	});
+
+	teardown(async () => {
+		if (instantiationService) {
+			await workbenchTeardown(instantiationService);
+			instantiationService = undefined;
+		}
+		disposables.clear();
+	});
+
+	async function createPart(): Promise<TestEditorPart> {
+		instantiationService = workbenchInstantiationService(undefined, disposables);
+		instantiationService.invokeFunction(accessor => Registry.as<IEditorFactoryRegistry>(EditorExtensions.EditorFactory).start(accessor));
+		const parts = await createEditorParts(instantiationService, disposables);
+		instantiationService.stub(IEditorGroupsService, parts);
+		return parts.testMainPart;
+	}
+
+	function board(): TestTaskBoardInput {
+		return disposables.add(new TestTaskBoardInput(URI.file('/project/.ritemark/tasks'), TEST_EDITOR_INPUT_ID));
+	}
+
+	function document(name: string): TestFileEditorInput {
+		return disposables.add(new TestFileEditorInput(URI.file(`/project/${name}.md`), TEST_EDITOR_INPUT_ID));
+	}
+
+	/** The row, by file: TestFileEditorInput names every tab alike. */
+	function row(group: TestEditorPart['activeGroup']): string[] {
+		return group.getEditors(EditorsOrder.SEQUENTIAL).map(editor => editor.resource?.path ?? '');
+	}
+
+	async function openRow(part: TestEditorPart) {
+		const group = part.activeGroup;
+		const tasks = board();
+		const brief = document('Brief');
+		const proposal = document('Proposal');
+		await group.openEditor(tasks, { pinned: true, sticky: true });
+		await group.openEditor(brief, { pinned: true });
+		await group.openEditor(proposal, { pinned: true });
+		return { group, tasks, brief, proposal };
+	}
+
+	test('a pinned Task board tab cannot be closed, unpinned or moved to another group', async () => {
+		const part = await createPart();
+		const { group, tasks } = await openRow(part);
+
+		assert.strictEqual(await group.closeEditor(tasks), false);
+		group.unstickEditor(tasks);
+		const right = part.addGroup(group, GroupDirection.RIGHT);
+		const moved = group.moveEditor(tasks, right);
+
+		assert.deepStrictEqual({ moved, open: group.contains(tasks), index: group.getIndexOfEditor(tasks), sticky: group.isSticky(tasks), inRight: right.contains(tasks), disposed: tasks.gotDisposed }, { moved: false, open: true, index: 0, sticky: true, inRight: false, disposed: false });
+	});
+
+	test('no other tab moves or opens in front of it, from this desk or another', async () => {
+		const part = await createPart();
+		const { group, tasks, proposal } = await openRow(part);
+
+		group.moveEditor(proposal, group, { index: 0 });
+		await group.openEditor(document('Kickoff'), { pinned: true, index: 0 });
+		const right = part.addGroup(group, GroupDirection.RIGHT);
+		const notes = document('Notes');
+		await right.openEditor(notes, { pinned: true });
+		right.moveEditor(notes, group, { index: 0 });
+
+		assert.deepStrictEqual({ row: row(group), sticky: group.stickyCount }, { row: [tasks.resource.path, '/project/Notes.md', '/project/Kickoff.md', '/project/Proposal.md', '/project/Brief.md'], sticky: 1 });
+	});
+
+	test('Close all and Close others leave it', async () => {
+		const part = await createPart();
+		const { group, tasks, brief, proposal } = await openRow(part);
+
+		await group.closeEditors({ except: brief });
+		const afterOthers = row(group);
+		await group.closeEditors([tasks, brief]);
+		const afterList = row(group);
+		await group.openEditor(document('Proposal again'), { pinned: true });
+		await group.closeAllEditors();
+		const afterAll = row(group);
+
+		assert.deepStrictEqual({ afterOthers, afterList, afterAll, proposalClosed: !group.contains(proposal) }, { afterOthers: [tasks.resource.path, '/project/Brief.md'], afterList: [tasks.resource.path], afterAll: [tasks.resource.path], proposalClosed: true });
+	});
+
+	test('the extension removes it by disposing it', async () => {
+		const part = await createPart();
+		const { group, tasks } = await openRow(part);
+
+		tasks.dispose();
+		await timeout(10); // the group closes disposed editors in a worker, a tick later
+
+		assert.strictEqual(group.contains(tasks), false);
+	});
+
+	test('a Task board tab that is not pinned is an ordinary tab', async () => {
+		const part = await createPart();
+		const group = part.activeGroup;
+		const tasks = board();
+		await group.openEditor(tasks, { pinned: true });
+
+		assert.strictEqual(await group.closeEditor(tasks), true);
+		assert.strictEqual(group.contains(tasks), false);
+	});
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+});
