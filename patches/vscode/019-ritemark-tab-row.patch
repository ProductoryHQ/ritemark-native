+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { IAction, Separator, toAction } from '../../../../../base/common/actions.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { REOPEN_WITH_COMMAND_ID } from '../../../../browser/parts/editor/editorCommands.js';
+import { RITEMARK_TAB_MENU_LEAVES_OUT, ritemarkTabMenuActions } from '../../../../browser/parts/editor/ritemarkTabMenu.js';
+
+/** A menu as getFlatContextMenuActions gives it: [id, label] rows, '---' for a separator. */
+function menu(rows: ReadonlyArray<string | [string, string]>, ran: unknown[][] = []): IAction[] {
+	return rows.map(row => row === '---' ? new Separator() : toAction({ id: row[0], label: row[1], run: (...args: unknown[]) => { ran.push([row[0], ...args]); } }));
+}
+
+function shown(actions: readonly IAction[]): string[] {
+	return actions.map(action => action.id === Separator.ID ? '---' : action.label);
+}
+
+/** The usual tab items, as every kind of tab has them at the top and the foot of its menu. */
+const CLOSE: Array<string | [string, string]> = [['workbench.action.closeActiveEditor', 'Close'], ['workbench.action.closeOtherEditors', 'Close Others'], ['workbench.action.closeEditorsToTheRight', 'Close to the Right'], ['workbench.files.action.closeSavedEditors', 'Close Saved'], ['workbench.action.closeEditorsInGroup', 'Close All']];
+const FOOT: Array<string | [string, string]> = [['workbench.action.splitEditor', 'Split Right'], ['workbench.action.splitMoveSubmenu', 'Split & Move'], '---', ['workbench.action.moveEditorToNewWindow', 'Move into New Window'], ['workbench.action.copyEditorToNewWindow', 'Copy into New Window']];
+
+/**
+ * Ritemark (Sprint 146, R8, #568): a tab's menu leaves out Add File to Chat, Open Preview, Reopen Editor With… and Find File
+ * References, and names Reveal in Explorer View Show in Documents (the Experience lead's answers, section 6). The menus
+ * here are the ones a dev build drew on main before the change (the sprint's research/tab-menu-audit.md).
+ */
+suite('Ritemark tab menu', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
