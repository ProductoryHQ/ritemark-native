+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: a terminal is one kind of tab (R8; Jarmo, 17 October: "Terminal must be one type of tab").
+ *
+ * - A terminal that appears in the panel (an extension asked for it, or an older profile's saved terminals
+ *   came back there) moves onto the desk as a tab, behind the open document. It never stays in the panel,
+ *   and never reaches the AI column.
+ * - A new terminal with no name of its own is named "Terminal", then "Terminal 2" and so on. Ritemark's own
+ *   terminals (Install Codex, Codex Repair, ...) keep their names.
+ * - Whether a terminal runs a command now, from its shell integration (`CommandDetection`): the terminal's
+ *   bar (ritemarkTerminalBar.ts) shows Running and Stop, and its tab carries the working dot
+ *   (terminalEditorInput.ts). Without shell integration there is no running state, and nothing shows.
+ */
+
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { RunOnceScheduler } from '../../../../base/common/async.js';
+import { TerminalCapability } from '../../../../platform/terminal/common/capabilities/capabilities.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { ITerminalGroupService, ITerminalInstance, ITerminalService } from './terminal.js';
+
+const RITEMARK_TERMINAL_NAME = 'Terminal';
+
+const running = new Set<number>();
+const onDidChangeRunning = new Emitter<ITerminalInstance>();
+
+/** Whether a terminal runs a command now, as its shell integration reports it. */
+export const ritemarkTerminalRunning = {
+	isRunning(instance: ITerminalInstance): boolean {
+		return running.has(instance.instanceId);
+	},
+	onDidChange: onDidChangeRunning.event as Event<ITerminalInstance>,
+};
+
+function setRunning(instance: ITerminalInstance, isRunning: boolean): void {
+	if (running.has(instance.instanceId) !== isRunning) {
+		if (isRunning) {
+			running.add(instance.instanceId);
+		} else {
+			running.delete(instance.instanceId);
+		}
+		onDidChangeRunning.fire(instance);
+	}
+}
+
+/** The lowest free name among the open terminals: "Terminal", then "Terminal 2", "Terminal 3", ... */
+export function ritemarkNextTerminalName(openTitles: readonly string[]): string {
+	const taken = new Set(openTitles);
+	if (!taken.has(RITEMARK_TERMINAL_NAME)) {
+		return RITEMARK_TERMINAL_NAME;
+	}
+	for (let number = 2; ; number++) {
+		const name = `${RITEMARK_TERMINAL_NAME} ${number}`;
+		if (!taken.has(name)) {
+			return name;
+		}
+	}
+}
+
+/** Whether a new terminal should get a "Terminal N" name: a person's plain terminal, not a revived, hidden, task or named one. */
+export function ritemarkShouldNameTerminal(instance: ITerminalInstance): boolean {
+	const config = instance.shellLaunchConfig;
+	return !config.name
+		&& !config.attachPersistentProcess
+		&& !config.hideFromUser
+		&& !config.isFeatureTerminal
+		&& config.type !== 'Task'
+		&& !config.customPtyImplementation
+		&& !config.titleTemplate;
+}
+
+export class RitemarkTerminalTabs extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkTerminalTabs';
+
+	private restored = false;
+	private readonly sweep = this._register(new RunOnceScheduler(() => this.moveToDesk(false), 0));
+
+	constructor(
+		@ITerminalService terminalService: ITerminalService,
+		@ITerminalGroupService private readonly terminalGroupService: ITerminalGroupService,
+		@IEditorService private readonly editorService: IEditorService,
+	) {
+		super();
+
+		// Names: set before the process starts, so the name is the terminal's own from the start and survives a restart
+		this._register(terminalService.onDidCreateInstance(instance => {
+			if (ritemarkShouldNameTerminal(instance)) {
+				const name = ritemarkNextTerminalName(terminalService.instances.filter(other => other !== instance).map(other => other.title));
+				instance.shellLaunchConfig.name = name;
+				instance.rename(name);
+			}
+		}));
+
+		// Running: from the moment a command is executed until it finishes
+		this._register(terminalService.createOnInstanceCapabilityEvent(TerminalCapability.CommandDetection, capability => capability.onCommandExecuted).event(({ instance }) => setRunning(instance, true)));
+		this._register(terminalService.createOnInstanceCapabilityEvent(TerminalCapability.CommandDetection, capability => capability.onCommandFinished).event(({ instance }) => setRunning(instance, false)));
+		this._register(terminalService.onDidDisposeInstance(instance => setRunning(instance, false)));
+
+		// The desk: once the saved terminals are back, and whenever a terminal lands in the panel later.
+		// Never inside the event: the panel group is not registered yet when it fires.
+		terminalService.whenConnected.then(() => {
+			this.restored = true;
+			this.moveToDesk(true);
+		});
+		this._register(terminalGroupService.onDidChangeInstances(() => {
+			if (this.restored) {
+				this.sweep.schedule();
+			}
+		}));
+	}
+
+	/**
+	 * Open every terminal in the panel as a tab on the desk, keeping the keyboard where it is. Terminals that
+	 * come back at start stay behind the open document; one made later comes to the front, as asked.
+	 */
+	private moveToDesk(behind: boolean): void {
+		for (const instance of this.terminalGroupService.instances) {
+			if (instance.shellLaunchConfig.hideFromUser) {
+				continue;
+			}
+			this.editorService.openEditor({ resource: instance.resource, options: { pinned: true, inactive: behind, preserveFocus: true } });
+		}
+	}
+}
+
+registerWorkbenchContribution2(RitemarkTerminalTabs.ID, RitemarkTerminalTabs, WorkbenchPhase.AfterRestored);
