+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: the bar at the top of a terminal tab (R8; comparison/after-terminal.png, files.html): the shell's
+ * name, a plain label in step 1 (its menu of other shells comes later; Experience lead and Jarmo, 17 October); a
+ * Running chip while a command runs; Stop; then Split, Clear and Close. Its height never changes, so the terminal is not resized at every command (full-screen
+ * programs redraw on every resize). Without shell integration there is no running state, so neither Running nor
+ * Stop shows.
+ */
+
+import { $, addDisposableListener, append, EventType } from '../../../../base/browser/dom.js';
+import { getDefaultHoverDelegate } from '../../../../base/browser/ui/hover/hoverDelegateFactory.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { Disposable, DisposableStore, MutableDisposable } from '../../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { IHoverService } from '../../../../platform/hover/browser/hover.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { ITerminalInstance, ITerminalService } from './terminal.js';
+import { ritemarkTerminalRunning } from './ritemarkTerminalTabs.js';
+
+/** The bar's fixed height, in the desk's pixels. */
+export const RITEMARK_TERMINAL_BAR_HEIGHT = 52;
+
+/**
+ * Each terminal's shell, as last seen. On Windows the shell type clears while another program runs in the shell
+ * (Windows round 1: the bar read "Terminal 2" while running and "pwsh" when idle), so the bar keeps the last one.
+ */
+const shellNames = new WeakMap<ITerminalInstance, string>();
+
+export class RitemarkTerminalBar extends Disposable {
+
+	private readonly name: HTMLElement;
+	private readonly runningChip: HTMLElement;
+	private readonly stop: HTMLElement;
+	private readonly instanceDisposables = this._register(new MutableDisposable<DisposableStore>());
+	private instance: ITerminalInstance | undefined;
+
+	constructor(
+		container: HTMLElement,
+		@ITerminalService private readonly terminalService: ITerminalService,
+		@IHoverService private readonly hoverService: IHoverService,
+		@IEditorService private readonly editorService: IEditorService,
+	) {
+		super();
+
+		const bar = $('.ritemark-terminal-bar');
+		container.prepend(bar);
+		this._register({ dispose: () => bar.remove() });
+
+		// The shell's name
+		const shell = append(bar, $('span.ritemark-terminal-shell'));
+		append(shell, renderIcon(Codicon.terminal));
+		this.name = append(shell, $('span.ritemark-terminal-name'));
+		this.runningChip = append(bar, $('span.ritemark-terminal-running-chip', { role: 'status' }));
+		append(this.runningChip, $('span.ritemark-terminal-running-dot', { 'aria-hidden': 'true' }));
+		append(this.runningChip, $('span', undefined, localize('ritemark.terminal.running', "Running")));
+		append(bar, $('span.ritemark-terminal-bar-grow'));
+
+		this.stop = this.button(bar, 'ritemark-terminal-stop', Codicon.debugStop, localize('ritemark.terminal.stop', "Stop"), localize('ritemark.terminal.stopTooltip', "Stop the running command (Ctrl+C)"), instance => {
+			instance.sendText('\x03', false); // Ctrl+C, which also reaches the command through ConPTY on Windows
+			instance.focus();
+		});
+		this.button(bar, 'ritemark-terminal-icon', Codicon.splitHorizontal, undefined, localize('ritemark.terminal.split', "Split"), instance => {
+			this.terminalService.createTerminal({ location: { parentTerminal: instance } });
+		});
+		this.button(bar, 'ritemark-terminal-icon', Codicon.clearAll, undefined, localize('ritemark.terminal.clear', "Clear"), instance => instance.clearBuffer());
+		this.button(bar, 'ritemark-terminal-icon', Codicon.trash, undefined, localize('ritemark.terminal.close', "Close this terminal: its shell ends and the tab closes"), instance => this.close(instance));
+
+		this.update();
+		this._register(ritemarkTerminalRunning.onDidChange(changed => {
+			if (changed === this.instance) {
+				this.update();
+			}
+		}));
+	}
+
+	/** The terminal this tab shows, or none. */
+	setInstance(instance: ITerminalInstance | undefined): void {
+		this.instance = instance;
+		const disposables = this.instanceDisposables.value = new DisposableStore();
+		if (instance) {
+			disposables.add(instance.onTitleChanged(() => this.update()));
+			disposables.add(instance.onDidChangeShellType(() => this.update()));
+		}
+		this.update();
+	}
+
+	/** Closes the terminal's tab, so a running command asks first (terminalEditorInput.ts, confirm; experience 31). */
+	private close(instance: ITerminalInstance): void {
+		const [tab] = this.editorService.findEditors(instance.resource);
+		if (tab) {
+			this.editorService.closeEditor(tab);
+		} else {
+			this.terminalService.safeDisposeTerminal(instance);
+		}
+	}
+
+	private update(): void {
+		const instance = this.instance;
+		if (instance?.shellType) {
+			shellNames.set(instance, instance.shellType);
+		}
+		this.name.textContent = instance ? shellNames.get(instance) || instance.processName || instance.title : '';
+		const isRunning = !!instance && ritemarkTerminalRunning.isRunning(instance);
+		this.runningChip.style.display = isRunning ? '' : 'none';
+		this.stop.style.display = isRunning ? '' : 'none';
+	}
+
+	private button(parent: HTMLElement, className: string, icon: ThemeIcon, label: string | undefined, tooltip: string, run: (instance: ITerminalInstance) => void): HTMLElement {
+		const button = append(parent, $(`a.${className}`, { role: 'button', tabIndex: 0, 'aria-label': label ?? tooltip }));
+		append(button, renderIcon(icon));
+		if (label) {
+			append(button, $('span', undefined, label));
+		}
+		this._register(this.hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), button, tooltip));
+		const press = () => {
+			if (this.instance) {
+				run(this.instance);
+			}
+		};
+		this._register(addDisposableListener(button, EventType.CLICK, press));
+		this._register(addDisposableListener(button, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			if (e.key === 'Enter' || e.key === ' ') {
+				e.preventDefault();
+				press();
+			}
+		}));
+		return button;
+	}
+}
