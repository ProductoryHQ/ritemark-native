+/*
+ * Ritemark 2.1 (Sprint 140): the feedback sheet, to experience 34's numbers (feedback.html: .dim, .fsheet and its parts):
+ * 440 wide, padding 20, radius 12, over the window dimmed in ink (ritemarkSurfaces.css dims .monaco-dialog-modal-block).
+ * Colours come from the theme, through the surfaces' tokens, so Ritemark Light and Ritemark Dark both follow.
+ */
+
+.monaco-workbench .ritemark-feedback-block {
+	position: fixed;
+	inset: 0;
+	z-index: 2575; /* as VS Code's dialogs: above context views, below the workbench hover */
+	display: flex;
+	justify-content: center;
+	align-items: center;
+}
+
+.monaco-workbench .ritemark-feedback-sheet {
