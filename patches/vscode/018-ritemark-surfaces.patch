 export function shouldShowCustomTitleBar(configurationService: IConfigurationService, window: Window, menuBarToggled?: boolean): boolean {
+	if (RITEMARK_FRAME_WITHOUT_TITLE_ROW && !isAuxiliaryWindow(window)) {
+		return false; // Ritemark 2.0: the columns carry the title row's strips
+	}
+
 	if (!hasCustomTitlebar(configurationService)) {
 		return false;
 	}
diff --git a/src/vs/workbench/test/browser/parts/ritemarkFeedbackSheet.test.ts b/src/vs/workbench/test/browser/parts/ritemarkFeedbackSheet.test.ts
