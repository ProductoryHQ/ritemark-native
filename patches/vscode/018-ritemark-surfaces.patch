+import { ensureNoDisposablesAreLeakedInTestSuite } from '../common/utils.js';
+
+/** Ritemark 2.0 (Sprint 133, R13): a file's extension drawn apart from its name, for the stylesheet to mute. */
+suite('Ritemark IconLabel splitExtension', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function nameHtml(label: IconLabel): string {
+		return label.element.querySelector('.label-name')!.innerHTML;
+	}
+
+	test('the split itself: the last dot, never a leading dot, never a trailing one', () => {
+		assert.deepStrictEqual(
+			['Brief.md', 'report.final.md', 'README', '.gitignore', 'file.', 'a.b'].map(ritemarkSplitExtension),
+			[
+				{ stem: 'Brief', extension: '.md' },
+				{ stem: 'report.final', extension: '.md' },
+				undefined,
+				undefined,
+				undefined,
+				{ stem: 'a', extension: '.b' },
+			]
+		);
+	});
+
+	test('a tab (no highlights): the extension in its own span inside the name, the text unchanged', () => {
+		const label = store.add(new IconLabel(document.createElement('div')));
+		label.setLabel('report.final.md', undefined, { splitExtension: true });
+		assert.strictEqual(nameHtml(label), 'report.final<span class="label-extension">.md</span>');
+		assert.strictEqual(label.element.querySelector('.label-name')!.textContent, 'report.final.md');
+
+		label.setLabel('README', undefined, { splitExtension: true });
+		assert.strictEqual(nameHtml(label), 'README');
+
+		label.setLabel('Brief.md', undefined, {});
+		assert.strictEqual(nameHtml(label), 'Brief.md', 'only callers that ask get the split');
+	});
+
+	test('a tree row (highlights): a filter match across the dot is split with the name', () => {
+		const label = store.add(new IconLabel(document.createElement('div'), { supportHighlights: true }));
+		label.setLabel('Brief.md', undefined, { splitExtension: true, matches: [{ start: 3, end: 7 }] });
+		assert.strictEqual(
+			nameHtml(label),
+			'<span class="monaco-highlighted-label">Bri<span class="highlight">ef</span></span>'
+			+ '<span class="label-extension"><span class="monaco-highlighted-label"><span class="highlight">.m</span>d</span></span>'
+		);
+		assert.strictEqual(label.element.querySelector('.label-name')!.textContent, 'Brief.md');
+	});
+
+	test('a reused row that becomes a folder drops the extension', () => {
+		const label = store.add(new IconLabel(document.createElement('div'), { supportHighlights: true }));
+		label.setLabel('Kickoff notes.md', undefined, { splitExtension: true });
+		assert.ok(label.element.querySelector('.label-extension'));
+		label.setLabel('Modules', undefined, {});
+		assert.strictEqual(label.element.querySelector('.label-extension'), null);
+		assert.strictEqual(label.element.querySelector('.label-name')!.textContent, 'Modules');
+	});
+});
