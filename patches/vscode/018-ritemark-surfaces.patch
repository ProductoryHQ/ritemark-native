+}
+
+.monaco-workbench.vs-dark .ritemark-feedback-sheet .ritemark-feedback-button.primary {
+	box-shadow: 0 0 0 2px var(--rm-desk), 0 0 0 4px color-mix(in srgb, var(--vscode-focusBorder) 40%, transparent);
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-button.primary:hover {
+	background: var(--vscode-button-hoverBackground);
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-button:disabled {
+	opacity: 0.5;
+	cursor: default;
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-button:focus-visible {
+	outline: 2px solid var(--vscode-focusBorder);
+	outline-offset: 2px;
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-button .codicon {
+	font-size: 14px;
+}
