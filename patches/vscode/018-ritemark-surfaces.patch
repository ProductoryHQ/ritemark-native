@@ -0,0 +1,106 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: a column's 44 strip at the top of the window, where a title row used to be (R1, R2).
+ *
+ * The strip is a drag region; its controls are not. Over the left column it holds the left column's
+ * toggle, after the traffic lights (the Mac) or the menu button (Windows); over the AI it holds the AI's
+ * toggle and You. When a side column is hidden, the desk's strip shows that column's controls instead.
+ * Every number in the strip is in screen pixels: the strip keeps its height and centre line when the
+ * window zooms (ritemarkSurfaces.css counter-zooms it with --ritemark-zoom-factor).
+ */
+
+import { getZoomFactor, onDidChangeZoomLevel } from '../../../base/browser/browser.js';
+import { $, addDisposableListener, append, EventType, getWindow, getWindowId } from '../../../base/browser/dom.js';
+import { getDefaultHoverDelegate } from '../../../base/browser/ui/hover/hoverDelegateFactory.js';
+import { renderIcon } from '../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../base/common/codicons.js';
+import { DisposableStore, IDisposable } from '../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../base/common/themables.js';
+import { localize } from '../../../nls.js';
+import { ICommandService } from '../../../platform/commands/common/commands.js';
+import { IContextViewService } from '../../../platform/contextview/browser/contextView.js';
+import { IHoverService } from '../../../platform/hover/browser/hover.js';
+import { ServicesAccessor } from '../../../platform/instantiation/common/instantiation.js';
+import { IKeybindingService } from '../../../platform/keybinding/common/keybinding.js';
+import { RITEMARK_FRAME_MENU, registerRitemarkFrameMenuSlot } from './ritemarkFrameMenu.js';
+import { showRitemarkMenu } from './ritemarkMenu.js';
+
+const TOGGLE_LEFT_COLUMN = 'workbench.action.toggleSidebarVisibility';
+const TOGGLE_AI = 'workbench.action.toggleAuxiliaryBar';
+const OPEN_SETTINGS = 'ritemark.aiSettings'; // Ritemark's own settings page
+
+/**
+ * Keep `--ritemark-zoom-factor` on a part, so its strip (and the desk's tab row) can undo the window's
+ * zoom. Each window has its own zoom, so the part's own window is the one followed.
+ */
+export function trackRitemarkZoom(element: HTMLElement): IDisposable {
+	const update = () => element.style.setProperty('--ritemark-zoom-factor', String(getZoomFactor(getWindow(element))));
+	update();
+	return onDidChangeZoomLevel(windowId => {
+		if (windowId === getWindowId(getWindow(element))) {
+			update();
+		}
+	});
+}
+
+/**
+ * Create a strip at the top of `part`. `placement` says whose strip it is: the column's own, or the
+ * desk's copy of that column's controls (shown only while the column is hidden).
+ */
+export function createRitemarkFrameStrip(accessor: ServicesAccessor, part: HTMLElement, side: 'left' | 'right', placement: 'column' | 'desk'): DisposableStore {
+	const commandService = accessor.get(ICommandService);
+	const contextViewService = accessor.get(IContextViewService);
+	const hoverService = accessor.get(IHoverService);
+	const keybindingService = accessor.get(IKeybindingService);
+
+	const disposables = new DisposableStore();
+	const strip = append(part, $(`div.ritemark-frame-strip.${side}${placement === 'desk' ? '.on-desk' : ''}`));
+	disposables.add({ dispose: () => strip.remove() });
+
+	// A control on the strip: a button by mouse, Enter and Space, with its tooltip (and its shortcut, in the system's own words)
+	const control = (className: string, label: string, commandId: string | undefined, run: () => void): HTMLElement => {
+		const element = append(strip, $(`a.${className}`, { role: 'button', tabIndex: 0, 'aria-label': label }));
+		disposables.add(hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), element, commandId ? keybindingService.appendKeybinding(label, commandId) : label));
+		disposables.add(addDisposableListener(element, EventType.CLICK, run));
+		disposables.add(addDisposableListener(element, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			if (e.key === 'Enter' || e.key === ' ') {
+				e.preventDefault();
+				run();
+			}
+		}));
+		return element;
+	};
+
+	if (side === 'left') {
+		// Windows: the application menu's button first, where the Mac has its traffic lights (ritemarkFrameMenu.ts)
+		if (RITEMARK_FRAME_MENU) {
+			disposables.add(registerRitemarkFrameMenuSlot(placement, append(strip, $('div.ritemark-frame-menu-slot'))));
+		}
+
+		const toggle = control('ritemark-frame-button', localize('ritemark.frame.toggleLeft', "Show or Hide the Left Column"), TOGGLE_LEFT_COLUMN, () => commandService.executeCommand(TOGGLE_LEFT_COLUMN));
+		toggle.classList.add(...ThemeIcon.asClassNameArray(Codicon.layoutSidebarLeft));
+		return disposables;
+	}
+
+	const aiToggle = control('ritemark-frame-button', localize('ritemark.frame.toggleAI', "Show or Hide the AI"), TOGGLE_AI, () => commandService.executeCommand(TOGGLE_AI));
+	aiToggle.classList.add(...ThemeIcon.asClassNameArray(Codicon.layoutSidebarRight));
+
+	// You (R11): an icon button like the AI's toggle beside it, the person in a circle (Jarmo, 18 October). Its menu holds
+	// only Settings (Ritemark's own page) and Help (Ritemark's support pages) (Jarmo, 17 October; experiences/settings frame 1).
+	const you: HTMLElement = control('ritemark-you', localize('ritemark.frame.you', "You"), undefined, () => {
+		you.setAttribute('aria-expanded', 'true');
+		showRitemarkMenu(contextViewService, you, { className: 'ritemark-you-menu', ariaLabel: localize('ritemark.frame.you', "You"), align: 'right' }, [
+			{ label: localize('ritemark.frame.settings', "Settings"), iconClassNames: ThemeIcon.asClassNameArray(Codicon.settingsGear), sub: keybindingService.lookupKeybinding(OPEN_SETTINGS)?.getLabel() ?? undefined, run: () => commandService.executeCommand(OPEN_SETTINGS) },
+			{ label: localize('ritemark.frame.help', "Help"), iconClassNames: ThemeIcon.asClassNameArray(Codicon.question), trailingIconClassNames: ThemeIcon.asClassNameArray(Codicon.linkExternal), run: () => commandService.executeCommand('workbench.action.openDocumentationUrl') },
+		], () => you.setAttribute('aria-expanded', 'false'));
+	});
+	you.setAttribute('aria-haspopup', 'menu');
+	you.setAttribute('aria-expanded', 'false');
+	append(you, renderIcon(Codicon.account));
+
+	return disposables;
+}
diff --git a/src/vs/workbench/browser/parts/ritemarkMenu.ts b/src/vs/workbench/browser/parts/ritemarkMenu.ts
new file mode 100644
index 00000000000..c515a8eb74f
--- /dev/null
+++ b/src/vs/workbench/browser/parts/ritemarkMenu.ts
@@ -0,0 +1,239 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: a small Ritemark menu, drawn as the Experience lead's kit draws one (kit/ritemark.css: .menu, .hd,
+ * .it, .it.tall, .sub): a white sheet with radius 10 and padding 6, an optional heading in small capitals, rows 32
+ * (44 with a second line), each with its 14 icon, the chosen row in the theme's soft indigo, a hairline between
+ * groups (R12). Used by More (⋯) at the end of the places row (R5, R6), by You (R11) and by the left column's head
+ * (R10).
+ *
+ * Sprint 134 (R8): a row may open a flyout beside the menu (the head's Switch project ▸, experiences/home frame 2),
+ * whose rows the extension supplies when it opens; a row may draw a project's mark in place of its icon, and a tick.
+ */
+
+import { $, addDisposableListener, append, EventType, getWindow } from '../../../base/browser/dom.js';
+import { StandardKeyboardEvent } from '../../../base/browser/keyboardEvent.js';
+import { AnchorAlignment } from '../../../base/browser/ui/contextview/contextview.js';
+import { KeyCode } from '../../../base/common/keyCodes.js';
+import { DisposableStore, IDisposable, toDisposable } from '../../../base/common/lifecycle.js';
+import { IContextViewService } from '../../../platform/contextview/browser/contextView.js';
+
+export interface IRitemarkMenuItem {
+	readonly label: string;
+	/** A second line, under the label: the row is 44 high. */
+	readonly detail?: string;
+	readonly iconClassNames: readonly string[];
+	/** Quiet text at the row's right: a shortcut or a count. */
+	readonly sub?: string;
+	/** A quiet icon at the row's right, such as the external-link mark of a page that opens in the browser. */
+	readonly trailingIconClassNames?: readonly string[];
+	/** A project's mark (its initials) in place of the icon. */
+	readonly mark?: string;
+	/** The chosen one of a list (the open project), ticked at the row's right. */
+	readonly checked?: boolean;
+	/** Drawn in muted ink: a project whose folder is not found (Sprint 134, S38). */
+	readonly muted?: boolean;
+	/** Its rows, asked for when it opens: the row opens a flyout beside the menu instead of running. */
+	readonly submenu?: () => Promise<readonly RitemarkMenuEntry[]>;
+	/** `altKey`: the row was chosen with ⌥ (Alt on Windows) held, as a project opened in a new window. */
+	readonly run: (event?: { readonly altKey: boolean }) => void;
+}
+
+/** A hairline between two groups of rows (kit: .menu .sep). */
+export const RITEMARK_MENU_SEPARATOR = 'separator';
+
+export type RitemarkMenuEntry = IRitemarkMenuItem | typeof RITEMARK_MENU_SEPARATOR;
+
+export interface IRitemarkMenuOptions {
+	readonly className: string;
+	readonly ariaLabel: string;
+	readonly heading?: string;
+	/** Which edge of the anchor the menu lines up with. */
+	readonly align: 'left' | 'right';
+}
+
+/**
+ * Ritemark's menus close on a press outside them (R7, S27): anywhere in the workbench but the menu and its anchor (a
+ * press on the anchor belongs to the anchor, which closes its menu), and inside a webview (a document, the AI), whose
+ * press never reaches the workbench but moves focus into the webview, so the window's blur closes the menu instead.
+ */
+export function ritemarkCloseOnLeave(anchor: HTMLElement, hide: () => void): IDisposable {
+	const targetWindow = getWindow(anchor);
+	const disposables = new DisposableStore();
+	disposables.add(addDisposableListener(targetWindow, EventType.BLUR, () => hide()));
+	disposables.add(addDisposableListener(targetWindow.document, EventType.MOUSE_DOWN, e => {
+		const target = e.target as Element | null;
+		if (target && !anchor.contains(target) && !target.closest('.context-view')) {
+			hide();
+		}
+	}, true)); // capture: a row that stops the press (the tree's) still closes the menu
+	return disposables;
+}
+
+let openAnchor: HTMLElement | undefined;
+
+/**
+ * Show a Ritemark menu under `anchor`, or close it when it is already open there (a second press on its anchor).
+ * `onHide` runs when it closes, by a choice, Escape, the anchor or a press anywhere else.
+ */
+export function showRitemarkMenu(contextViewService: IContextViewService, anchor: HTMLElement, options: IRitemarkMenuOptions, items: readonly RitemarkMenuEntry[], onHide: () => void): void {
+	const close = () => contextViewService.hideContextView();
+	if (openAnchor === anchor) {
+		close();
+		return;
+	}
+	const leave = ritemarkCloseOnLeave(anchor, close);
+	contextViewService.showContextView({
+		getAnchor: () => anchor,
+		anchorAlignment: options.align === 'right' ? AnchorAlignment.RIGHT : AnchorAlignment.LEFT,
+		render: container => renderMenu(container, options, items, close, () => {
+			close();
+			// Escape and Tab hand the keyboard back to the menu's button (More's is its place item, focusable at -1 in the row)
+			(anchor.hasAttribute('tabindex') ? anchor : anchor.querySelector<HTMLElement>('[tabindex]'))?.focus();
+		}),
+		onHide: () => {
+			if (openAnchor === anchor) {
+				openAnchor = undefined;
+			}
+			leave.dispose();
+			onHide();
+		}
+	});
+	openAnchor = anchor;
+}
+
+function renderMenu(container: HTMLElement, options: IRitemarkMenuOptions, items: readonly RitemarkMenuEntry[], close: () => void, leave: () => void, flyout?: { readonly parentRow: HTMLElement; readonly back: () => void }): IDisposable {
+	const disposables = new DisposableStore();
+	const menu = append(container, $(`.ritemark-menu.${flyout ? 'ritemark-menu-flyout' : options.className}`, { role: 'menu', 'aria-label': options.ariaLabel }));
+	if (flyout) {
+		// Beside the menu, its top row level with the row that opened it (kit: the projects menu at 252, 4 right of the menu)
+		const parentMenu = flyout.parentRow.closest<HTMLElement>('.ritemark-menu')!;
+		menu.style.left = `${parentMenu.offsetLeft + parentMenu.offsetWidth + 4}px`;
+		menu.style.top = `${parentMenu.offsetTop + flyout.parentRow.offsetTop - 6}px`;
+	}
+	if (options.heading) {
+		append(menu, $('.ritemark-menu-head', { 'aria-hidden': 'true' }, options.heading));
+	}
+
+	const rows: HTMLElement[] = [];
+	const openFlyout = new DisposableStore();
+	disposables.add(openFlyout);
+	for (const item of items) {
+		if (item === RITEMARK_MENU_SEPARATOR) {
+			append(menu, $('.ritemark-menu-sep', { role: 'separator' }));
+			continue;
+		}
+		// The row is read with what it shows at its right too: "1 waits", "Not found", a key
+		const ariaLabel = [item.label, item.checked ? 'open' : undefined, item.sub, item.muted ? item.detail : undefined].filter(Boolean).join(', ');
+		const row = append(menu, $(`a.ritemark-menu-item${item.detail ? '.tall' : ''}${item.muted ? '.muted' : ''}`, { role: 'menuitem', tabIndex: -1, 'aria-label': ariaLabel }));
+		if (item.mark !== undefined) {
+			append(row, $('span.ritemark-menu-mark', { 'aria-hidden': 'true' }, item.mark));
+		} else {
+			append(row, $('span.ritemark-menu-icon')).classList.add(...item.iconClassNames);
+		}
+		if (item.detail) {
+			const text = append(row, $('span.ritemark-menu-text'));
+			append(text, $('span', undefined, item.label));
+			append(text, $('span.ritemark-menu-detail', undefined, item.detail));
+		} else {
+			append(row, $('span.ritemark-menu-text', undefined, item.label));
+		}
+		if (item.sub) {
+			append(row, $('span.ritemark-menu-sub', undefined, item.sub));
+		}
+		if (item.trailingIconClassNames) {
+			append(row, $('span.ritemark-menu-trailing')).classList.add(...item.trailingIconClassNames);
+		}
+		if (item.checked) {
+			append(row, $('span.ritemark-menu-trailing.codicon.codicon-check'));
+		}
+		const submenu = item.submenu;
+		if (submenu) {
+			row.setAttribute('aria-haspopup', 'menu');
+			append(row, $('span.ritemark-menu-trailing.codicon.codicon-chevron-right'));
+			// The flyout opens on a pointer resting on the row, a click, Enter or the Right arrow; a pointer on another row closes it.
+			const show = async () => {
+				openFlyout.clear();
+				const entries = await submenu();
+				if (!row.isConnected || !entries.length) {
+					return;
+				}
+				row.setAttribute('aria-expanded', 'true');
+				openFlyout.add(renderMenu(container, { ...options, ariaLabel: item.label, heading: undefined }, entries, close, () => {
+					openFlyout.clear();
+					row.focus();
+				}, { parentRow: row, back: () => row.focus() }));
+				openFlyout.add(toDisposable(() => {
+					row.setAttribute('aria-expanded', 'false');
+					container.querySelector('.ritemark-menu-flyout')?.remove();
+				}));
+			};
+			// A pointer coming to rest on the row and a click on it arrive together, while the rows are still being
+			// asked for: they share one opening, so one flyout opens
+			let opening: Promise<void> | undefined;
+			const open = async (focusFirst: boolean) => {
+				if (row.getAttribute('aria-expanded') !== 'true') {
+					opening ??= show().finally(() => opening = undefined);
+					await opening;
+				}
+				if (focusFirst) {
+					container.querySelector<HTMLElement>('.ritemark-menu-flyout [role="menuitem"]')?.focus();
+				}
+			};
+			disposables.add(addDisposableListener(row, EventType.CLICK, () => void open(true)));
+			disposables.add(addDisposableListener(row, EventType.MOUSE_ENTER, () => {
+				row.focus();
+				void open(false);
+			}));
+			disposables.add(addDisposableListener(row, EventType.KEY_DOWN, e => {
+				const event = new StandardKeyboardEvent(e);
+				if (event.equals(KeyCode.RightArrow) || event.equals(KeyCode.Enter) || event.equals(KeyCode.Space)) {
+					event.preventDefault();
+					event.stopPropagation();
+					void open(true);
+				}
+			}));
+			rows.push(row);
+			continue;
+		}
+		const run = (e: MouseEvent | undefined) => {
+			close();
+			item.run({ altKey: !!e?.altKey });
+		};
+		disposables.add(addDisposableListener(row, EventType.CLICK, e => run(e)));
+		disposables.add(addDisposableListener(row, EventType.MOUSE_ENTER, () => {
+			row.focus();
+			if (!flyout) {
+				openFlyout.clear();
+			}
+		}));
+		rows.push(row);
+	}
+
+	disposables.add(addDisposableListener(menu, EventType.KEY_DOWN, e => {
+		const event = new StandardKeyboardEvent(e);
+		const index = rows.indexOf(getWindow(menu).document.activeElement as HTMLElement);
+		if (event.equals(KeyCode.DownArrow) || event.equals(KeyCode.UpArrow)) {
+			const step = event.equals(KeyCode.DownArrow) ? 1 : -1;
+			rows[(index + step + rows.length) % rows.length].focus();
+		} else if ((event.equals(KeyCode.Enter) || event.equals(KeyCode.Space)) && index >= 0) {
+			rows[index].click();
+		} else if (flyout && event.equals(KeyCode.LeftArrow)) {
+			leave();
+		} else if (event.equals(KeyCode.Escape) || event.equals(KeyCode.Tab)) {
+			leave();
+		} else {
+			return;
+		}
+		event.preventDefault();
+		event.stopPropagation();
+	}));
+
+	if (!flyout) {
+		getWindow(menu).setTimeout(() => rows[0]?.focus(), 0);
+	}
+	return toDisposable(() => disposables.dispose());
+}
diff --git a/src/vs/workbench/browser/parts/ritemarkSwitchGuard.ts b/src/vs/workbench/browser/parts/ritemarkSwitchGuard.ts
new file mode 100644
index 00000000000..d11f6cea69c
--- /dev/null
+++ b/src/vs/workbench/browser/parts/ritemarkSwitchGuard.ts
@@ -0,0 +1,214 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0 (Sprint 134, R9): a switch that reloads the window asks first while chats are working. Every way VS Code
+ * opens another folder in this window (File ▸ Open Recent, Open Folder…, a folder dropped on the Dock icon, Close
+ * Folder) unloads it with reason LOAD. This contribution holds that unload for the answer of the extension's hidden
+ * command `_ritemark.projects.beforeReload`, passed the folder about to open when the window knows it (the host
+ * service notes it here: Open Recent). The command answers true to stop the reload. Reload Window and quitting never
+ * ask. The window is never stuck: with no such command, or no answer and no question shown within 10 seconds, the
+ * reload goes on as before.
+ *
+ * Sprint 145 (#569): the window a switch opens lands on Home from its first frame. Once the reload really goes on (no
+ * participant vetoed it), the guard leaves a note for the next window as the storage saves for the last time: the folder
+ * it leaves, the folder it opens when known, the time. The next window's editor part takes it once and brings Home's
+ * tab to the front of its desk, and that desk to the front (editorPart.ts), where the extension brought it forward only
+ * after it had started, with the document the project was left on in front until then. The rule is the extension's own
+ * (`ProjectSwitcher.takeLanding`): within two minutes, in the folder the switch opened, or in any other folder when
+ * the window did not know it.
+ */
+
+import { Disposable, toDisposable } from '../../../base/common/lifecycle.js';
+import { URI } from '../../../base/common/uri.js';
+import { ISerializedGrid, ISerializedNode } from '../../../base/browser/ui/grid/grid.js';
+import { ICommandService } from '../../../platform/commands/common/commands.js';
+import { IDialogService } from '../../../platform/dialogs/common/dialogs.js';
+import { ServicesAccessor } from '../../../platform/instantiation/common/instantiation.js';
+import { IStorageService, StorageScope, StorageTarget, WillSaveStateReason } from '../../../platform/storage/common/storage.js';
+import { IWorkspaceContextService, WorkbenchState } from '../../../platform/workspace/common/workspace.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../common/contributions.js';
+import { isSerializedEditorGroupModel, ISerializedEditorGroupModel } from '../../common/editor/editorGroupModel.js';
+import { ILifecycleService, ShutdownReason } from '../../services/lifecycle/common/lifecycle.js';
+
+const BEFORE_RELOAD_COMMAND = '_ritemark.projects.beforeReload';
+
+/** A noted folder counts only for the unload that follows it at once; the main process may open it in a new window instead. */
+const TARGET_FRESH_MS = 5_000;
+
+let noted: { readonly target: URI; readonly at: number } | undefined;
+
+/** Ritemark 2.0: the host service notes the folder it is about to open in this window. */
+export function noteRitemarkSwitchTarget(target: URI): void {
+	noted = { target, at: Date.now() };
+}
+
+function takeSwitchTarget(): URI | undefined {
+	const taken = noted;
+	noted = undefined;
+	return taken && Date.now() - taken.at <= TARGET_FRESH_MS ? taken.target : undefined;
+}
+
+/**
+ * Ritemark 2.0: the extension's answer to an unload that opens another folder here; true stops it. Anything but a
+ * clear true lets the reload go on: no command, an error, or `ceilingMs` without an answer while no question shows.
+ */
+export function askRitemarkBeforeReload(commandService: ICommandService, dialogService: Pick<IDialogService, 'onWillShowDialog'>, target: URI | undefined, ceilingMs = 10_000): Promise<boolean> {
+	return new Promise<boolean>(resolve => {
+		const timer = setTimeout(() => finish(false), ceilingMs);
+		const asking = dialogService.onWillShowDialog(() => clearTimeout(timer)); // the person reads the question
+		const stop = toDisposable(() => { clearTimeout(timer); asking.dispose(); });
+		function finish(veto: boolean): void {
+			stop.dispose();
+			resolve(veto);
+		}
+		commandService.executeCommand<boolean>(BEFORE_RELOAD_COMMAND, target?.toString()).then(answer => finish(answer === true), () => finish(false));
+	});
+}
+
+/** Sprint 145 (#569): the note a switch leaves for the window it opens. */
+const LANDING_KEY = 'ritemark.switch.landOnHome';
+
+/** As the extension's `SWITCHED_NOTE_MS`: a note older than this is from a switch that did not happen. */
+const LANDING_FRESH_MS = 2 * 60 * 1000;
+
+const HOME_VIEW_TYPE = 'mainThreadWebview-ritemark.home';
+/** `WebviewInput.typeId`, the serializer id a saved webview tab carries. */
+const WEBVIEW_EDITOR_TYPE_ID = 'workbench.editors.webviewInput';
+
+interface IRitemarkSwitchLanding {
+	/** The folder the switch left. */
+	readonly from: string | null;
+	/** The folder it opens, when the window knew it (Open Recent, Ritemark's own ways). */
+	readonly target: string | null;
+	readonly at: number;
+}
+
+function sameFolder(a: string, b: string): boolean {
+	return a.replace(/\/+$/, '') === b.replace(/\/+$/, '');
+}
+
+/** Whether a window on `here` lands on Home after this note (the extension's rule, `ProjectSwitcher.takeLanding`). */
+export function ritemarkLandsOnHome(landing: unknown, here: string | undefined, now: number): boolean {
+	const note = landing as Partial<IRitemarkSwitchLanding> | undefined;
+	if (!here || !note || typeof note.at !== 'number' || now - note.at > LANDING_FRESH_MS || now < note.at) {
+		return false;
+	}
+	if (typeof note.target === 'string') {
+		return sameFolder(note.target, here);
+	}
+	return typeof note.from !== 'string' || !sameFolder(note.from, here);
+}
+
+/** The project's folder as the extension reads it (`workspaceFolders[0]`), in any window that has one. */
+function projectFolder(contextService: IWorkspaceContextService): string | undefined {
+	return contextService.getWorkbenchState() === WorkbenchState.EMPTY ? undefined : contextService.getWorkspace().folders[0]?.uri.toString();
+}
+
+/** Sprint 145 (#569): the window takes the note once, as its editor part restores the tabs. True when it lands on Home. */
+export function ritemarkTakeSwitchLanding(accessor: ServicesAccessor): boolean {
+	const storageService = accessor.get(IStorageService);
+	const raw = storageService.get(LANDING_KEY, StorageScope.APPLICATION);
+	if (raw === undefined) {
+		return false;
+	}
+	storageService.remove(LANDING_KEY, StorageScope.APPLICATION);
+	let landing: unknown;
+	try {
+		landing = JSON.parse(raw);
+	} catch {
+		return false;
+	}
+	return ritemarkLandsOnHome(landing, projectFolder(accessor.get(IWorkspaceContextService)), Date.now());
+}
+
+function isHomeEditor(editor: { id: string; value: string }): boolean {
+	if (editor.id !== WEBVIEW_EDITOR_TYPE_ID) {
+		return false;
+	}
+	try {
+		return (JSON.parse(editor.value) as { viewType?: unknown })?.viewType === HOME_VIEW_TYPE;
+	} catch {
+		return false;
+	}
+}
+
+/**
+ * The saved tabs with Home's tab first in its desk's order of use, so it is the tab in front when they come back, and
+ * that desk's id, to make it the desk in front (undefined when no desk holds Home). Pure.
+ */
+export function ritemarkHomeInFront(grid: ISerializedGrid): { grid: ISerializedGrid; homeGroup: number | undefined } {
+	let homeGroup: number | undefined;
+	const land = (node: ISerializedNode): ISerializedNode => {
+		if (node.type === 'branch') {
+			return { ...node, data: node.data.map(land) };
+		}
+		if (!isSerializedEditorGroupModel(node.data)) {
+			return node;
+		}
+		const group: ISerializedEditorGroupModel = node.data;
+		const home = group.editors.findIndex(isHomeEditor);
+		if (home < 0) {
+			return node;
+		}
+		homeGroup ??= group.id;
+		if (group.mru[0] === home) {
+			return node;
+		}
+		return { ...node, data: { ...group, mru: [home, ...group.mru.filter(index => index !== home)] } };
+	};
+	const landed = { ...grid, root: land(grid.root) };
+	return { grid: landed, homeGroup };
+}
+
+export class RitemarkSwitchGuard extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkSwitchGuard';
+
+	constructor(
+		@ILifecycleService lifecycleService: ILifecycleService,
+		@ICommandService commandService: ICommandService,
+		@IDialogService dialogService: IDialogService,
+		@IStorageService storageService: IStorageService,
+		@IWorkspaceContextService contextService: IWorkspaceContextService,
+	) {
+		super();
+
+		// Sprint 145 (#569): the note for the next window, held until the reload really goes on. Another participant can
+		// still veto after Ritemark's answer (unsaved files, a running terminal), and then nothing is written. Each
+		// shutdown attempt has its own number, so a late answer to one that was already vetoed sets nothing.
+		let landing: Omit<IRitemarkSwitchLanding, 'at'> | undefined;
+		let attempt = 0;
+
+		this._register(lifecycleService.onBeforeShutdown(e => {
+			const thisAttempt = ++attempt;
+			landing = undefined;
+			const target = takeSwitchTarget();
+			if (e.reason === ShutdownReason.LOAD) {
+				e.veto(askRitemarkBeforeReload(commandService, dialogService, target).then(veto => {
+					if (!veto && thisAttempt === attempt) {
+						landing = { from: projectFolder(contextService) ?? null, target: target?.toString() ?? null };
+					}
+					return veto;
+				}), RitemarkSwitchGuard.ID);
+			}
+		}));
+		this._register(lifecycleService.onShutdownVeto(() => {
+			attempt++;
+			landing = undefined;
+		}));
+		// The storage's last save of a shutdown that goes on: the one moment clients can still store (storageService.ts).
+		// Its time is the switch's, not the answer's: other questions (unsaved files) may wait long after Ritemark answered.
+		this._register(storageService.onWillSaveState(e => {
+			if (e.reason === WillSaveStateReason.SHUTDOWN && landing) {
+				const note: IRitemarkSwitchLanding = { ...landing, at: Date.now() };
+				storageService.store(LANDING_KEY, JSON.stringify(note), StorageScope.APPLICATION, StorageTarget.MACHINE);
+				landing = undefined;
+			}
+		}));
+	}
+}
+
+registerWorkbenchContribution2(RitemarkSwitchGuard.ID, RitemarkSwitchGuard, WorkbenchPhase.AfterRestored);
