+
+
+/*
+ * An empty desk offers the + menu's first three as tiles: Text, Table and Web page (R6, S49; ritemarkEmptyDesk.ts;
+ * experience 2, decision 6). They lie on the desk's sheet, centred under the tab row; the letterpress and VS Code's
+ * shortcuts stay hidden. The kit's `.tiles`: three columns 12 apart, radius 10, the strong hairline.
+ */
+
+.monaco-workbench .part.editor > .content .editor-group-container.empty > .editor-group-watermark-wrapper {
+	display: flex !important; /* !important: the rule above hides the whole watermark */
+	position: absolute;
+	inset: 44px 8px 8px 8px; /* under the tab row, on the sheet */
+	max-width: none;
+	width: auto;
+	height: auto;
+	margin: 0;
+	z-index: 1;
+	align-items: center;
+	justify-content: center;
+}
+
+/* Since 1.142 the tiles sit in the watermark's wrapper, beside the letterpress and the group's toolbar: hide those two */
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark,
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark-toolbar-container {
