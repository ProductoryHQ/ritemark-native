@@ -0,0 +1,72 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0 (Sprint 133, R1): the welcome alone. While the extension's welcome is the editor in front and the
+ * extension says so (the context key `ritemark.welcomeAlone`), the window shows only the welcome's sheet on the
+ * ground: `ritemark-welcome-alone` on the workbench hides the desk's strip and sheet and the status bar
+ * (ritemarkSurfaces.css). The strips keep their boxes, so the window still drags by its top; the traffic lights and
+ * Windows' window buttons stay, and Windows' menu button is not mounted. The class goes as soon as anything else is in
+ * front, and nothing is written: the person's own status bar and tab settings are untouched.
+ */
+
+import { Emitter, Event } from '../../../base/common/event.js';
+import { Disposable } from '../../../base/common/lifecycle.js';
+import { IContextKeyService } from '../../../platform/contextkey/common/contextkey.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../common/contributions.js';
+import { IEditorService } from '../../services/editor/common/editorService.js';
+import { IWorkbenchLayoutService } from '../../services/layout/browser/layoutService.js';
+
+/** Set by the extension while its welcome is open alone in the window. */
+const WELCOME_ALONE_CONTEXT_KEY = 'ritemark.welcomeAlone';
+
+/** The welcome's webview editor, as the workbench names an extension's webview panel. */
+const WELCOME_VIEW_TYPE = 'mainThreadWebview-ritemark.welcome';
+
+let welcomeAlone = false;
+const onDidChange = new Emitter<boolean>();
+
+/** Ritemark 2.0: fires when the welcome starts or stops being alone in the window. */
+export const onDidChangeRitemarkWelcomeAlone: Event<boolean> = onDidChange.event;
+
+/** Ritemark 2.0: whether the welcome is alone in the window (the menu button and the window sizes stand down). */
+export function isRitemarkWelcomeAlone(): boolean {
+	return welcomeAlone;
+}
+
+class RitemarkWelcomeAlone extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkWelcomeAlone';
+
+	constructor(
+		@IContextKeyService private readonly contextKeyService: IContextKeyService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+	) {
+		super();
+
+		const keys = new Set([WELCOME_ALONE_CONTEXT_KEY]);
+		this._register(contextKeyService.onDidChangeContext(e => {
+			if (e.affectsSome(keys)) {
+				this.update();
+			}
+		}));
+		this._register(editorService.onDidActiveEditorChange(() => this.update()));
+		this.update();
+	}
+
+	private update(): void {
+		const viewType = (this.editorService.activeEditor as { viewType?: unknown } | undefined)?.viewType;
+		const alone = this.contextKeyService.getContextKeyValue<boolean>(WELCOME_ALONE_CONTEXT_KEY) === true && viewType === WELCOME_VIEW_TYPE;
+		if (alone === welcomeAlone) {
+			return;
+		}
+		welcomeAlone = alone;
+		this.layoutService.mainContainer.classList.toggle('ritemark-welcome-alone', alone);
+		onDidChange.fire(alone);
+	}
+}
+
+registerWorkbenchContribution2(RitemarkWelcomeAlone.ID, RitemarkWelcomeAlone, WorkbenchPhase.BlockRestore);
diff --git a/src/vs/workbench/browser/parts/ritemarkWindowSizes.ts b/src/vs/workbench/browser/parts/ritemarkWindowSizes.ts
new file mode 100644
index 00000000000..c6764e91723
--- /dev/null
+++ b/src/vs/workbench/browser/parts/ritemarkWindowSizes.ts
@@ -0,0 +1,204 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: the window makes room for the document by itself (R14; framework.md, "Window sizes", drawn in
+ * experiences/variants). When the main window crosses a width:
+ * - below 1400, the AI's sheet narrows to 320;
+ * - below 1200, the left column hides; below 960, the AI's column hides too;
+ * - crossing back up undoes what the crossing down did, unless the person changed it since.
+ * A column the person opens or closes in between is left alone until the window crosses that width again, and
+ * each column's toggle brings it back taking room, as before. The widths are the workbench's pixels (points at
+ * zoom 0). What the crossings changed is kept per window's workspace, so a restart in a narrow window does not
+ * undo or repeat them. The columns coming over the desk instead of taking room are a later step.
+ */
+
+import { RunOnceScheduler } from '../../../base/common/async.js';
+import { Disposable } from '../../../base/common/lifecycle.js';
+import { ILogService } from '../../../platform/log/common/log.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../platform/storage/common/storage.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../common/contributions.js';
+import { IWorkbenchLayoutService, Parts } from '../../services/layout/browser/layoutService.js';
+import { isRitemarkWelcomeAlone, onDidChangeRitemarkWelcomeAlone } from './ritemarkWelcomeAlone.js';
+
+/** The widths the window crosses, widest first: the AI narrows, the left column hides, the AI hides. */
+const RITEMARK_WINDOW_WIDTHS = [1400, 1200, 960];
+
+/** The AI's column when narrowed: its sheet with the chat rail, 320, and 8 on each side (400 at full width). */
+export const RITEMARK_AI_NARROW_COLUMN = 336;
+
+/** How many of the widths the window is below: 0 at 1400 and wider, 3 below 960. */
+export function ritemarkWindowBand(width: number): number {
+	return RITEMARK_WINDOW_WIDTHS.filter(crossing => width < crossing).length;
+}
+
+/** The two columns as they are now; the AI's width is unknown while it is hidden. */
+export interface IRitemarkColumns {
+	readonly leftVisible: boolean;
+	readonly aiVisible: boolean;
+	readonly aiWidth: number | undefined;
+}
+
+/** Where the window was, and what its crossings down changed, so that crossing back up can undo just that. */
+export interface IRitemarkWindowSizesMemory {
+	band: number;
+	aiWidthBefore?: number;
+	/** The width the narrowed AI's column actually got (the layout may give it a little less than asked). */
+	aiWidthSet?: number;
+	hidLeft?: boolean;
+	hidAi?: boolean;
+}
+
+/** One change to the columns. */
+export interface IRitemarkColumnChange {
+	readonly leftVisible?: boolean;
+	readonly aiVisible?: boolean;
+	readonly aiWidth?: number;
+}
+
+/**
+ * The changes for the window's move from `memory.band` to `band`, one crossing at a time in the order the window
+ * passes them. Updates `memory`.
+ */
+export function ritemarkCrossings(memory: IRitemarkWindowSizesMemory, band: number, columns: IRitemarkColumns): IRitemarkColumnChange[] {
+	const changes: IRitemarkColumnChange[] = [];
+	let { leftVisible, aiVisible, aiWidth } = columns;
+
+	while (memory.band < band) {
+		memory.band++;
+		if (memory.band === 1) {
+			// Below 1400: the AI's sheet narrows
+			memory.aiWidthBefore = memory.aiWidthSet = undefined;
+			if (aiVisible && aiWidth !== undefined && aiWidth > RITEMARK_AI_NARROW_COLUMN) {
+				memory.aiWidthBefore = aiWidth;
+				memory.aiWidthSet = aiWidth = RITEMARK_AI_NARROW_COLUMN;
+				changes.push({ aiWidth });
+			}
+		} else if (memory.band === 2) {
+			// Below 1200: the left column hides
+			memory.hidLeft = leftVisible;
+			if (leftVisible) {
+				leftVisible = false;
+				changes.push({ leftVisible });
+			}
+		} else {
+			// Below 960: the AI hides
+			memory.hidAi = aiVisible;
+			if (aiVisible) {
+				aiVisible = false;
+				aiWidth = undefined;
+				changes.push({ aiVisible });
+			}
+		}
+	}
+
+	while (memory.band > band) {
+		if (memory.band === 3) {
+			// 960 and wider: the AI comes back, if this window hid it
+			if (memory.hidAi && !aiVisible) {
+				aiVisible = true;
+				changes.push({ aiVisible });
+			}
+			memory.hidAi = undefined;
+		} else if (memory.band === 2) {
+			// 1200 and wider: the left column comes back, if this window hid it
+			if (memory.hidLeft && !leftVisible) {
+				leftVisible = true;
+				changes.push({ leftVisible });
+			}
+			memory.hidLeft = undefined;
+		} else {
+			// 1400 and wider: the AI's sheet widens again, unless the person resized it (a hidden one cannot be)
+			const untouched = aiWidth === undefined || Math.abs(aiWidth - (memory.aiWidthSet ?? RITEMARK_AI_NARROW_COLUMN)) <= 1;
+			if (memory.aiWidthBefore !== undefined && aiVisible && untouched) {
+				aiWidth = memory.aiWidthBefore;
+				changes.push({ aiWidth });
+			}
+			memory.aiWidthBefore = memory.aiWidthSet = undefined;
+		}
+		memory.band--;
+	}
+
+	return changes;
+}
+
+class RitemarkWindowSizes extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkWindowSizes';
+
+	private static readonly STORAGE_KEY = 'ritemark.windowSizes';
+
+	private readonly memory: IRitemarkWindowSizesMemory;
+	private readonly scheduler = this._register(new RunOnceScheduler(() => this.update(), 50));
+
+	constructor(
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IStorageService private readonly storageService: IStorageService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+
+		this.memory = this.load();
+		this.update();
+		this._register(layoutService.onDidLayoutMainContainer(() => this.scheduler.schedule()));
+		this._register(onDidChangeRitemarkWelcomeAlone(() => this.scheduler.schedule()));
+	}
+
+	private update(): void {
+		// The welcome alone closed both columns itself: no crossing opens one behind it (Sprint 133, R1)
+		if (isRitemarkWelcomeAlone()) {
+			return;
+		}
+		const width = this.layoutService.mainContainerDimension.width;
+		const band = ritemarkWindowBand(width);
+		if (band === this.memory.band) {
+			return;
+		}
+		const from = this.memory.band;
+
+		const aiVisible = this.layoutService.isVisible(Parts.AUXILIARYBAR_PART);
+		const changes = ritemarkCrossings(this.memory, band, {
+			leftVisible: this.layoutService.isVisible(Parts.SIDEBAR_PART),
+			aiVisible,
+			aiWidth: aiVisible ? this.layoutService.getSize(Parts.AUXILIARYBAR_PART).width : undefined,
+		});
+
+		for (const change of changes) {
+			if (change.leftVisible !== undefined) {
+				this.layoutService.setPartHidden(!change.leftVisible, Parts.SIDEBAR_PART);
+			}
+			if (change.aiVisible !== undefined) {
+				this.layoutService.setPartHidden(!change.aiVisible, Parts.AUXILIARYBAR_PART);
+			}
+			if (change.aiWidth !== undefined) {
+				const { height } = this.layoutService.getSize(Parts.AUXILIARYBAR_PART);
+				this.layoutService.setSize(Parts.AUXILIARYBAR_PART, { width: change.aiWidth, height });
+				if (change.aiWidth === RITEMARK_AI_NARROW_COLUMN && this.memory.aiWidthSet !== undefined) {
+					this.memory.aiWidthSet = this.layoutService.getSize(Parts.AUXILIARYBAR_PART).width;
+				}
+			}
+		}
+		this.save();
+		this.logService.info(`[Ritemark] window sizes: ${Math.round(width)} wide, band ${from} -> ${band}; ${JSON.stringify(changes)}; ${JSON.stringify(this.memory)}`);
+	}
+
+	private load(): IRitemarkWindowSizesMemory {
+		try {
+			const stored = JSON.parse(this.storageService.get(RitemarkWindowSizes.STORAGE_KEY, StorageScope.WORKSPACE, '{}'));
+			if (typeof stored.band === 'number') {
+				return stored;
+			}
+		} catch {
+			// A window that has not crossed anything yet
+		}
+		return { band: 0 };
+	}
+
+	private save(): void {
+		this.storageService.store(RitemarkWindowSizes.STORAGE_KEY, JSON.stringify(this.memory), StorageScope.WORKSPACE, StorageTarget.MACHINE);
+	}
+}
+
+registerWorkbenchContribution2(RitemarkWindowSizes.ID, RitemarkWindowSizes, WorkbenchPhase.AfterRestored);
diff --git a/src/vs/workbench/browser/parts/sidebar/ritemarkProjectHead.ts b/src/vs/workbench/browser/parts/sidebar/ritemarkProjectHead.ts
