+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: the window in three levels (Sprint 132, patch 018).
+ *
+ *   0    the ground   flat, no lines: the strips, the left column, the tabs not chosen, the status bar
+ *   0.5  the AI       its own sheet, 8 from the desk (drawn by the AI webview; the part only makes room)
+ *   1    the desk     one raised sheet per editor group, the chosen tab joined to it
+ *
+ * Every colour comes from the theme, through the seven ritemark.* colours the Ritemark extension
+ * contributes (--vscode-ritemark-*) and VS Code's own theme keys, so Ritemark Light and Ritemark Dark
+ * are the same rules. The sizes that layout needs live in TypeScript: RITEMARK_FRAME_STRIP_HEIGHT and
+ * RITEMARK_FRAME_CENTRE_LINE (platform/window/common/window.ts), the sheet gap (auxiliaryBarPart.ts),
+ * the desk's gaps (editorPart.ts, editorGroupView.ts).
+ *
+ * VS Code's class names are internal. Keep the selectors few and commented, and compare a screenshot of
+ * the base window, light and dark, after every VS Code update (update-vscode.sh's checklist). An !important
+ * here beats a rule of VS Code's (or an inline style) that an update can change silently, and says which on
+ * its line; where no rule of VS Code's competes in any state, there is none.
+ */
+
+.monaco-workbench {
+	--rm-ground: var(--vscode-ritemark-ground, var(--vscode-sideBar-background));
+	--rm-desk: var(--vscode-ritemark-desk, var(--vscode-editor-background));
+	--rm-hairline: var(--vscode-ritemark-sheetBorder, var(--vscode-widget-border, transparent));
+	--rm-shadow: var(--vscode-ritemark-sheetShadow, transparent);
+	--rm-place-background: var(--vscode-ritemark-placeActiveBackground, var(--vscode-list-activeSelectionBackground));
+	--rm-place-foreground: var(--vscode-ritemark-placeActiveForeground, var(--vscode-list-activeSelectionForeground));
+	--rm-hover: var(--vscode-toolbar-hoverBackground);
+	--rm-body: var(--vscode-tab-inactiveForeground); /* the kit's body ink: #475569 in Light, #C7D2FE in Dark */
+	--rm-muted: var(--vscode-descriptionForeground); /* the kit's muted ink: #617187 in Light, #94A3B8 in Dark */
+	--rm-radius: 10px;
+	--rm-hairline-width: 1px; /* the desk's and the chosen tab's edge */
+	--rm-fillet: 8px; /* the radius where the chosen tab meets the desk */
+	--rm-fillet-box: calc(var(--rm-fillet) + var(--rm-hairline-width)); /* a fillet with its hairline */
+	/* The desk's edge and the chosen tab's (2.1.0's Gate 1 join pass, the Experience lead's rulings at 04eba74): the
+	   hairline laid over a line of the desk's own colour, so the edge is opaque and one tone wherever it lies (over a
+	   webview's page, a terminal, the browser's page or the ground beside the chosen tab), and the desk and its tab are
+	   one sheet. Ritemark Dark's #FFFFFF14 over #1E1B4B reads #302d56; Ritemark Light's hairline is opaque already. The
+	   AI's sheet lays the same hairline over its own colour (the AI webview), so it reads its own tone, #2b294d */
+	--rm-desk-edge: inset 0 0 0 var(--rm-hairline-width) var(--rm-hairline), inset 0 0 0 var(--rm-hairline-width) var(--rm-desk);
+	--rm-tab-edge: 0 0 0 var(--rm-hairline-width) var(--rm-hairline), 0 0 0 var(--rm-hairline-width) var(--rm-desk);
+	/* the room the window controls take at the left (the Mac's traffic lights) and the right (Windows' buttons) */
