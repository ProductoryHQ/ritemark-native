+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { timeout } from '../../../../base/common/async.js';
+import { IDisposable } from '../../../../base/common/lifecycle.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { IContextViewDelegate, IContextViewService } from '../../../../platform/contextview/browser/contextView.js';
+import { showRitemarkMenu } from '../../../browser/parts/ritemarkMenu.js';
+
+/**
+ * Ritemark 2.0 (Sprint 134, R8): the head's Switch project ▸ opens one flyout. A pointer coming to rest on the row and
+ * a click on it arrive while the flyout's rows are still being asked for; before the fix each drew a flyout of its own.
+ */
+suite('Ritemark menu', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('a pointer resting on a flyout row and a click on it open one flyout', async () => {
+		const container = document.createElement('div');
+		const anchor = document.createElement('div');
+		document.body.append(container, anchor);
+		let rendered: IDisposable | undefined;
+		let onHide: (() => void) | undefined;
+		const contextViewService = {
+			showContextView: (delegate: IContextViewDelegate) => {
+				rendered = delegate.render(container) ?? undefined;
+				onHide = delegate.onHide;
+			},
+			hideContextView: () => {
+				rendered?.dispose();
+				rendered = undefined;
+				container.textContent = '';
+				onHide?.();
+			},
+		} as unknown as IContextViewService;
+		let asked = 0;
+		showRitemarkMenu(contextViewService, anchor, { className: 'ritemark-project-menu', ariaLabel: 'Project', align: 'left' }, [{
+			label: 'Switch project',
+			iconClassNames: [],
+			run: () => { },
+			submenu: async () => {
+				asked++;
+				await timeout(5);
+				return [{ label: 'Sales proposal Q4', iconClassNames: [], run: () => { } }];
+			},
+		}], () => { });
+
+		const row = container.querySelector<HTMLElement>('.ritemark-menu-item')!;
+		row.dispatchEvent(new MouseEvent('mouseenter'));
+		row.click();
+		await timeout(30);
+
+		assert.deepStrictEqual({
+			flyouts: container.querySelectorAll('.ritemark-menu-flyout').length,
+			asked,
+			expanded: row.getAttribute('aria-expanded'),
+		}, { flyouts: 1, asked: 1, expanded: 'true' });
+
+		contextViewService.hideContextView();
+		container.remove();
+		anchor.remove();
+	});
+});
diff --git a/src/vs/workbench/test/browser/parts/ritemarkSwitchGuard.test.ts b/src/vs/workbench/test/browser/parts/ritemarkSwitchGuard.test.ts
