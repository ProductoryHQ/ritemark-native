index 00000000000..23ff99aa8d9
--- /dev/null
+++ b/src/vs/workbench/browser/parts/sidebar/ritemarkProjectHead.ts
@@ -0,0 +1,194 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: the left column's head on Documents (R10) and on Agents (experience 31), as drawn (surfaces/README.md,
+ * Measurements).
+ *
+ * The project's mark (its initials in a 24 square of ink) and its whole name, with a chevron that opens the
+ * project's menu (the folder tools VS Code shows as icons live there); then New and Search as rows, and the Documents label over the tree. The
+ * place and the drawing live here, and both menus are Ritemark menus (ritemarkMenu.ts), as the project's
+ * menu is drawn (experiences/home frame 2: 232 wide, 4 under the head). Their entries, words and icons
+ * come from the extension, through the `ritemark/projectHead` and `ritemark/projectHead/new` menus
+ * (menusExtensionPoint.ts), so an extension release can change them; each menu group is set apart by a
+ * hairline. On Agents, New lists the library's four kinds and Search finds in the library; Documents adds its label
+ * over the tree. Other places keep their own simple head.
+ */
+
+import { $, addDisposableListener, append, EventType } from '../../../../base/browser/dom.js';
+import { StandardKeyboardEvent } from '../../../../base/browser/keyboardEvent.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { KeyCode } from '../../../../base/common/keyCodes.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { IMenuService, MenuId, MenuItemAction } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { IContextViewService } from '../../../../platform/contextview/browser/contextView.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { RITEMARK_MENU_SEPARATOR, RitemarkMenuEntry, showRitemarkMenu } from '../ritemarkMenu.js';
+
+const PROJECT_MENU = MenuId.for('ritemark/projectHead');
+
+/** The places with the project's head: what their New lists, what their Search runs, and the label over their content. */
+interface IRitemarkHeadPlace {
+	readonly newMenu: MenuId;
+	readonly search: string;
+	readonly group?: string;
+}
+
+const HEAD_PLACES = new Map<string, IRitemarkHeadPlace>([
+	['workbench.view.explorer', { newMenu: MenuId.for('ritemark/projectHead/new'), search: 'workbench.view.search', group: localize('ritemark.project.documents', "Documents") }],
+	['workbench.view.extension.ritemark-agent-library', { newMenu: MenuId.for('ritemark/projectHead/agents/new'), search: 'ritemark.agentLibrary.search' }],
+]);
+
+/** "Harbour leadership programme" → "HL": the first letter or digit of the first two words. */
+export function ritemarkProjectInitials(name: string): string {
+	const words = name.split(/[\s:_-]+/).filter(word => /[\p{L}\p{N}]/u.test(word));
+	return words.slice(0, 2).map(word => [...word.replace(/[^\p{L}\p{N}]/gu, '')][0] ?? '').join('').toUpperCase() || '·';
+}
+
+export class RitemarkProjectHead extends Disposable {
+
+	private readonly label: HTMLElement;
+	private readonly mark: HTMLElement;
+	private readonly name: HTMLElement;
+	private readonly rows: HTMLElement;
+	private readonly group: HTMLElement;
+	private place: IRitemarkHeadPlace | undefined;
+
+	private get active(): boolean {
+		return !!this.place;
+	}
+
+	constructor(
+		private readonly part: HTMLElement,
+		titleArea: HTMLElement,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextViewService private readonly contextViewService: IContextViewService,
+		@IContextKeyService private readonly contextKeyService: IContextKeyService,
+		@IMenuService private readonly menuService: IMenuService,
+		@IWorkspaceContextService private readonly workspaceService: IWorkspaceContextService,
+	) {
+		super();
+
+		// The head: the project's mark, its whole name (in place of the place's own title) and a chevron; the whole
+		// label opens the project's menu
+		const label = this.label = titleArea.querySelector<HTMLElement>(':scope > .title-label')!;
+		label.classList.add('ritemark-project-head');
+		this.mark = $('span.ritemark-project-mark', { 'aria-hidden': 'true' });
+		this.name = $('span.ritemark-project-name');
+		label.prepend(this.mark, this.name);
+		append(label, renderIcon(Codicon.chevronDown)).classList.add('ritemark-project-chevron');
+		this.updateProject();
+		this._register(this.workspaceService.onDidChangeWorkspaceFolders(() => this.updateProject()));
+		this._register(this.workspaceService.onDidChangeWorkspaceName(() => this.updateProject()));
+		const openProjectMenu = () => this.showMenu(PROJECT_MENU, label, localize('ritemark.project.menu', "Project"));
+		this._register(addDisposableListener(label, EventType.CLICK, () => {
+			if (this.active) {
+				openProjectMenu();
+			}
+		}));
+		this._register(addDisposableListener(label, EventType.KEY_DOWN, e => {
+			const event = new StandardKeyboardEvent(e);
+			if (this.active && (event.equals(KeyCode.Enter) || event.equals(KeyCode.Space) || event.equals(KeyCode.DownArrow))) {
+				event.preventDefault();
+				openProjectMenu();
+			}
+		}));
+
+		// New and Search as rows, then the place's label over its content
+		this.rows = $('.ritemark-project-rows');
+		titleArea.after(this.rows);
+		this._register({ dispose: () => this.rows.remove() });
