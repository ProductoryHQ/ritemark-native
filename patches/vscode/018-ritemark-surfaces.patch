index 00000000000..a19755eb243
--- /dev/null
+++ b/src/vs/workbench/browser/parts/sidebar/ritemarkProjectHead.ts
@@ -0,0 +1,361 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0: the left column's head on Documents (R10) and on Agents (experience 31), as drawn (surfaces/README.md,
+ * Measurements); from Sprint 134 on Tasks, Browser and Transcribe too (R16), each place with its own rows, whose words
+ * and icons come from the extension's commands. On Home the column holds the projects list (R7): no project head and
+ * no title row, so the list's own search sits on the head's line.
+ *
+ * The project's mark (its initials in a 24 square of ink) and its whole name, with a chevron that opens the
+ * project's menu (the folder tools VS Code shows as icons live there); then New and Search as rows, and the Documents label over the tree. The
+ * place and the drawing live here, and both menus are Ritemark menus (ritemarkMenu.ts), as the project's
+ * menu is drawn (experiences/home frame 2: 232 wide, 4 under the head). Their entries, words and icons
+ * come from the extension, through the `ritemark/projectHead` and `ritemark/projectHead/new` menus
+ * (menusExtensionPoint.ts), so an extension release can change them; each menu group is set apart by a
+ * hairline. On Agents, New lists the library's four kinds and Search finds in the library; Documents adds its label
+ * over the tree. Other places keep their own simple head.
+ */
+
+import { $, addDisposableListener, append, EventType } from '../../../../base/browser/dom.js';
+import { StandardKeyboardEvent } from '../../../../base/browser/keyboardEvent.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { KeyCode } from '../../../../base/common/keyCodes.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable, DisposableStore } from '../../../../base/common/lifecycle.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { localize } from '../../../../nls.js';
+import { IMenuService, MenuId, MenuItemAction, MenuRegistry } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { IContextViewService } from '../../../../platform/contextview/browser/contextView.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+import { IExtensionService } from '../../../services/extensions/common/extensions.js';
+import { RITEMARK_MENU_SEPARATOR, RitemarkMenuEntry, showRitemarkMenu } from '../ritemarkMenu.js';
+
+const PROJECT_MENU = MenuId.for('ritemark/projectHead');
+
+/**
+ * A row under the head: an extension command, whose contribution gives the row its words and icon, run on a click,
+ * or, with a menu, the extension's menu shown under the row (Documents' and Agents' New).
+ */
+interface IRitemarkHeadRow {
+	readonly command: string;
+	readonly menu?: MenuId;
+}
+
+/** The places with the project's head: their rows (up to two), and the label over their content. */
+interface IRitemarkHeadPlace {
+	readonly rows: readonly IRitemarkHeadRow[];
+	readonly group?: string;
+}
+
+const NEW_ROW = 'ritemark.projectHead.newRow';
+const HEAD_PLACES = new Map<string, IRitemarkHeadPlace>([
+	['workbench.view.explorer', { rows: [{ command: NEW_ROW, menu: MenuId.for('ritemark/projectHead/new') }, { command: 'ritemark.projectHead.search' }], group: localize('ritemark.project.documents', "Documents") }],
+	['workbench.view.extension.ritemark-agent-library', { rows: [{ command: NEW_ROW, menu: MenuId.for('ritemark/projectHead/agents/new') }, { command: 'ritemark.agentLibrary.search' }] }],
+	// Sprint 134 (R16–R18): the project's head on every place but Home
+	['workbench.view.extension.ritemark-tasks', { rows: [{ command: 'ritemark.tasks.newTask' }, { command: 'ritemark.tasks.search' }] }],
+	['workbench.view.extension.ritemark-browser', { rows: [{ command: 'ritemark.browser.newPage' }] }],
+	['workbench.view.extension.ritemark-transcribe', { rows: [{ command: 'ritemark.transcribe.record' }, { command: 'ritemark.transcribe.addFile' }] }],
+]);
+
+/**
+ * Sprint 134 (R8): a project menu entry that opens a flyout, and the extension command that gives its rows when it
+ * opens (the projects, with what waits in each, then All projects, on Home and Open in a new window). A static menu
+ * cannot list projects. Without the command (an older extension) the entry runs as an ordinary item.
+ */
+const FLYOUTS = new Map<string, string>([['ritemark.projectHead.switchProject', 'ritemark.projects.switcherItems']]);
+
+/** One row of a flyout, as the extension describes it. */
+interface IRitemarkFlyoutRow {
+	readonly label: string;
+	readonly mark?: string;
+	readonly sub?: string;
+	readonly checked?: boolean;
+	readonly icon?: string;
+	/** A second line: a not-found project's old place. */
+	readonly detail?: string;
+	/** Muted, with an icon at its right: a project whose folder is not found. */
+	readonly muted?: boolean;
+	readonly trailingIcon?: string;
+	readonly command: string;
+	readonly args?: readonly unknown[];
+	readonly separatorBefore?: boolean;
+}
+
+function isFlyoutRow(value: unknown): value is IRitemarkFlyoutRow {
+	const row = value as Partial<IRitemarkFlyoutRow> | null;
+	return !!row && typeof row.label === 'string' && typeof row.command === 'string';
+}
+
+/** Home's place (Sprint 134, R7): the column is the projects list, with no title row. */
+const HOME_PLACE = 'workbench.view.extension.ritemark-home';
+
+/** "Harbour leadership programme" → "HL": the first letter or digit of the first two words. */
+export function ritemarkProjectInitials(name: string): string {
+	// Two letters, as the welcome draws them (Sprint 134: one rule everywhere): two words' first letters, or one
+	// word's first two ("Notes" → "NO")
+	const words = name.split(/[\s:_-]+/).filter(word => /[\p{L}\p{N}]/u.test(word));
+	const letters = (word: string) => [...word.replace(/[^\p{L}\p{N}]/gu, '')];
+	const mark = words.length >= 2 ? (letters(words[0])[0] ?? '') + (letters(words[1])[0] ?? '') : letters(words[0] ?? '').slice(0, 2).join('');
+	return mark.toUpperCase() || '·';
+}
+
+export class RitemarkProjectHead extends Disposable {
+
+	private readonly label: HTMLElement;
+	private readonly mark: HTMLElement;
+	private readonly name: HTMLElement;
+	private readonly rows: HTMLElement;
+	private readonly rowList: HTMLElement;
+	private readonly group: HTMLElement;
+	private place: IRitemarkHeadPlace | undefined;
+	private home = false;
+	/** The title row's height, measured while it is drawn: Home's content takes it. */
+	private titleHeight = 40;
+	private readonly titleArea: HTMLElement;
+
+	/**
+	 * Sprint 145 (#569): until the extensions are read, a row whose command is not registered yet keeps its room, so
+	 * New and Search fill rows already drawn and the content under them never moves.
+	 */
+	private extensionsRead = false;
+
+	private readonly _onDidChangeRows = this._register(new Emitter<void>());
+	/** The rows changed outside update(): the column lays its content out again (rowsHeight) */
+	readonly onDidChangeRows = this._onDidChangeRows.event;
+
+	private get active(): boolean {
+		return !!this.place;
+	}
+
+	constructor(
+		private readonly part: HTMLElement,
+		titleArea: HTMLElement,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextViewService private readonly contextViewService: IContextViewService,
+		@IContextKeyService private readonly contextKeyService: IContextKeyService,
+		@IMenuService private readonly menuService: IMenuService,
+		@IWorkspaceContextService private readonly workspaceService: IWorkspaceContextService,
+		@IExtensionService extensionService: IExtensionService,
+	) {
+		super();
+		this.titleArea = titleArea;
+
+		// The head: the project's mark, its whole name (in place of the place's own title) and a chevron; the whole
+		// label opens the project's menu
+		const label = this.label = titleArea.querySelector<HTMLElement>(':scope > .title-label')!;
+		label.classList.add('ritemark-project-head');
+		this.mark = $('span.ritemark-project-mark', { 'aria-hidden': 'true' });
+		this.name = $('span.ritemark-project-name');
+		label.prepend(this.mark, this.name);
+		append(label, renderIcon(Codicon.chevronDown)).classList.add('ritemark-project-chevron');
+		this.updateProject();
+		this._register(this.workspaceService.onDidChangeWorkspaceFolders(() => this.updateProject()));
+		this._register(this.workspaceService.onDidChangeWorkspaceName(() => this.updateProject()));
+		const openProjectMenu = () => this.showMenu(PROJECT_MENU, label, localize('ritemark.project.menu', "Project"));
+		this._register(addDisposableListener(label, EventType.CLICK, () => {
+			if (this.active) {
+				openProjectMenu();
+			}
+		}));
+		this._register(addDisposableListener(label, EventType.KEY_DOWN, e => {
+			const event = new StandardKeyboardEvent(e);
+			if (this.active && (event.equals(KeyCode.Enter) || event.equals(KeyCode.Space) || event.equals(KeyCode.DownArrow))) {
+				event.preventDefault();
+				openProjectMenu();
+			}
+		}));
+
+		// The place's rows, then its label over its content
+		this.rows = $('.ritemark-project-rows');
+		titleArea.after(this.rows);
+		this._register({ dispose: () => this.rows.remove() });
+		this.rowList = append(this.rows, $('.ritemark-project-row-list'));
+		this.group = append(this.rows, $('.ritemark-project-group', { role: 'heading', 'aria-level': '2' }));
+		// The extension's commands may register after the first draw: draw the rows again when they do. When that
+		// changes how many rows there are (a window that opens on Documents draws its head before the extension's
+		// New and Search exist), the column lays its content out again: else the tree ran the rows' height (64 on
+		// Documents) past the column's foot, under the status bar, where its last rows and its slider's foot could not be
+		// reached (2.1.0's join pass)
+		const drawRowsAgain = () => {
+			if (this.place) {
+				const before = this.rowList.childElementCount;
+				this.renderRows(this.place);
+				if (this.rowList.childElementCount !== before) {
+					this._onDidChangeRows.fire();
+				}
+			}
+		};
+		this._register(MenuRegistry.onDidChangeMenu(drawRowsAgain));
+		// Sprint 145 (#569): once the extensions are read, a row whose command is still missing goes (an older extension)
+		extensionService.whenInstalledExtensionsRegistered().then(() => {
+			if (!this._store.isDisposed) {
+				this.extensionsRead = true;
+				drawRowsAgain();
+			}
+		});
+	}
+
+	/**
+	 * What the head adds above the content: its rows (the content gets the rest). On Home the title row is not
+	 * drawn, so the content gets its height too.
+	 */
+	get rowsHeight(): number {
+		if (this.home) {
+			return -this.titleHeight;
+		}
+		return this.active ? this.rows.offsetHeight : 0;
+	}
+
+	/** The place shown; returns whether the column's head changed. */
+	update(compositeId: string | undefined): boolean {
+		const home = compositeId === HOME_PLACE;
+		const homeChanged = home !== this.home;
+		if (homeChanged) {
+			// Measure the title row before hiding it, so the content can take its height.
