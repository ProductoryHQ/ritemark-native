+			if (row.separatorBefore && entries.length) {
+				entries.push(RITEMARK_MENU_SEPARATOR);
+			}
+			entries.push({
+				label: row.label,
+				mark: row.mark,
+				sub: row.sub,
+				checked: row.checked,
+				detail: typeof row.detail === 'string' ? row.detail : undefined,
+				muted: row.muted === true,
+				trailingIconClassNames: typeof row.trailingIcon === 'string' ? ThemeIcon.asClassNameArray(ThemeIcon.fromId(row.trailingIcon)) : undefined,
+				iconClassNames: row.icon ? ThemeIcon.asClassNameArray(ThemeIcon.fromId(row.icon)) : [],
+				run: event => this.commandService.executeCommand(row.command, ...(row.args ?? []), { newWindow: event?.altKey === true }),
+			});
+		}
