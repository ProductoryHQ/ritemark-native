+				this.sendViewsHome(this.viewDescriptorService.getViewContainerModel(ai).allViewDescriptors);
+			}
+		}));
+
+		// A view dragged into the AI's own container (the terminal's, in an older profile) goes back to its own
+		this._register(viewDescriptorService.onDidChangeContainer(({ views, to }) => {
+			if (to.id === RITEMARK_AI_CONTAINER) {
+				this.sendViewsHome(views);
+			}
+		}));
+	}
+
+	private sendViewsHome(views: readonly IViewDescriptor[]): void {
+		queueMicrotask(() => {
+			for (const view of views) {
+				const home = this.viewDescriptorService.getDefaultContainerById(view.id);
+				if (home && home.id !== RITEMARK_AI_CONTAINER && this.viewDescriptorService.getViewContainerByViewId(view.id)?.id === RITEMARK_AI_CONTAINER) {
+					this.viewDescriptorService.moveViewsToContainer([view], home, undefined, 'ritemark.aiColumn');
+				}
+			}
+		});
+	}
+
+	private moveOut(containers: readonly ViewContainer[]): void {
+		const strays = containers.filter(container => container.id !== RITEMARK_AI_CONTAINER);
+		if (!strays.length) {
+			return;
+		}
+
+		// After the change that brought them here has finished
+		queueMicrotask(() => {
+			for (const container of strays) {
+				if (this.viewDescriptorService.getViewContainerLocation(container) !== ViewContainerLocation.AuxiliaryBar) {
+					continue;
+				}
+				const home = this.viewDescriptorService.getDefaultViewContainerLocation(container);
+				const to = container.id === COPILOT_CHAT_CONTAINER ? ViewContainerLocation.Panel
+					: home !== null && home !== ViewContainerLocation.AuxiliaryBar ? home
+						: ViewContainerLocation.Sidebar;
+				this.viewDescriptorService.moveViewContainerToLocation(container, to, undefined, 'ritemark.aiColumn');
+			}
+		});
+	}
+}
+
+if (RITEMARK_AI_COLUMN_ALONE) {
+	registerWorkbenchContribution2(RitemarkAiColumnGuard.ID, RitemarkAiColumnGuard, WorkbenchPhase.BlockRestore);
+}
