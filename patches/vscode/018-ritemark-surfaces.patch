+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { IRitemarkColumnChange, IRitemarkColumns, IRitemarkWindowSizesMemory, ritemarkCrossings, ritemarkWindowBand } from '../../../browser/parts/ritemarkWindowSizes.js';
+
+/**
+ * Ritemark 2.0 (Sprint 132, R14): below 1400 the AI's sheet narrows to 320 (its column 336), below 1200 the left
+ * column hides, below 960 the AI hides; crossing back up undoes only what the crossing down did.
+ */
+suite('Ritemark window sizes', () => {
+
+	interface ILayout { leftVisible: boolean; aiVisible: boolean; aiWidth: number }
+
+	/** Walks the window through widths, applying each crossing's changes as the layout does: a hidden AI keeps its width. */
+	function walk(widths: number[], layout: ILayout, memory: IRitemarkWindowSizesMemory = { band: 0 }) {
+		const steps: { width: number; changes: IRitemarkColumnChange[] }[] = [];
+		for (const width of widths) {
+			const columns: IRitemarkColumns = { ...layout, aiWidth: layout.aiVisible ? layout.aiWidth : undefined };
+			const changes = ritemarkCrossings(memory, ritemarkWindowBand(width), columns);
+			for (const change of changes) {
+				layout = { ...layout, ...change };
+			}
+			steps.push({ width, changes });
+		}
+		return { steps, layout, memory };
+	}
+
+	test('the bands', () => {
+		assert.deepStrictEqual([1500, 1400, 1399, 1200, 1199, 960, 959, 600].map(ritemarkWindowBand), [0, 0, 1, 1, 2, 2, 3, 3]);
+	});
+
+	test('narrowing from 1500 to 900 and back (S42)', () => {
+		const { steps } = walk([1500, 1300, 1100, 900, 1100, 1300, 1500], { leftVisible: true, aiVisible: true, aiWidth: 400 });
+
+		assert.deepStrictEqual(steps, [
+			{ width: 1500, changes: [] },
+			{ width: 1300, changes: [{ aiWidth: 336 }] },
+			{ width: 1100, changes: [{ leftVisible: false }] },
+			{ width: 900, changes: [{ aiVisible: false }] },
+			{ width: 1100, changes: [{ aiVisible: true }] },
+			{ width: 1300, changes: [{ leftVisible: true }] },
+			{ width: 1500, changes: [{ aiWidth: 400 }] },
+		]);
+	});
+
+	test('a jump across every width takes each crossing in order', () => {
+		const down = walk([900], { leftVisible: true, aiVisible: true, aiWidth: 420 });
+		const up = walk([1600], down.layout, down.memory);
+
+		assert.deepStrictEqual({ down: down.steps[0].changes, up: up.steps[0].changes, after: up.layout }, {
+			down: [{ aiWidth: 336 }, { leftVisible: false }, { aiVisible: false }],
+			up: [{ aiVisible: true }, { leftVisible: true }, { aiWidth: 420 }],
+			after: { leftVisible: true, aiVisible: true, aiWidth: 420 },
+		});
+	});
+
+	test('a column the person opened stays open until the window crosses that width again (S43)', () => {
+		const narrow = walk([1100], { leftVisible: true, aiVisible: true, aiWidth: 400 });
+		// The person opens the left column at 1100
+		const opened = walk([1150, 1250, 1100], { ...narrow.layout, leftVisible: true }, narrow.memory);
+
+		assert.deepStrictEqual(opened.steps, [
+			{ width: 1150, changes: [] },
+			{ width: 1250, changes: [] },
+			{ width: 1100, changes: [{ leftVisible: false }] },
+		]);
+	});
+
+	test('the narrowed AI comes back even when the layout gave it a little less than 336', () => {
+		const narrowed = walk([1300], { leftVisible: true, aiVisible: true, aiWidth: 400 });
+		// The layout gave the narrowed column 333; the window remembers what it got
+		narrowed.memory.aiWidthSet = 333;
+		const widened = walk([1500], { ...narrowed.layout, aiWidth: 333 }, narrowed.memory);
+
+		assert.deepStrictEqual({ changes: widened.steps[0].changes, memory: widened.memory }, { changes: [{ aiWidth: 400 }], memory: { band: 0, aiWidthBefore: undefined, aiWidthSet: undefined } });
+	});
+
+	test('what the person changed is not undone', () => {
+		// The person hid the left column at 1500; then, at 1300, widened the narrowed AI to 360
+		const narrowed = walk([1300, 1100, 1250], { leftVisible: false, aiVisible: true, aiWidth: 400 });
+		const widened = walk([1500], { ...narrowed.layout, aiWidth: 360 }, narrowed.memory);
+
+		assert.deepStrictEqual({ narrowed: narrowed.steps.map(step => step.changes), widened: widened.steps[0].changes, after: widened.layout }, {
+			narrowed: [[{ aiWidth: 336 }], [], []],
+			widened: [],
+			after: { leftVisible: false, aiVisible: true, aiWidth: 360 },
+		});
+	});
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+});
