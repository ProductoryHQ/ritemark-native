index 00000000000..05ea0275947
--- /dev/null
+++ b/src/vs/workbench/browser/parts/ritemarkFrameMenu.ts
@@ -0,0 +1,87 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.0 (Windows): the application menu behind a button at the start of the left column's strip,
+ * where the Mac has its traffic lights (R2). It is VS Code's own menu bar control, in a slot too narrow
+ * for any menu title, so it shows only its overflow button and opens File, Edit, View and Help downward.
+ * Alt and the arrow keys work as in VS Code's menu bar. When the left column is hidden, the button moves
+ * onto the desk's strip with the column's toggle.
+ */
+
+import { $, append, Dimension } from '../../../base/browser/dom.js';
+import { Emitter } from '../../../base/common/event.js';
+import { Disposable, DisposableStore, IDisposable, MutableDisposable, toDisposable } from '../../../base/common/lifecycle.js';
+import { isNative, isWindows } from '../../../base/common/platform.js';
+import { IInstantiationService } from '../../../platform/instantiation/common/instantiation.js';
+import { RITEMARK_FRAME_WITHOUT_TITLE_ROW } from '../../../platform/window/common/window.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../common/contributions.js';
+import { IWorkbenchLayoutService, Parts } from '../../services/layout/browser/layoutService.js';
+import { CustomMenubarControl } from './titlebar/menubarControl.js';
+
+/** Ritemark 2.0: whether the main window's strips carry the application menu (Windows; the Mac keeps its menu bar). */
+export const RITEMARK_FRAME_MENU = RITEMARK_FRAME_WITHOUT_TITLE_ROW && isNative && isWindows;
+
+const slots = new Map<'column' | 'desk', HTMLElement>();
+const onDidChangeSlots = new Emitter<void>();
+
+/** A left strip offers its slot for the menu button: the left column's own, or the desk's (when the column is hidden). */
+export function registerRitemarkFrameMenuSlot(kind: 'column' | 'desk', slot: HTMLElement): IDisposable {
+	slots.set(kind, slot);
+	onDidChangeSlots.fire();
+	return toDisposable(() => {
+		if (slots.get(kind) === slot) {
+			slots.delete(kind);
+			onDidChangeSlots.fire();
+		}
+	});
+}
+
+class RitemarkFrameMenu extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.ritemarkFrameMenu';
+
+	private readonly menu = this._register(new MutableDisposable<DisposableStore>());
+	private host: HTMLElement | undefined;
+
+	constructor(
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+	) {
+		super();
+
+		this.place();
+		this._register(onDidChangeSlots.event(() => this.place()));
+		this._register(layoutService.onDidChangePartVisibility(e => {
+			if (e.partId === Parts.SIDEBAR_PART) {
+				this.place();
+			}
+		}));
+		this._register(toDisposable(() => this.host?.remove()));
+	}
+
+	private place(): void {
+		const slot = this.layoutService.isVisible(Parts.SIDEBAR_PART) ? slots.get('column') : slots.get('desk');
+		if (!slot || this.host?.parentElement === slot) {
+			return;
+		}
+
+		// One menu bar at a time, so only one answers Alt: build it again in its new place
+		this.menu.clear();
+		this.host?.remove();
+		const host = this.host = append(slot, $('div.menubar.ritemark-frame-menu', { role: 'menubar' }));
+		const menu = this.menu.value = new DisposableStore();
+		const control = menu.add(this.instantiationService.createInstance(CustomMenubarControl));
+		control.create(host);
+		control.layout(new Dimension(host.clientWidth, host.clientHeight));
+
+		// The strips stop dragging the window while the menu has focus, as VS Code's title bar does
+		menu.add(control.onFocusStateChange(focused => this.layoutService.mainContainer.classList.toggle('ritemark-frame-menu-focused', focused)));
+	}
+}
+
+if (RITEMARK_FRAME_MENU) {
+	registerWorkbenchContribution2(RitemarkFrameMenu.ID, RitemarkFrameMenu, WorkbenchPhase.BlockRestore);
+}
