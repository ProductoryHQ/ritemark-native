@@ -0,0 +1,162 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { timeout } from '../../../../base/common/async.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { Orientation } from '../../../../base/browser/ui/grid/grid.js';
+import { IDialogService } from '../../../../platform/dialogs/common/dialogs.js';
+import { StorageScope, WillSaveStateReason } from '../../../../platform/storage/common/storage.js';
+import { IWorkspaceContextService, WorkbenchState } from '../../../../platform/workspace/common/workspace.js';
+import { askRitemarkBeforeReload, ritemarkHomeInFront, ritemarkLandsOnHome, RitemarkSwitchGuard } from '../../../browser/parts/ritemarkSwitchGuard.js';
+import { BeforeShutdownEvent, ILifecycleService, ShutdownReason } from '../../../services/lifecycle/common/lifecycle.js';
+import { TestStorageService } from '../../common/workbenchTestServices.js';
+
+/**
+ * Ritemark 2.0 (Sprint 134, R9): an unload that opens another folder here waits for the extension's answer; anything
+ * but a clear true lets it go on, and a guard that neither answers nor asks within the ceiling never keeps the window.
+ * Sprint 145 (#569): the window the switch opens lands on Home from its first frame, by the extension's rule.
+ */
+suite('Ritemark switch guard', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function commands(answer: () => Promise<unknown>, calls: unknown[][] = []): ICommandService {
+		return {
+			executeCommand: (id: string, ...args: unknown[]) => {
+				calls.push([id, ...args]);
+				return answer();
+			}
+		} as unknown as ICommandService;
+	}
+
+	test('the extension\'s answer decides, with the folder about to open', async () => {
+		const dialogs = store.add(new Emitter<void>());
+		const calls: unknown[][] = [];
+		const target = URI.file('/projects/Other');
+		const stop = await askRitemarkBeforeReload(commands(async () => true, calls), { onWillShowDialog: dialogs.event }, target);
+		const go = await askRitemarkBeforeReload(commands(async () => false), { onWillShowDialog: dialogs.event }, undefined);
+		assert.deepStrictEqual({ stop, go, calls }, { stop: true, go: false, calls: [['_ritemark.projects.beforeReload', target.toString()]] });
+	});
+
+	test('no such command, or no answer and no question within the ceiling: the reload goes on', async () => {
+		const dialogs = store.add(new Emitter<void>());
+		const missing = await askRitemarkBeforeReload(commands(() => Promise.reject(new Error('command not found'))), { onWillShowDialog: dialogs.event }, undefined);
+		const silent = await askRitemarkBeforeReload(commands(() => new Promise(() => { })), { onWillShowDialog: dialogs.event }, undefined, 5);
+		assert.deepStrictEqual({ missing, silent }, { missing: false, silent: false });
+	});
+
+	test('a question on screen waits for the person past the ceiling', async () => {
+		const dialogs = store.add(new Emitter<void>());
+		const answer = askRitemarkBeforeReload(commands(async () => {
+			dialogs.fire();
+			await timeout(30);
+			return true;
+		}), { onWillShowDialog: dialogs.event }, undefined, 5);
+		assert.strictEqual(await answer, true);
+	});
+
+	test('#569: the window a switch opens lands on Home: within two minutes, in the folder it opened, or any other one', () => {
+		const sales = 'file:///p/sales';
+		const lead = 'file:///p/lead';
+		const now = 1_000_000;
+		const cases = {
+			'Open Recent to sales, in sales': ritemarkLandsOnHome({ from: lead, target: sales, at: now - 3000 }, sales, now),
+			'its trailing slash': ritemarkLandsOnHome({ from: lead, target: `${sales}/`, at: now - 3000 }, sales, now),
+			'Open Recent to sales, in another folder': ritemarkLandsOnHome({ from: lead, target: sales, at: now - 3000 }, 'file:///p/other', now),
+			'Open Folder (no target), in another folder': ritemarkLandsOnHome({ from: lead, target: null, at: now - 3000 }, sales, now),
+			'Open Folder (no target), back in the same one': ritemarkLandsOnHome({ from: lead, target: null, at: now - 3000 }, lead, now),
+			'after two minutes': ritemarkLandsOnHome({ from: lead, target: sales, at: now - 2 * 60 * 1000 - 1 }, sales, now),
+			'a window with no folder': ritemarkLandsOnHome({ from: lead, target: null, at: now - 3000 }, undefined, now),
+			'no note, or a broken one': ritemarkLandsOnHome(undefined, sales, now) || ritemarkLandsOnHome({ target: sales }, sales, now),
+		};
+		assert.deepStrictEqual(cases, {
+			'Open Recent to sales, in sales': true,
+			'its trailing slash': true,
+			'Open Recent to sales, in another folder': false,
+			'Open Folder (no target), in another folder': true,
+			'Open Folder (no target), back in the same one': false,
+			'after two minutes': false,
+			'a window with no folder': false,
+			'no note, or a broken one': false,
+		});
+	});
+
+	test('#569: Home\'s tab goes first in its desk\'s order of use, the tabs\' order and the other desk unchanged', () => {
+		const home = { id: 'workbench.editors.webviewInput', value: JSON.stringify({ viewType: 'mainThreadWebview-ritemark.home' }) };
+		const board = { id: 'workbench.editors.webviewInput', value: JSON.stringify({ viewType: 'mainThreadWebview-ritemark.taskBoard' }) };
+		const plan = { id: 'workbench.editors.file', value: '{"resourceJSON":{"path":"/p/sales/Plan.md"}}' };
+		const first = { id: 1, editors: [home, board, plan], mru: [2, 1, 0], sticky: 1 };
+		const second = { id: 2, editors: [plan], mru: [0] };
+		const grid = { orientation: Orientation.HORIZONTAL, width: 800, height: 600, root: { type: 'branch' as const, size: 600, data: [{ type: 'leaf' as const, size: 400, data: first }, { type: 'leaf' as const, size: 400, data: second }] } };
+		const landed = ritemarkHomeInFront(grid);
+		const noHome = ritemarkHomeInFront({ ...grid, root: { type: 'leaf' as const, size: 400, data: second } });
+		assert.deepStrictEqual({ landed, noHome: noHome.homeGroup, savedUnchanged: first.mru }, {
+			landed: { grid: { ...grid, root: { ...grid.root, data: [{ type: 'leaf', size: 400, data: { ...first, mru: [0, 2, 1] } }, { type: 'leaf', size: 400, data: second }] } }, homeGroup: 1 },
+			noHome: undefined,
+			savedUnchanged: [2, 1, 0],
+		});
+	});
+
+	test('#569: the note is written with the last save of a switch that goes on, never after a veto or for a reload', async () => {
+		const beforeShutdown = store.add(new Emitter<BeforeShutdownEvent>());
+		const shutdownVeto = store.add(new Emitter<void>());
+		const dialogs = store.add(new Emitter<void>());
+		const storage = store.add(new TestStorageService());
+		const lifecycle = { onBeforeShutdown: beforeShutdown.event, onShutdownVeto: shutdownVeto.event } as unknown as ILifecycleService;
+		const workspace = { getWorkbenchState: () => WorkbenchState.FOLDER, getWorkspace: () => ({ folders: [{ uri: URI.file('/p/lead') }] }) } as unknown as IWorkspaceContextService;
+		store.add(new RitemarkSwitchGuard(lifecycle, commands(async () => false), { onWillShowDialog: dialogs.event } as unknown as IDialogService, storage, workspace));
+		const unload = async (reason: ShutdownReason) => {
+			const vetos: Promise<boolean>[] = [];
+			beforeShutdown.fire({ reason, veto: value => vetos.push(Promise.resolve(value)) });
+			await Promise.all(vetos);
+		};
+		const note = () => storage.get('ritemark.switch.landOnHome', StorageScope.APPLICATION);
+
+		await unload(ShutdownReason.LOAD); // Ritemark lets it go on, then another participant vetoes it (unsaved files)
+		shutdownVeto.fire();
+		storage.testEmitWillSaveState(WillSaveStateReason.SHUTDOWN); // a later quit
+		const afterVeto = note();
+		await unload(ShutdownReason.RELOAD);
+		storage.testEmitWillSaveState(WillSaveStateReason.SHUTDOWN);
+		const afterReload = note();
+		await unload(ShutdownReason.LOAD);
+		const beforeTheLastSave = note();
+		storage.testEmitWillSaveState(WillSaveStateReason.SHUTDOWN);
+		const written = JSON.parse(note() ?? '{}');
+
+		assert.deepStrictEqual({ afterVeto, afterReload, beforeTheLastSave, from: written.from, target: written.target, dated: typeof written.at === 'number' }, {
+			afterVeto: undefined,
+			afterReload: undefined,
+			beforeTheLastSave: undefined,
+			from: URI.file('/p/lead').toString(),
+			target: null,
+			dated: true,
+		});
+	});
+
+	test('#569: Ritemark\'s answer that comes after another participant vetoed the switch sets no note', async () => {
+		const beforeShutdown = store.add(new Emitter<BeforeShutdownEvent>());
+		const shutdownVeto = store.add(new Emitter<void>());
+		const dialogs = store.add(new Emitter<void>());
+		const storage = store.add(new TestStorageService());
+		const lifecycle = { onBeforeShutdown: beforeShutdown.event, onShutdownVeto: shutdownVeto.event } as unknown as ILifecycleService;
+		const workspace = { getWorkbenchState: () => WorkbenchState.FOLDER, getWorkspace: () => ({ folders: [{ uri: URI.file('/p/lead') }] }) } as unknown as IWorkspaceContextService;
+		let answer!: (veto: boolean) => void;
+		store.add(new RitemarkSwitchGuard(lifecycle, commands(() => new Promise<boolean>(resolve => answer = resolve)), { onWillShowDialog: dialogs.event } as unknown as IDialogService, storage, workspace));
+		const vetos: Promise<boolean>[] = [];
+
+		beforeShutdown.fire({ reason: ShutdownReason.LOAD, veto: value => vetos.push(Promise.resolve(value)) });
+		shutdownVeto.fire(); // another participant's veto ended the switch before Ritemark answered
+		answer(false);
+		await Promise.all(vetos);
+		storage.testEmitWillSaveState(WillSaveStateReason.SHUTDOWN); // a later quit
+
+		assert.strictEqual(storage.get('ritemark.switch.landOnHome', StorageScope.APPLICATION), undefined);
+	});
+});
