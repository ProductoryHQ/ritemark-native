+.monaco-workbench .monaco-list .monaco-list-row:hover .label-extension,
+.monaco-workbench .monaco-icon-label[class*="monaco-decoration-itemColor-"] .label-extension,
+.monaco-workbench.hc-black .label-extension,
+.monaco-workbench.hc-light .label-extension {
+	color: inherit;
+}
+
+.monaco-workbench:not(.hc-black):not(.hc-light) .tabs-container > .tab.active .monaco-icon-label:not([class*="monaco-decoration-itemColor-"]) .label-extension,
+.monaco-workbench:not(.hc-black):not(.hc-light) .monaco-list .monaco-list-row.selected .monaco-icon-label:not([class*="monaco-decoration-itemColor-"]) .label-extension {
+	color: var(--rm-body);
+}
