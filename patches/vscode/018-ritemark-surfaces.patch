+.monaco-workbench:not(.hc-black):not(.hc-light) .part.statusbar,
+.monaco-workbench:not(.hc-black):not(.hc-light) .part.sidebar,
+.monaco-workbench:not(.hc-black):not(.hc-light) .part.auxiliarybar,
+.monaco-workbench:not(.hc-black):not(.hc-light) .part.sidebar .pane-header,
+.monaco-workbench:not(.hc-black):not(.hc-light) .part.editor .editor-group-container > .title,
