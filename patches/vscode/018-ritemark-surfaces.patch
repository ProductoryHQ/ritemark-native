@@ -0,0 +1,181 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { timeout } from '../../../../base/common/async.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { IRitemarkFeedbackSheetSpec, IRitemarkFeedbackSubmit, RitemarkFeedbackSubmitResult, ritemarkFeedbackKey, ritemarkFeedbackRoute, showRitemarkFeedbackSheet } from '../../../browser/parts/ritemarkFeedbackSheet.js';
+
+/**
+ * Ritemark 2.1 (Sprint 140, R11–R13; S51–S58): the feedback sheet's route words change with its boxes, its keys,
+ * and what it does after pressing: it closes when the message was accepted, stays with one line when it did not go,
+ * and hands over to the e-mail app with Copy and Done.
+ */
+suite('Ritemark feedback sheet', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const words: IRitemarkFeedbackSheetSpec['words'] = {
+		sheet: {
+			feedback: { title: 'Send feedback', lede: 'What worked…', placeholder: '' },
+			aiIssue: { title: 'Report an AI issue', lede: 'Tell us…', placeholder: 'What happened?' },
+			aiBox: 'This is about something the AI said or did',
+			answerBox: 'I\'d like an answer',
+			answerNote: 'This opens your e-mail app instead…',
+			lastAnswerBox: 'Add the AI\'s last answer in this chat',
+			lastAnswerNoteBefore: 'Only that answer, from "',
+			lastAnswerNoteAfter: '". You see it here before it\'s sent.',
+			shortenedNote: 'Shortened to fit an e-mail. Copy takes the whole answer.',
+			straight: { button: 'Send', foot: 'Your documents and chats are never included.' },
+			email: { button: 'Open in e-mail', foot: 'Only what you see here goes.', via: 'This opens your e-mail app…' },
+			cancel: 'Cancel',
+			sending: 'Sending…',
+			failed: 'It didn\'t go. Your message is still here: try again, or open it in e-mail.',
+			tryAgain: 'Try again',
+			openInEmail: 'Open in e-mail',
+		},
+		handoff: {
+			opened: { title: 'Your e-mail app is opening', report: 'Your report is in a new e-mail…', message: 'Your message is in a new e-mail…' },
+			noHandler: { title: 'No e-mail app answered', lede: 'Copy it…' },
+			tooLong: { title: 'This is too long for an e-mail link', lede: 'Copy it…' },
+			foot: 'Didn\'t open? Copy it and send it to info@productory.eu.',
+			copy: 'Copy',
+			copied: 'Copied',
+			done: 'Done',
+		},
+		hints: { cancel: 'Closes this', send: 'Sends it', openInEmail: 'Opens your e-mail app', tryAgain: 'Sends it again', writeFirst: 'Write something first', copy: 'Copies it', done: 'Closes this' },
+	};
+
+	function open(spec: Partial<IRitemarkFeedbackSheetSpec>, submit: (request: IRitemarkFeedbackSubmit) => Promise<RitemarkFeedbackSubmitResult>) {
+		const container = mainWindow.document.createElement('div');
+		mainWindow.document.body.appendChild(container);
+		const copied: string[] = [];
+		const hints = new Map<HTMLElement, () => string>();
+		const outcome = showRitemarkFeedbackSheet(container, { token: 't', kind: 'feedback', aiIssue: false, lastAnswer: null, words, ...spec }, { submit, copy: async text => { copied.push(text); }, mac: true, hint: (element, content) => { hints.set(element, content); return { dispose: () => hints.delete(element) }; } });
+		const $ = <T extends HTMLElement>(selector: string) => container.querySelector<T>(selector)!;
+		const visible = (selector: string) => [...container.querySelectorAll<HTMLElement>(selector)].filter(element => !element.closest('[hidden]')).map(element => element.textContent);
+		const type = (text: string) => {
+			const area = $<HTMLTextAreaElement>('.ritemark-feedback-area');
+			area.value = text;
+			area.dispatchEvent(new Event('input'));
+		};
+		const tick = (index: number) => {
+			const input = [...container.querySelectorAll<HTMLInputElement>('.ritemark-feedback-check input')][index];
+			input.checked = !input.checked;
+			input.dispatchEvent(new Event('change'));
+		};
+		const hint = (element: HTMLElement) => hints.get(element)?.();
+		return { container, outcome, copied, $, visible, type, tick, hint, dispose: () => container.remove() };
+	}
+
+	test('the route follows the boxes, and the keys', () => {
+		assert.deepStrictEqual(
+			[ritemarkFeedbackRoute(false, false), ritemarkFeedbackRoute(true, false), ritemarkFeedbackRoute(false, true)],
+			['straight', 'email', 'email']);
+		const key = (key: string, mods: { metaKey?: boolean; ctrlKey?: boolean } = {}) => ({ key, metaKey: false, ctrlKey: false, altKey: false, shiftKey: false, ...mods });
+		assert.deepStrictEqual(
+			[ritemarkFeedbackKey(key('Enter'), true), ritemarkFeedbackKey(key('Enter', { metaKey: true }), true), ritemarkFeedbackKey(key('Enter', { ctrlKey: true }), false), ritemarkFeedbackKey(key('Enter', { metaKey: true }), false), ritemarkFeedbackKey(key('Escape'), false)],
+			[undefined, 'submit', 'submit', undefined, 'cancel']);
+	});
+
+	test('the words change live with the boxes; Send is off until something is typed', async () => {
+		const sheet = open({}, async () => ({ route: 'straight', outcome: 'accepted' }));
+		const button = () => sheet.$<HTMLButtonElement>('.ritemark-feedback-button.primary');
+		assert.deepStrictEqual([button().textContent, button().disabled, sheet.$('.ritemark-feedback-foot-note').textContent, sheet.$('.ritemark-feedback-via').hidden], ['Send', true, 'Your documents and chats are never included.', true]);
+		assert.deepStrictEqual([sheet.hint(button()), sheet.hint(sheet.$('.ritemark-feedback-button.ghost'))], ['Write something first', 'Closes this'], 'a disabled Send says why; every button has a hint');
+		sheet.type('The comments in the margin are great.');
+		assert.strictEqual(sheet.hint(button()), 'Sends it');
+		sheet.tick(1); // I'd like an answer
+		assert.strictEqual(sheet.hint(button()), 'Opens your e-mail app');
+		assert.deepStrictEqual([button().textContent, button().disabled, sheet.$('.ritemark-feedback-foot-note').textContent, sheet.$('.ritemark-feedback-via').hidden], ['Open in e-mail', false, 'Only what you see here goes.', false]);
+		sheet.$<HTMLButtonElement>('.ritemark-feedback-button.ghost').click(); // Cancel
+		assert.strictEqual(await sheet.outcome, 'cancelled');
+		sheet.dispose();
+	});
+
+	test('a modal sheet: named for screen readers, focus kept inside, Escape closes', async () => {
+		const sheet = open({}, async () => null);
+		const dialog = sheet.$('.ritemark-feedback-sheet');
+		assert.deepStrictEqual([dialog.getAttribute('role'), dialog.getAttribute('aria-modal'), sheet.$(`#${dialog.getAttribute('aria-labelledby')}`)?.textContent], ['dialog', 'true', 'Send feedback']);
+		assert.strictEqual(mainWindow.document.activeElement, sheet.$('.ritemark-feedback-area'), 'the message field has focus');
+		const outside = mainWindow.document.body.appendChild(mainWindow.document.createElement('button'));
+		outside.focus();
+		// The test window may not have the system's focus, and then Chromium sends no focus events: send the one a person's click would
+		sheet.$('.ritemark-feedback-area').dispatchEvent(new FocusEvent('focusout', { bubbles: true, relatedTarget: outside }));
+		await timeout(10);
+		assert.ok(dialog.contains(mainWindow.document.activeElement), 'focus came back into the sheet');
+		outside.remove();
+		sheet.$('.ritemark-feedback-area').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+		assert.strictEqual(await sheet.outcome, 'cancelled');
+		sheet.dispose();
+	});
+
+	test('an AI issue: the box ticked, the last answer\'s box in place of the answer\'s, its quote shown when ticked', async () => {
+		const sheet = open({ kind: 'ai-issue', aiIssue: true, lastAnswer: { chatTitle: 'Tighten Module 3', quote: 'It said… [shortened]', shortened: true } }, async () => null);
+		assert.deepStrictEqual(sheet.visible('.ritemark-feedback-check > .ritemark-feedback-check-words > span:first-child'), ['This is about something the AI said or did', 'Add the AI\'s last answer in this chat']);
+		assert.strictEqual(sheet.$('.ritemark-feedback-quote').hidden, true, 'off by default');
+		sheet.tick(1);
+		assert.strictEqual(sheet.$('.ritemark-feedback-quote').hidden, false);
+		assert.ok(sheet.$('.ritemark-feedback-quote').textContent!.includes('Shortened to fit an e-mail.'));
+		sheet.$<HTMLButtonElement>('.ritemark-feedback-button.ghost').click();
+		await sheet.outcome;
+		sheet.dispose();
+	});
+
+	test('after pressing: closed when accepted, one line when it did not go, the hand-off for the e-mail route', async () => {
+		const accepted = open({}, async () => ({ route: 'straight', outcome: 'accepted' }));
+		accepted.type('Nice.');
+		accepted.$<HTMLButtonElement>('.ritemark-feedback-button.primary').click();
+		assert.strictEqual(await accepted.outcome, 'sent');
+		assert.strictEqual(accepted.container.querySelector('.ritemark-feedback-sheet'), null, 'the sheet closed');
+		accepted.dispose();
+
+		const offline = open({}, async () => ({ route: 'straight', outcome: 'failed' }));
+		offline.type('Nice.');
+		offline.$<HTMLButtonElement>('.ritemark-feedback-button.primary').click();
+		await timeout(0);
+		assert.deepStrictEqual(offline.visible('.ritemark-feedback-problem'), ['It didn\'t go. Your message is still here: try again, or open it in e-mail.']);
+		assert.deepStrictEqual(offline.visible('.ritemark-feedback-button'), ['Cancel', 'Open in e-mail', 'Try again'], 'D5: Try again and Open in e-mail');
+		assert.ok(offline.$('.ritemark-feedback-foot').classList.contains('stacked'), 'three buttons: the note on its own line');
+		assert.strictEqual(offline.$<HTMLTextAreaElement>('.ritemark-feedback-area').value, 'Nice.', 'the message is still there');
+
+		const requests: IRitemarkFeedbackSubmit[] = [];
+		const mail = open({}, async request => {
+			requests.push(request);
+			return { route: 'email', outcome: 'opened', kindLabel: 'Send feedback', shown: 'Please write back.', copyText: 'the whole e-mail' };
+		});
+		mail.type('Please write back.');
+		mail.tick(1);
+		mail.$<HTMLButtonElement>('.ritemark-feedback-button.primary').click();
+		await timeout(0);
+		assert.deepStrictEqual(requests.map(request => request.route), ['email']);
+		assert.strictEqual(mail.$('.ritemark-feedback-title').textContent, 'Your e-mail app is opening');
+		assert.ok(!/\bsent\b/i.test(mail.$('.ritemark-feedback-sheet').textContent!), 'never "sent" when only an e-mail app opened');
+		const [copy, done] = [...mail.container.querySelectorAll<HTMLButtonElement>('.ritemark-feedback-button')];
+		copy.click();
+		await timeout(0);
+		assert.deepStrictEqual(mail.copied, ['the whole e-mail']);
+		assert.strictEqual(mail.$('.ritemark-feedback-foot-note').textContent, 'Didn\'t open? Copy it and send it to info@productory.eu.');
+		done.click();
+		assert.strictEqual(await mail.outcome, 'mailed');
+		mail.dispose();
+
+		const tooLong = open({}, async () => ({ route: 'email', outcome: 'too-long', kindLabel: 'Send feedback', shown: 'Long.', copyText: 'Long.' }));
+		tooLong.type('Long.');
+		tooLong.tick(1);
+		tooLong.$<HTMLButtonElement>('.ritemark-feedback-button.primary').click();
+		await timeout(0);
+		assert.strictEqual(tooLong.$('.ritemark-feedback-title').textContent, 'This is too long for an e-mail link');
+		assert.strictEqual(tooLong.$('.ritemark-feedback-foot-note').textContent, '', 'no "Didn\'t open?" when nothing was asked to open');
+		[...tooLong.container.querySelectorAll<HTMLButtonElement>('.ritemark-feedback-button')].at(-1)!.click();
+		assert.strictEqual(await tooLong.outcome, 'mailed');
+		tooLong.dispose();
+
+		offline.$<HTMLButtonElement>('.ritemark-feedback-button.ghost').click();
+		await offline.outcome;
+		offline.dispose();
+	});
+});
