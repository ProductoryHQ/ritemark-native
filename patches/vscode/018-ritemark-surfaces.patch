@@ -0,0 +1,394 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Ritemark 2.1 (Sprint 140, R11–R13; experience 34, frames 2, 3 and 5): the feedback sheet over the whole window, in
+ * experience 31's dialog style (440 wide, the window dimmed behind it). The extension opens it with the hidden command
+ * `_ritemark.feedbackSheet` and gives every word, so the words can change without an app release; the sheet asks the
+ * extension's `_ritemark.feedback.submit` to send (the straight route) or to open the person's e-mail app (either box
+ * ticked), and shows what happened: it closes when the message was accepted, stays with one line when it did not go,
+ * and turns into frame 5's hand-off when an e-mail app was asked to open, with Copy and Done. Never "sent" when only
+ * an e-mail app opened.
+ *
+ * Keys: Enter makes a new line, ⌘Enter (Ctrl+Enter on Windows) presses the sheet's button, Escape closes it and sends
+ * nothing; Tab stays inside the sheet. The command resolves with what happened: sent, mailed or cancelled.
+ */
+
+import './media/ritemarkFeedbackSheet.css';
+import { $, addDisposableListener, append, EventType } from '../../../base/browser/dom.js';
+import { getDefaultHoverDelegate } from '../../../base/browser/ui/hover/hoverDelegateFactory.js';
+import { Event } from '../../../base/common/event.js';
+import { DisposableStore, IDisposable } from '../../../base/common/lifecycle.js';
+import { isMacintosh } from '../../../base/common/platform.js';
+import Severity from '../../../base/common/severity.js';
+import { IClipboardService } from '../../../platform/clipboard/common/clipboardService.js';
+import { CommandsRegistry, ICommandService } from '../../../platform/commands/common/commands.js';
+import { IHoverService } from '../../../platform/hover/browser/hover.js';
+import { ILayoutService } from '../../../platform/layout/browser/layoutService.js';
+import { INotificationService } from '../../../platform/notification/common/notification.js';
+
+const SHEET_COMMAND = '_ritemark.feedbackSheet';
+const SUBMIT_COMMAND = '_ritemark.feedback.submit';
+const BRIEF_TOAST_COMMAND = '_ritemark.briefToast';
+
+/** How long a brief toast stays: the thank-you goes by itself after a few seconds (experience 35, The build checked). */
+export const RITEMARK_BRIEF_TOAST_MS = 4000;
+
+/** The words the extension gives (its `feedbackCopy.ts`); only what the sheet draws is listed. */
+export interface IRitemarkFeedbackWords {
+	readonly sheet: {
+		readonly feedback: { readonly title: string; readonly lede: string; readonly placeholder: string };
+		readonly aiIssue: { readonly title: string; readonly lede: string; readonly placeholder: string };
+		readonly aiBox: string;
+		readonly answerBox: string;
+		readonly answerNote: string;
+		readonly lastAnswerBox: string;
+		readonly lastAnswerNoteBefore: string;
+		readonly lastAnswerNoteAfter: string;
+		readonly shortenedNote: string;
+		readonly straight: { readonly button: string; readonly foot: string };
+		readonly email: { readonly button: string; readonly foot: string; readonly via: string };
+		readonly cancel: string;
+		readonly sending: string;
+		readonly failed: string;
+		readonly tryAgain: string;
+		readonly openInEmail: string;
+	};
+	readonly handoff: {
+		readonly opened: { readonly title: string; readonly report: string; readonly message: string };
+		readonly noHandler: { readonly title: string; readonly lede: string };
+		readonly tooLong: { readonly title: string; readonly lede: string };
+		readonly foot: string;
+		readonly copy: string;
+		readonly copied: string;
+		readonly done: string;
+	};
+	/** Each button's hover hint, and why Send waits; absent from an extension older than 2.1's QA, which draws none. */
+	readonly hints?: {
+		readonly cancel: string;
+		readonly send: string;
+		readonly openInEmail: string;
+		readonly tryAgain: string;
+		readonly writeFirst: string;
+		readonly copy: string;
+		readonly done: string;
+	};
+}
+
+export interface IRitemarkFeedbackSheetSpec {
+	readonly token: string;
+	readonly kind: 'feedback' | 'ai-issue';
+	readonly aiIssue: boolean;
+	readonly lastAnswer: { readonly chatTitle: string; readonly quote: string; readonly shortened: boolean } | null;
+	readonly words: IRitemarkFeedbackWords;
+}
+
+export interface IRitemarkFeedbackSubmit {
+	readonly token: string;
+	readonly route: 'straight' | 'email';
+	readonly text: string;
+	readonly aiIssue: boolean;
+	readonly wantAnswer: boolean;
+	readonly withAnswer: boolean;
+}
+
+export type RitemarkFeedbackSubmitResult =
+	| { readonly route: 'straight'; readonly outcome: 'accepted' | 'failed' }
+	| { readonly route: 'email'; readonly outcome: 'opened' | 'no-handler' | 'too-long' | 'invalid'; readonly kindLabel: string; readonly shown: string; readonly copyText: string }
+	| null | undefined;
+
+export type RitemarkFeedbackSheetOutcome = 'sent' | 'mailed' | 'cancelled';
+
+/** Either box ticked goes through the person's own e-mail app (R11). */
+export function ritemarkFeedbackRoute(aiIssue: boolean, wantAnswer: boolean): 'straight' | 'email' {
+	return aiIssue || wantAnswer ? 'email' : 'straight';
+}
+
+/** ⌘Enter on the Mac and Ctrl+Enter elsewhere press the sheet's button; Escape closes it; plain Enter is a new line. */
+export function ritemarkFeedbackKey(event: { readonly key: string; readonly metaKey: boolean; readonly ctrlKey: boolean; readonly altKey: boolean; readonly shiftKey: boolean }, mac: boolean): 'submit' | 'cancel' | undefined {
+	if (event.key === 'Escape') {
+		return 'cancel';
+	}
+	if (event.key === 'Enter' && !event.altKey && !event.shiftKey && (mac ? event.metaKey && !event.ctrlKey : event.ctrlKey && !event.metaKey)) {
+		return 'submit';
+	}
+	return undefined;
+}
+
+interface ISheetDeps {
+	submit(request: IRitemarkFeedbackSubmit): Promise<RitemarkFeedbackSubmitResult>;
+	copy(text: string): Promise<void>;
+	readonly mac: boolean;
+	/** A hover hint on a button (the workbench's hover service); its words are read when the hover shows. */
+	hint?(element: HTMLElement, content: () => string): IDisposable;
+}
+
+function button(parent: HTMLElement, label: string, kind: 'primary' | 'ghost'): HTMLButtonElement {
+	const element = append(parent, $(`button.ritemark-feedback-button.${kind}`)) as HTMLButtonElement;
+	element.type = 'button';
+	element.textContent = label;
+	return element;
+}
+
+function box(parent: HTMLElement, label: string, note: string | undefined): { row: HTMLElement; input: HTMLInputElement } {
+	const row = append(parent, $('label.ritemark-feedback-check'));
+	const input = append(row, $('input')) as HTMLInputElement;
+	input.type = 'checkbox';
+	const words = append(row, $('span.ritemark-feedback-check-words'));
+	append(words, $('span')).textContent = label;
+	if (note) {
+		append(words, $('span.ritemark-feedback-check-note')).textContent = note;
+	}
+	return { row, input };
+}
+
+/** Draw the sheet in `container` and resolve with what happened once it closes. */
+export function showRitemarkFeedbackSheet(container: HTMLElement, spec: IRitemarkFeedbackSheetSpec, deps: ISheetDeps): Promise<RitemarkFeedbackSheetOutcome> {
+	const words = spec.words;
+	const store = new DisposableStore();
+	const previouslyFocused = container.ownerDocument.activeElement as HTMLElement | null;
+	const block = append(container, $('.monaco-dialog-modal-block.dimmed.ritemark-feedback-block'));
+	const sheet = append(block, $('.ritemark-feedback-sheet'));
+	sheet.setAttribute('role', 'dialog');
+	sheet.setAttribute('aria-modal', 'true');
+	sheet.setAttribute('aria-labelledby', 'ritemark-feedback-title');
+	sheet.setAttribute('aria-describedby', 'ritemark-feedback-lede');
+
+	return new Promise<RitemarkFeedbackSheetOutcome>(resolve => {
+		let closed = false;
+		const close = (outcome: RitemarkFeedbackSheetOutcome) => {
+			if (closed) {
+				return;
+			}
+			closed = true;
+			store.dispose();
+			block.remove();
+			previouslyFocused?.focus?.();
+			resolve(outcome);
+		};
+
+		// ── The message: frames 2 and 3 ──
+		const kindWords = spec.kind === 'ai-issue' ? words.sheet.aiIssue : words.sheet.feedback;
+		const title = append(sheet, $('h3#ritemark-feedback-title.ritemark-feedback-title'));
+		title.textContent = kindWords.title;
+		const lede = append(sheet, $('p#ritemark-feedback-lede.ritemark-feedback-lede'));
+		lede.textContent = kindWords.lede;
+		const area = append(sheet, $('textarea.ritemark-feedback-area')) as HTMLTextAreaElement;
+		area.placeholder = kindWords.placeholder;
+		area.setAttribute('aria-label', kindWords.title);
+		area.maxLength = 8000;
+		const ai = box(sheet, words.sheet.aiBox, undefined);
+		ai.input.checked = spec.aiIssue;
+		const last = spec.lastAnswer ? box(sheet, words.sheet.lastAnswerBox, `${words.sheet.lastAnswerNoteBefore}${spec.lastAnswer.chatTitle}${words.sheet.lastAnswerNoteAfter}`) : undefined;
+		const quote = spec.lastAnswer ? append(sheet, $('.ritemark-feedback-quote')) : undefined;
+		if (quote && spec.lastAnswer) {
+			append(quote, $('.ritemark-feedback-quote-text')).textContent = spec.lastAnswer.quote;
+			if (spec.lastAnswer.shortened) {
+				append(quote, $('.ritemark-feedback-quote-note')).textContent = words.sheet.shortenedNote;
+			}
+		}
+		const answer = box(sheet, words.sheet.answerBox, words.sheet.answerNote);
+		const via = append(sheet, $('.ritemark-feedback-via'));
+		append(via, $('span.codicon.codicon-mail'));
+		append(via, $('span')).textContent = words.sheet.email.via;
+		const problem = append(sheet, $('p.ritemark-feedback-problem'));
+		problem.setAttribute('role', 'alert');
+		const foot = append(sheet, $('.ritemark-feedback-foot'));
+		const footNote = append(foot, $('span.ritemark-feedback-foot-note'));
+		const cancel = button(foot, words.sheet.cancel, 'ghost');
+		const toEmail = button(foot, words.sheet.openInEmail, 'ghost');
+		const primary = button(foot, words.sheet.straight.button, 'primary');
+
+		let sending = false;
+		let failed = false;
+		const route = () => ritemarkFeedbackRoute(ai.input.checked, answer.input.checked);
+		// Each button says what it does on hover, and a disabled Send says why it waits (QA, 26 October)
+		const hints = words.hints;
+		if (hints && deps.hint) {
+			store.add(deps.hint(cancel, () => hints.cancel));
+			store.add(deps.hint(toEmail, () => area.value.trim() ? hints.openInEmail : hints.writeFirst));
+			store.add(deps.hint(primary, () => !area.value.trim() ? hints.writeFirst : route() === 'email' ? hints.openInEmail : failed ? hints.tryAgain : hints.send));
+		}
+		/** The route's words, live as the boxes change (R11, R12; experience 34 frame 3: the AI box puts the last answer's box where "I'd like an answer" was). */
+		const update = () => {
+			const email = route() === 'email';
+			const empty = area.value.trim().length === 0;
+			answer.row.hidden = ai.input.checked;
+			if (last && quote) {
+				last.row.hidden = !ai.input.checked;
+				quote.hidden = !(ai.input.checked && last.input.checked);
+			}
+			via.hidden = !email;
+			footNote.textContent = email ? words.sheet.email.foot : words.sheet.straight.foot;
+			problem.hidden = !failed;
+			problem.textContent = failed ? words.sheet.failed : '';
+			toEmail.hidden = !failed || email;
+			foot.classList.toggle('stacked', !toEmail.hidden); // three buttons: the note takes its own line, the buttons stay on one
+			primary.textContent = sending ? words.sheet.sending : email ? words.sheet.email.button : failed ? words.sheet.tryAgain : words.sheet.straight.button;
+			primary.disabled = empty || sending;
+			toEmail.disabled = empty || sending;
+			for (const input of [area, ai.input, answer.input, last?.input]) {
+				if (input) {
+					input.disabled = sending;
+				}
+			}
+		};
+
+		// ── After pressing: frames 4 and 5 ──
+		const handOff = (result: Extract<RitemarkFeedbackSubmitResult, { route: 'email' }>) => {
+			const outcome = result.outcome === 'opened' ? words.handoff.opened : result.outcome === 'too-long' ? words.handoff.tooLong : words.handoff.noHandler;
+			sheet.textContent = '';
+			sheet.classList.add('handoff');
+			append(sheet, $('h3#ritemark-feedback-title.ritemark-feedback-title')).textContent = outcome.title;
+			append(sheet, $('p#ritemark-feedback-lede.ritemark-feedback-lede')).textContent = result.outcome === 'opened'
+				? (spec.kind === 'ai-issue' || ai.input.checked ? words.handoff.opened.report : words.handoff.opened.message)
+				: (outcome as { lede: string }).lede;
+			const shown = append(sheet, $('.ritemark-feedback-quote'));
+			append(shown, $('b')).textContent = result.kindLabel;
+			append(shown, $('.ritemark-feedback-quote-text')).textContent = result.shown;
+			const handoffFoot = append(sheet, $('.ritemark-feedback-foot'));
+			// "Didn't open? …" only after an e-mail app was asked to open; too long or no e-mail app already says so above
+			append(handoffFoot, $('span.ritemark-feedback-foot-note')).textContent = result.outcome === 'opened' ? words.handoff.foot : '';
+			const copy = button(handoffFoot, words.handoff.copy, 'ghost');
+			copy.prepend($('span.codicon.codicon-copy'));
+			const done = button(handoffFoot, words.handoff.done, 'primary');
+			if (hints && deps.hint) {
+				store.add(deps.hint(copy, () => hints.copy));
+				store.add(deps.hint(done, () => hints.done));
+			}
+			store.add(addDisposableListener(copy, EventType.CLICK, async () => {
+				await deps.copy(result.copyText);
+				copy.lastChild!.textContent = words.handoff.copied;
+				setTimeout(() => {
+					if (copy.isConnected) {
+						copy.lastChild!.textContent = words.handoff.copy;
+					}
+				}, 2000);
+			}));
+			store.add(addDisposableListener(done, EventType.CLICK, () => close('mailed')));
+			done.focus();
+		};
+
+		const submit = async (forceEmail: boolean) => {
+			const text = area.value.trim();
+			if (!text || sending) {
+				return;
+			}
+			const chosen = forceEmail ? 'email' : route();
+			sending = chosen === 'straight';
+			update();
+			const result = await deps.submit({ token: spec.token, route: chosen, text, aiIssue: ai.input.checked, wantAnswer: answer.input.checked, withAnswer: Boolean(last?.input.checked && ai.input.checked) });
+			sending = false;
+			if (closed) {
+				return;
+			}
+			if (result?.route === 'straight') {
+				if (result.outcome === 'accepted') {
+					close('sent');
+					return;
+				}
+				failed = true; // D5: the sheet stays with the message, one line, and the e-mail route
+				update();
+				primary.focus();
+				return;
+			}
+			if (result?.route === 'email' && result.outcome !== 'invalid') {
+				handOff(result);
+				return;
+			}
+			failed = true;
+			update();
+		};
+
+		store.add(addDisposableListener(area, EventType.INPUT, () => update()));
+		for (const input of [ai.input, answer.input, last?.input]) {
+			if (input) {
+				store.add(addDisposableListener(input, EventType.CHANGE, () => update()));
+			}
+		}
+		store.add(addDisposableListener(cancel, EventType.CLICK, () => close('cancelled')));
+		store.add(addDisposableListener(primary, EventType.CLICK, () => void submit(false)));
+		store.add(addDisposableListener(toEmail, EventType.CLICK, () => void submit(true)));
+		store.add(addDisposableListener(sheet, EventType.KEY_DOWN, (event: KeyboardEvent) => {
+			const action = ritemarkFeedbackKey(event, deps.mac);
+			if (action === 'cancel') {
+				event.preventDefault();
+				event.stopPropagation();
+				close(sheet.classList.contains('handoff') ? 'mailed' : 'cancelled');
+			} else if (action === 'submit' && !sheet.classList.contains('handoff')) {
+				event.preventDefault();
+				event.stopPropagation();
+				void submit(false);
+			} else if (event.key === 'Tab') {
+				// Tab stays in the sheet
+				const focusable = [...sheet.querySelectorAll<HTMLElement>('textarea, input, button')].filter(element => !element.hidden && !(element as HTMLButtonElement).disabled && element.offsetParent !== null);
+				const first = focusable[0];
+				const lastFocusable = focusable[focusable.length - 1];
+				const active = sheet.ownerDocument.activeElement;
+				if (event.shiftKey && active === first) {
+					event.preventDefault();
+					lastFocusable?.focus();
+				} else if (!event.shiftKey && active === lastFocusable) {
+					event.preventDefault();
+					first?.focus();
+				}
+			}
+			// A modal sheet: the workbench's own shortcuts wait until it closes (typing keeps its default)
+			event.stopPropagation();
+		}));
+		// Focus stays inside the sheet while it is open: anything that takes it elsewhere in the window gives it back
+		store.add(addDisposableListener(sheet, EventType.FOCUS_OUT, (event: FocusEvent) => {
+			const next = event.relatedTarget as Node | null;
+			if (next && sheet.contains(next)) {
+				return;
+			}
+			setTimeout(() => {
+				const active = sheet.ownerDocument.activeElement;
+				if (!closed && sheet.isConnected && !(active && sheet.contains(active))) {
+					const target = [...sheet.querySelectorAll<HTMLElement>('textarea, input, button')].find(element => !element.hidden && !(element as HTMLButtonElement).disabled && element.offsetParent !== null);
+					target?.focus();
+				}
+			}, 0);
+		}));
+		// A press on the dimmed window outside the sheet does nothing: Escape and Cancel close it (experience 31).
+		store.add(addDisposableListener(block, EventType.MOUSE_DOWN, (event: MouseEvent) => {
+			if (event.target === block) {
+				event.preventDefault();
+				area.focus();
+			}
+		}));
+
+		update();
+		area.focus();
+	});
+}
+
+CommandsRegistry.registerCommand(SHEET_COMMAND, (accessor, spec: IRitemarkFeedbackSheetSpec) => {
+	const layoutService = accessor.get(ILayoutService);
+	const commandService = accessor.get(ICommandService);
+	const clipboardService = accessor.get(IClipboardService);
+	const hoverService = accessor.get(IHoverService);
+	return showRitemarkFeedbackSheet(layoutService.activeContainer, spec, {
+		submit: request => commandService.executeCommand<RitemarkFeedbackSubmitResult>(SUBMIT_COMMAND, request),
+		copy: text => clipboardService.writeText(text),
+		mac: isMacintosh,
+		hint: (element, content) => hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), element, content),
+	});
+});
+
+/**
+ * A toast that says a thing happened and goes by itself (the feedback thank-you, 2.0's notification toast): an
+ * extension's information message stays until the window has focus and then for 10 s; this one closes after
+ * RITEMARK_BRIEF_TOAST_MS wherever it is. Resolves true when shown, so the extension knows to show nothing itself.
+ */
+CommandsRegistry.registerCommand(BRIEF_TOAST_COMMAND, (accessor, message: unknown) => {
+	if (typeof message !== 'string' || !message.trim()) {
+		return false;
+	}
+	const handle = accessor.get(INotificationService).notify({ severity: Severity.Info, message });
+	const timer = setTimeout(() => handle.close(), RITEMARK_BRIEF_TOAST_MS);
+	Event.once(handle.onDidClose)(() => clearTimeout(timer));
+	return true;
+});
