+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-via .codicon {
+	flex: none;
+	margin-top: 2px;
+	font-size: 14px;
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-problem {
+	margin: 14px 0 0;
+	color: var(--vscode-foreground);
+}
+
+.monaco-workbench .ritemark-feedback-sheet .ritemark-feedback-foot {
