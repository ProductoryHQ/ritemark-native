+
+import assert from 'assert';
+import { mainWindow } from '../../../../browser/window.js';
+import { unthemedButtonStyles } from '../../../../browser/ui/button/button.js';
+import { Dialog, IDialogOptions } from '../../../../browser/ui/dialog/dialog.js';
+import { unthemedInboxStyles } from '../../../../browser/ui/inputbox/inputBox.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../common/utils.js';
+
+/**
+ * Ritemark (Sprint 134, R9): a question whose action stops work (the switch question with no known folder) makes
+ * Cancel the default: it is focused when the dialog opens, so Enter cancels, and it is the button drawn as primary.
+ */
+suite('Ritemark dialog focus', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	const styles: Pick<IDialogOptions, 'buttonStyles' | 'checkboxStyles' | 'inputBoxStyles' | 'dialogStyles'> = {
+		buttonStyles: unthemedButtonStyles,
+		checkboxStyles: { checkboxBackground: undefined, checkboxBorder: undefined, checkboxForeground: undefined, checkboxDisabledBackground: undefined, checkboxDisabledForeground: undefined },
+		inputBoxStyles: unthemedInboxStyles,
+		dialogStyles: { dialogForeground: undefined, dialogBackground: undefined, dialogShadow: undefined, dialogBorder: undefined, errorIconForeground: undefined, warningIconForeground: undefined, infoIconForeground: undefined, textLinkForeground: undefined },
+	};
+
+	async function open(focusCancel: boolean) {
+		const container = mainWindow.document.createElement('div');
+		mainWindow.document.body.appendChild(container);
+		const dialog = store.add(new Dialog(container, 'Claude is still working in A', ['Switch and stop', 'Cancel'], { ...styles, cancelId: 1, ritemarkFocusCancel: focusCancel }));
+		const result = dialog.show();
+		await new Promise(resolve => setTimeout(resolve, 0));
+		const buttons = Array.from(container.querySelectorAll<HTMLElement>('.monaco-button'));
+		const focused = buttons.find(button => button === mainWindow.document.activeElement)?.textContent;
+		const primary = buttons.filter(button => !button.classList.contains('secondary')).map(button => button.textContent);
+		dialog.dispose();
+		await result.catch(() => undefined);
+		container.remove();
+		return { focused, primary };
+	}
+
+	test('upstream: the first action is the default', async () => {
+		assert.deepStrictEqual(await open(false), { focused: 'Switch and stop', primary: ['Switch and stop'] });
+	});
+
+	test('with ritemarkFocusCancel, Cancel is the default', async () => {
+		assert.deepStrictEqual(await open(true), { focused: 'Cancel', primary: ['Cancel'] });
+	});
+});
