+	}
+
+	/** One of the extension's menus, as a Ritemark menu under its anchor: a hairline between its groups. */
+	private showMenu(menuId: MenuId, anchor: HTMLElement, ariaLabel: string): void {
+		const folder = this.workspaceService.getWorkspace().folders[0]?.uri;
+		const entries: RitemarkMenuEntry[] = [];
+		for (const [, actions] of this.menuService.getMenuActions(menuId, this.contextKeyService, { shouldForwardArgs: true })) {
+			if (entries.length) {
+				entries.push(RITEMARK_MENU_SEPARATOR);
+			}
+			for (const action of actions) {
+				const icon = action instanceof MenuItemAction && ThemeIcon.isThemeIcon(action.item.icon) ? action.item.icon : undefined;
+				const flyout = action instanceof MenuItemAction ? FLYOUTS.get(action.item.id) : undefined;
+				entries.push({
+					label: action.label,
+					iconClassNames: icon ? ThemeIcon.asClassNameArray(icon) : [],
+					run: () => action.run(folder),
+					submenu: flyout ? () => this.flyoutRows(flyout) : undefined,
+				});
+			}
+		}
+		if (!entries.length) {
+			return;
+		}
+		anchor.setAttribute('aria-expanded', 'true');
+		showRitemarkMenu(this.contextViewService, anchor, { className: 'ritemark-project-menu', ariaLabel, align: 'left' }, entries, () => anchor.setAttribute('aria-expanded', 'false'));
+	}
+}
