+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { registerMainProcessRemoteService } from '../../../../platform/ipc/electron-browser/services.js';
+import { IRitemarkPrintService, isRitemarkPrintablePath, RITEMARK_PRINT_CHANNEL, RITEMARK_PRINT_COMMAND } from '../../../../platform/ritemarkPrint/common/ritemarkPrint.js';
+
+/**
+ * Ritemark (Sprint 170, #881): Save as PDF. The extension's way to the main process's print
+ * (`platform/ritemarkPrint`): one page's path in, its PDF's path out.
+ */
+registerMainProcessRemoteService(IRitemarkPrintService, RITEMARK_PRINT_CHANNEL);
+
+CommandsRegistry.registerCommand(RITEMARK_PRINT_COMMAND, (accessor, htmlPath: unknown): Promise<string> => {
+	if (!isRitemarkPrintablePath(htmlPath)) {
+		throw new Error('Ritemark print: not a page it can print');
+	}
+	return accessor.get(IRitemarkPrintService).printHtmlToPdf(htmlPath);
+});
