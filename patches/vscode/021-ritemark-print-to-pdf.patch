+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { BrowserWindow } from 'electron';
+import { promises as fs } from 'fs';
+import { tmpdir } from 'os';
+import { dirname } from 'path';
+import { Limiter, raceTimeout } from '../../../base/common/async.js';
+import { generateUuid } from '../../../base/common/uuid.js';
+import { ILogService } from '../../log/common/log.js';
+import { IRitemarkPrintService, isRitemarkPrintablePath, ritemarkPdfPathFor, ritemarkPrintAllows, ritemarkPrintFolderAllowed } from '../common/ritemarkPrint.js';
+
+/** How long a page may take to load, its fonts and pictures included, and to print. */
+const LOAD_MS = 30_000;
+const READY_MS = 10_000;
+const PRINT_MS = 60_000;
+
+/** Waits in the page for its fonts and every picture, so the PDF never holds a fallback font or an empty place. */
+const READY_SCRIPT = '(async () => { await document.fonts.ready; await Promise.all(Array.from(document.images, image => image.decode().catch(() => undefined))); return true; })()';
+
+/**
+ * Ritemark (Sprint 170, #881): Save as PDF's print, in the main process. One page at a time, in a hidden, sandboxed
+ * window with its own in-memory session that loads nothing but the page's own folder, refuses every permission,
+ * download, navigation and new window, and is closed when the print is done or has failed.
+ */
+export class RitemarkPrintMainService implements IRitemarkPrintService {
+	declare readonly _serviceBrand: undefined;
+
+	private readonly limiter = new Limiter<string>(1);
+
+	constructor(private readonly logService: ILogService) { }
+
+	printHtmlToPdf(htmlPath: string): Promise<string> {
+		return this.limiter.queue(() => this.print(htmlPath));
+	}
+
+	private async print(htmlPath: unknown): Promise<string> {
+		if (!isRitemarkPrintablePath(htmlPath)) {
+			throw new Error('Ritemark print: not a page it can print');
+		}
+		const info = await fs.lstat(htmlPath);
+		if (!info.isFile() || info.isSymbolicLink()) {
+			throw new Error('Ritemark print: the page is not a plain file');
+		}
+		const page = await fs.realpath(htmlPath);
+		const folder = dirname(page);
+		if (!ritemarkPrintFolderAllowed(folder, await fs.realpath(tmpdir()))) {
+			throw new Error('Ritemark print: the page is not in the temporary folder');
+		}
+		const pdfPath = ritemarkPdfPathFor(page);
+
+		const window = new BrowserWindow({
+			show: false,
+			width: 1280,
+			height: 900,
+			webPreferences: {
+				partition: `ritemark-print-${generateUuid()}`, // in memory, shared with nothing
+				sandbox: true,
+				nodeIntegration: false,
+				contextIsolation: true,
+				javascript: true,
+				webSecurity: true,
+				webgl: false,
+				spellcheck: false,
+				images: true,
+			}
+		});
+		try {
+			const contents = window.webContents;
+			const session = contents.session;
+			session.webRequest.onBeforeRequest((details, callback) => {
+				const allowed = ritemarkPrintAllows(details.url, folder);
+				if (!allowed) {
+					this.logService.trace('[Ritemark print] refused a load');
+				}
+				callback({ cancel: !allowed });
+			});
+			session.setPermissionRequestHandler((_contents, _permission, callback) => callback(false));
+			session.setPermissionCheckHandler(() => false);
+			session.on('will-download', event => event.preventDefault());
+			contents.setWindowOpenHandler(() => ({ action: 'deny' }));
+			contents.on('will-navigate', event => event.preventDefault());
+			contents.on('will-redirect', event => event.preventDefault());
+			contents.on('will-attach-webview', event => event.preventDefault());
+
+			const loaded = await raceTimeout(window.loadFile(page).then(() => true), LOAD_MS);
+			if (!loaded) {
+				throw new Error('Ritemark print: the page did not load in time');
+			}
+			await raceTimeout(contents.executeJavaScript(READY_SCRIPT, true).catch(() => false), READY_MS);
+			const data = await raceTimeout(contents.printToPDF({ pageSize: 'A4', landscape: false, preferCSSPageSize: true, printBackground: true }), PRINT_MS);
+			if (!data) {
+				throw new Error('Ritemark print: the print did not finish in time');
+			}
+			// A new file beside the page, never over one that is there.
+			await fs.writeFile(pdfPath, data, { flag: 'wx' });
+			return pdfPath;
+		} finally {
+			if (!window.isDestroyed()) {
+				window.destroy();
+			}
+		}
+	}
+}
