@@ -0,0 +1,88 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { isAbsolute, normalize, relative } from '../../../base/common/path.js';
+import { URI } from '../../../base/common/uri.js';
+import { createDecorator } from '../../instantiation/common/instantiation.js';
+
+/**
+ * Ritemark (Sprint 170, #881): Save as PDF. The extension builds a page as a file in a temporary folder of its own,
+ * beside the fonts and pictures it names, and the main process prints it with Electron's `printToPDF` in a hidden
+ * window, offline: nothing but `file:` addresses inside that folder loads. The PDF is written beside the page, with
+ * its name, and its path comes back; the extension then writes it where the person chose.
+ */
+export const RITEMARK_PRINT_CHANNEL = 'ritemarkPrint';
+
+/** The command the extension calls: one argument, the page's path; it answers the PDF's path. */
+export const RITEMARK_PRINT_COMMAND = '_ritemark.printHtmlToPdf';
+
+export const IRitemarkPrintService = createDecorator<IRitemarkPrintService>('ritemarkPrintService');
+
+export interface IRitemarkPrintService {
+	readonly _serviceBrand: undefined;
+	/** Print the page at `htmlPath` (an absolute `.html` path) to `<same folder>/<same name>.pdf`; that path is the answer. */
+	printHtmlToPdf(htmlPath: string): Promise<string>;
+}
+
+/** The PDF's path for a page: the same folder and name, `.pdf` for `.html`. */
+export function ritemarkPdfPathFor(htmlPath: string): string {
+	return htmlPath.replace(/\.html$/i, '.pdf');
+}
+
+/**
+ * Whether a request to print names a page the print may read: an absolute path (`/` on the Mac, a drive or `\\` on
+ * Windows) ending in `.html`, with no `.` or `..` part and no NUL. Whether the file is there and inside the system's
+ * temporary folder is the main process's own check.
+ */
+export function isRitemarkPrintablePath(htmlPath: unknown): htmlPath is string {
+	if (typeof htmlPath !== 'string' || htmlPath.length > 4096 || htmlPath.includes('\0')) {
+		return false;
+	}
+	if (!/\.html$/i.test(htmlPath)) {
+		return false;
+	}
+	const absolute = htmlPath.startsWith('/') || /^[a-zA-Z]:[\\/]/.test(htmlPath) || htmlPath.startsWith('\\\\');
+	if (!absolute) {
+		return false;
+	}
+	return !htmlPath.split(/[\\/]/).some(part => part === '.' || part === '..');
+}
+
+/** Whether `file` is inside `folder` (both absolute), never `folder` itself. */
+function isInside(file: string, folder: string): boolean {
+	const inside = relative(folder, file);
+	return inside !== '' && inside !== '..' && !inside.startsWith('..\\') && !inside.startsWith('../') && !isAbsolute(inside);
+}
+
+/**
+ * Whether the print's page may load `url`: a `file:` address inside `folder` (the page's own, a real path), or `data:`
+ * and `blob:`, which carry their bytes with them. Nothing else: no network, no other file on the computer.
+ */
+export function ritemarkPrintAllows(url: string, folder: string): boolean {
+	let parsed: URL;
+	try {
+		parsed = new URL(url);
+	} catch {
+		return false;
+	}
+	if (parsed.protocol === 'data:' || parsed.protocol === 'blob:') {
+		return true;
+	}
+	if (parsed.protocol !== 'file:' || parsed.host !== '') {
+		return false;
+	}
+	let file: string;
+	try {
+		file = normalize(URI.parse(parsed.href).fsPath);
+	} catch {
+		return false;
+	}
+	return isInside(file, normalize(folder));
+}
+
+/** Whether `folder` (a real path) is inside the system's temporary folder `temp` (a real path too). */
+export function ritemarkPrintFolderAllowed(folder: string, temp: string): boolean {
+	return isInside(normalize(folder), normalize(temp));
+}
