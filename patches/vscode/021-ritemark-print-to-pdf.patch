+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { join } from '../../../../base/common/path.js';
+import { isWindows } from '../../../../base/common/platform.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { isRitemarkPrintablePath, ritemarkPdfPathFor, ritemarkPrintAllows, ritemarkPrintFolderAllowed } from '../../common/ritemarkPrint.js';
+
+/** Ritemark (Sprint 170, #881): Save as PDF's print reads only its own page's folder and writes only beside it. */
+suite('Ritemark print', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('it prints only an absolute .html path with no dot parts', () => {
+		const paths = ['/tmp/rm-print-1/page.html', '/tmp/rm-print-1/page.HTML', 'C:\\Temp\\rm\\page.html', 'page.html', '/tmp/rm/../etc/page.html', '/tmp/rm/./page.html', '/tmp/rm/page.htm', '/tmp/rm/page.html\0.txt', 42];
+		assert.deepStrictEqual(paths.map(path => isRitemarkPrintablePath(path)), [true, true, true, false, false, false, false, false, false]);
+	});
+
+	test('the PDF goes beside the page, with its name', () => {
+		assert.strictEqual(ritemarkPdfPathFor('/tmp/rm-print-1/page.html'), '/tmp/rm-print-1/page.pdf');
+	});
+
+	test('the page loads its own folder\'s files, data and blobs, and nothing else', () => {
+		const folder = isWindows ? 'C:\\Temp\\rm-print-1' : '/tmp/rm-print-1';
+		const inside = URI.file(join(folder, 'fonts', 'Inter-4.001-latin.woff2')).toString(true);
+		const beside = URI.file(join(folder + '-other', 'secret.png')).toString(true);
+		const above = `${URI.file(folder).toString(true)}/../secret.png`;
+		const dotted = URI.file(join(folder, '..notes', 'a.png')).toString(true);
+		const urls = [inside, beside, above, dotted, URI.file(folder).toString(true), 'data:font/woff2;base64,AAAA', 'blob:file:///1234', 'https://ritemark.app/', 'http://localhost:9224/', 'file://server/share/page.png', 'not a url'];
+		assert.deepStrictEqual(urls.map(url => ritemarkPrintAllows(url, folder)), [true, false, false, true, false, true, true, false, false, false, false]);
+	});
+
+	test('the page must be in the system\'s temporary folder', () => {
+		const temp = isWindows ? 'C:\\Temp' : '/private/var/folders/xy/T';
+		assert.deepStrictEqual([join(temp, 'rm-print-1'), temp, join(temp, '..', 'Documents'), isWindows ? 'C:\\Users\\me' : '/Users/me'].map(folder => ritemarkPrintFolderAllowed(folder, temp)), [true, false, false, false]);
+	});
+});
