+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { Action, IAction, Separator } from '../../../../../base/common/actions.js';
+import { MenuId, SubmenuItemAction } from '../../../../../platform/actions/common/actions.js';
+import { filterRitemarkMenubarActions } from '../../../../browser/parts/titlebar/menubarControl.js';
+
+suite('Ritemark menubar policy', () => {
+
+	const ids = (actions: readonly IAction[]) => actions.map(action => action.id);
+
+	test('Help is a fail-closed product allowlist with normalized separators', () => {
+		const support = new Action('workbench.action.openDocumentationUrl', 'Support');
+		const license = new Action('workbench.action.openLicenseUrl', 'View License');
+		const about = new Action('workbench.action.showAboutDialog', 'About Ritemark');
+		const advanced = new SubmenuItemAction({
+			title: 'Advanced',
+			submenu: MenuId.MenubarHelpMenuAdvanced,
+		}, undefined, [new Action('workbench.action.toggleDevTools', 'Toggle Developer Tools')]);
+
+		const result = filterRitemarkMenubarActions('ritemark', 'Help', [
+			new Separator(),
+			new Action('workbench.action.openWalkthrough', 'Welcome'),
+			new Separator(),
+			support,
+			new Separator(),
+			new Action('workbench.action.askVScode', 'Ask @vscode'),
+			new Separator(),
+			license,
+			new Separator(),
+			new Separator(),
+			advanced,
+			new Separator(),
+			about,
+			new Separator(),
+		]);
+
+		assert.deepStrictEqual(ids(result), [
+			support.id,
+			Separator.ID,
+			license.id,
+			Separator.ID,
+			advanced.id,
+			Separator.ID,
+			about.id,
+		]);
+	});
+
+	test('unknown and developer-only top-level Help commands are rejected', () => {
+		const result = filterRitemarkMenubarActions('ritemark', 'Help', [
+			new Action('workbench.action.openProcessExplorer', 'Open Process Explorer'),
+			new Action('workbench.action.toggleDevTools', 'Toggle Developer Tools'),
+			new Action('future.upstream.help.command', 'Future upstream command'),
+		]);
+
+		assert.deepStrictEqual(result, []);
+	});
+
+	test('other products and other top-level menus are unchanged', () => {
+		const actions = [
+			new Separator(),
+			new Action('future.upstream.help.command', 'Future upstream command'),
+			new Separator(),
+		];
+
+		assert.deepStrictEqual(ids(filterRitemarkMenubarActions('code-oss', 'Help', actions)), ids(actions));
+		assert.deepStrictEqual(ids(filterRitemarkMenubarActions('ritemark', 'View', actions)), ids(actions));
+	});
+});
