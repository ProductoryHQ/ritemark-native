+const RITEMARK_HELP_MENU_ACTION_IDS = new Set([
+	'ritemark.help.openGettingStarted',
+	'workbench.action.openDocumentationUrl',
+	'ritemark.help.sendFeedback', // Sprint 140 (R10, D7): Getting started, Support, Send feedback
+	'workbench.action.openLicenseUrl',
+	'workbench.action.showAboutDialog',
+]);
+
+/**
+ * Ritemark owns its product Help menu. Keep the policy at the rendering boundary
+ * so new or rebased upstream contributions cannot silently leak into the native
+ * or custom menubar. Commands remain registered and available from the palette.
+ */
+export function filterRitemarkMenubarActions(applicationName: string | undefined, topLevelTitle: string, menuActions: readonly IAction[]): IAction[] {
+	if (applicationName !== 'ritemark' || topLevelTitle !== 'Help') {
+		return Array.from(menuActions);
+	}
+
+	const filtered: IAction[] = [];
+	for (const menuAction of menuActions) {
+		const isAllowed = menuAction instanceof Separator
+			|| (menuAction instanceof SubmenuItemAction && menuAction.item.submenu === MenuId.MenubarHelpMenuAdvanced)
+			|| RITEMARK_HELP_MENU_ACTION_IDS.has(menuAction.id);
+
+		if (!isAllowed) {
+			continue;
+		}
+
+		if (menuAction instanceof Separator) {
+			if (filtered.length === 0 || filtered[filtered.length - 1] instanceof Separator) {
+				continue;
+			}
+		}
+
+		filtered.push(menuAction);
+	}
+
+	if (filtered[filtered.length - 1] instanceof Separator) {
+		filtered.pop();
+	}
+
+	return filtered;
+}
+
+if (product.applicationName === 'ritemark') {
+	MenuRegistry.appendMenuItem(MenuId.MenubarHelpMenu, {
+		title: localize('miHelpAdvanced', "Advanced"),
+		submenu: MenuId.MenubarHelpMenuAdvanced,
+		group: '6_advanced',
+		order: 1
+	});
+}
