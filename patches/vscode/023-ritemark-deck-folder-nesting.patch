+const deckExtension = '.rtms';
+const deckFolderSuffix = ' files';
+
+export function isDeckFolderOf(folder: ExplorerItem, file: ExplorerItem): boolean {
+	return folder.isDirectory && !file.isDirectory && !!file.parent && folder.parent === file.parent
+		&& file.name.endsWith(deckExtension) && folder.name === file.name.slice(0, -deckExtension.length) + deckFolderSuffix;
+}
