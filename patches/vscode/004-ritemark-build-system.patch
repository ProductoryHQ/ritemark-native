 		const builtInCopilotExtensionDir = path.join(appBase, 'extensions', 'copilot');
+		// Ritemark (Sprint 135): a build that packages the built-in Copilot from source filters its node_modules
+		// through build/.moduleignore, whose `@github/copilot/**` strips the SDK this shim needs, so it would throw.
+		// The shim writes only inside that extension, and Ritemark removes the built-in Copilot after packaging
+		// (build-prod.sh step 4.5 and the CI workflows), so there is nothing to prepare.
+		if (!fs.existsSync(path.join(builtInCopilotExtensionDir, 'node_modules', '@github', 'copilot', 'sdk'))) {
+			console.log(`[prepareCopilotRipgrepShimTask] Ritemark: skipped, the packaged built-in Copilot has no SDK (${builtInCopilotExtensionDir})`);
+			return;
+		}
 		prepareBuiltInCopilotRipgrepShim(platform, arch, builtInCopilotExtensionDir, appNodeModulesDir);
 	};
