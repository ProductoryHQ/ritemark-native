+	{ id: 'workbench.action.webview.openDeveloperTools', title: 'Open Webview Developer Tools', category: 'Developer' },
+	{ id: 'merge.dev.openContentsJson', title: 'Open Merge Editor State from JSON', category: 'Merge Editor (Dev)' },
+	{ id: 'workbench.action.openProcessExplorer', title: 'Open Process Explorer', category: 'Developer' },
+	{ id: 'extension.node-debug.toggleAutoAttach', title: 'Toggle Auto Attach', category: 'Debug' },
+	{ id: 'workbench.action.toggleMaximizedAuxiliaryBar', title: 'Toggle Maximized Secondary Side Bar', category: 'View' },
+	{ id: 'workbench.panel.repl.view.focus', title: 'Focus on Debug Console View', category: 'Debug Console' },
+	{ id: 'ritemark.reactions', title: 'Send Feedback' },
+];
+
+/**
+ * Ritemark 2.0 (Sprint 134, R21): All commands offers none of VS Code's developer and debugging commands. The
+ * commands stay registered; only the palette's offer changes, in search and in recently used alike.
+ */
+suite('Ritemark palette policy', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function createProvider(applicationName: string, recentlyUsed: string[] = []): TestCommandsQuickAccessProvider {
+		const instantiationService = store.add(new TestInstantiationService());
+		const contextKeyService: IContextKeyService = new MockContextKeyService();
+
+		const storageService = store.add(new InMemoryStorageService());
+		if (recentlyUsed.length) {
+			// The history as an older session left it: oldest first, the last the most recently used
+			storageService.store('commandPalette.mru.cache', JSON.stringify({ usesLRU: true, entries: recentlyUsed.map((key, index) => ({ key, value: index + 1 })) }), StorageScope.PROFILE, StorageTarget.USER);
+			storageService.store('commandPalette.mru.counter', recentlyUsed.length + 1, StorageScope.PROFILE, StorageTarget.USER);
+		}
+
+		const editor = { getSupportedActions: () => EDITOR_ACTIONS } as IEditor;
+		const menuActions = GLOBAL_COMMANDS.map(command => new MenuItemAction(command, undefined, undefined, undefined, undefined, contextKeyService, NullCommandService));
+
+		instantiationService.stub(IEditorService, { activeTextEditorControl: editor, activeEditorPane: undefined });
+		instantiationService.stub(IEditorGroupsService, { activeGroup: { scopedContextKeyService: contextKeyService } as IEditorGroup });
+		instantiationService.stub(IMenuService, { getMenuActions: () => [['navigation', menuActions]] });
+		instantiationService.stub(IExtensionService, { whenInstalledExtensionsRegistered: async () => true });
+		instantiationService.stub(IKeybindingService, new MockKeybindingService());
+		instantiationService.stub(ICommandService, NullCommandService);
+		instantiationService.stub(ITelemetryService, NullTelemetryService);
+		instantiationService.stub(IDialogService, new TestDialogService());
+		instantiationService.stub(IConfigurationService, new TestConfigurationService({
+			workbench: {
+				commandPalette: {
+					history: 50,
+					preserveInput: false,
+					showAskInChat: false,
+					experimental: { suggestCommands: false, enableNaturalLanguageSearch: false, askChatLocation: 'chatView' }
+				}
+			}
+		}));
+		instantiationService.stub(IPreferencesService, {});
+		instantiationService.stub(IProductService, { applicationName });
+		instantiationService.stub(IAiRelatedInformationService, { isEnabled: () => false });
+		instantiationService.stub(IChatAgentService, {});
+		instantiationService.stub(IStorageService, storageService);
+		instantiationService.stub(ILogService, new NullLogService());
+
+		return store.add(instantiationService.createInstance(TestCommandsQuickAccessProvider));
+	}
+
+	test('drops the listed IDs and every ID under a listed prefix, and keeps the rest', () => {
+		const ids = [
+			// Dropped by exact ID
+			'workbench.view.debug',
+			'workbench.panel.repl.view.focus',
+			'extension.node-debug.toggleAutoAttach',
+			'workbench.action.inspectContextKeys',
+			'workbench.action.debugRenderer',
+			'_update.applyupdate',
+			'resetGettingStartedProgress',
+			'welcome.showAllWalkthroughs',
+			'github.copilot.open.walkthrough',
+			'workbench.action.openAgentsWindow',
+			'workbench.action.startHeapTracing',
+			'agentsVoice.resetOnboarding',
+			// Dropped by prefix, one for each
+			'workbench.debug.viewlet.action.addDataBreakpointOnAddress',
+			'workbench.action.debug.start',
+			'debug.addConfiguration',
+			'editor.debug.action.toggleBreakpoint',
+			'merge.dev.openContentsJson',
+			// Kept: the four developer commands Ritemark names
+			'workbench.action.reloadWindow',
+			'workbench.action.toggleDevTools',
+			'workbench.action.webview.openDeveloperTools',
+			'workbench.action.openProcessExplorer',
+			// Kept: the parity list's palette-only commands, and Ritemark's own
+			'workbench.action.openSettings2',
+			'workbench.files.action.refreshFilesExplorer',
+			'workbench.action.toggleMaximizedAuxiliaryBar',
+			'workbench.action.maximizeAuxiliaryBar',
+			'ritemark.reactions',
+			'_ritemark.files.chosenFolder',
+			// Kept: Help: Welcome, which opens Ritemark's welcome
+			'workbench.action.openWalkthrough',
+			// Kept: a prefix needs its dot, so look-alikes outside the family stay
+			'workbench.action.debugger.other',
+			'debugpy.debugInTerminal',
+			'editor.debugger.other',
+		];
+
+		assert.deepStrictEqual(ids.filter(id => isHiddenFromRitemarkPalette('ritemark', id)), [
+			'workbench.view.debug',
+			'workbench.panel.repl.view.focus',
+			'extension.node-debug.toggleAutoAttach',
+			'workbench.action.inspectContextKeys',
+			'workbench.action.debugRenderer',
+			'_update.applyupdate',
+			'resetGettingStartedProgress',
+			'welcome.showAllWalkthroughs',
+			'github.copilot.open.walkthrough',
+			'workbench.action.openAgentsWindow',
+			'workbench.action.startHeapTracing',
+			'agentsVoice.resetOnboarding',
+			'workbench.debug.viewlet.action.addDataBreakpointOnAddress',
+			'workbench.action.debug.start',
+			'debug.addConfiguration',
+			'editor.debug.action.toggleBreakpoint',
+			'merge.dev.openContentsJson',
+		]);
+	});
+
+	test('other products are unchanged', () => {
+		const ids = ['workbench.view.debug', 'workbench.action.inspectContextKeys', 'workbench.debug.viewlet.action.addFunctionBreakpointAction', 'merge.dev.openContentsJson'];
+
+		assert.deepStrictEqual(ids.filter(id => isHiddenFromRitemarkPalette('code-oss', id)), []);
+		assert.deepStrictEqual(ids.filter(id => isHiddenFromRitemarkPalette(undefined, id)), []);
+	});
+
+	test('All commands offers no dropped command, from the editor or the palette\'s items, in the order it had', async () => {
+		assert.deepStrictEqual(await createProvider('ritemark').allPicks(), [
+			'editor.action.formatDocument',
+			'workbench.action.openSettings2',
+			'workbench.action.reloadWindow',
+			'workbench.files.action.refreshFilesExplorer',
+			'workbench.action.toggleDevTools',
+			'workbench.action.webview.openDeveloperTools',
+			'workbench.action.openProcessExplorer',
+			'workbench.action.toggleMaximizedAuxiliaryBar',
+			'ritemark.reactions',
+		]);
+
+		assert.deepStrictEqual(await createProvider('code-oss').allPicks(), [
+			...EDITOR_ACTIONS.map(action => action.id),
+			...GLOBAL_COMMANDS.map(command => command.id),
+		]);
+	});
+
+	test('search, by words or by exact ID, finds no dropped command', async () => {
+		const disposables = store.add(new DisposableStore());
+
+		assert.deepStrictEqual(await createProvider('ritemark').shown('Breakpoint', disposables), []);
+		assert.deepStrictEqual(await createProvider('ritemark').shown('workbench.action.inspectContextKeys', disposables), []);
+
+		// The same searches find them in other products
+		assert.deepStrictEqual(await createProvider('code-oss').shown('Breakpoint', disposables), [
+			'workbench.debug.viewlet.action.addFunctionBreakpointAction',
+			'editor.debug.action.toggleBreakpoint',
+		]);
+		assert.deepStrictEqual(await createProvider('code-oss').shown('workbench.action.inspectContextKeys', disposables), [
+			'workbench.action.inspectContextKeys',
+		]);
+	});
+
+	test('recently used never offers a dropped command, even one used last', async () => {
+		const disposables = store.add(new DisposableStore());
+		const recentlyUsed = ['workbench.action.reloadWindow', 'workbench.action.inspectContextKeys', 'editor.debug.action.toggleBreakpoint'];
+		const shown = await createProvider('ritemark', recentlyUsed).shown('', disposables);
+
+		assert.deepStrictEqual(shown.slice(0, 3), [
+			'-- recently used',
+			'workbench.action.reloadWindow',
+			'-- other commands',
+		]);
+		assert.deepStrictEqual(shown.filter(id => isHiddenFromRitemarkPalette('ritemark', id)), []);
+
+		// The same history leads with them in other products
+		assert.deepStrictEqual((await createProvider('code-oss', recentlyUsed).shown('', disposables)).slice(0, 5), [
+			'-- recently used',
+			'editor.debug.action.toggleBreakpoint',
+			'workbench.action.inspectContextKeys',
+			'workbench.action.reloadWindow',
+			'-- other commands',
+		]);
+	});
+});
