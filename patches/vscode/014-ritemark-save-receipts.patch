+const RITEMARK_EDITABLE_EXTENSIONS = new Set(['.csv', '.md', '.markdown', '.mdown', '.mkd']);
+
+function needsRitemarkSaveReceipt(resource: URI): boolean {
+	const extension = extname(resource.path).toLowerCase();
+	return extension === '' || RITEMARK_EDITABLE_EXTENSIONS.has(extension);
+}
+
+async function computeRitemarkLogicalHash(content: string): Promise<string> {
+	const normalized = content.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n');
+	const encoded = new TextEncoder().encode(normalized);
+	const digest = await crypto.subtle.digest('SHA-256', encoded);
+	return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
+}
