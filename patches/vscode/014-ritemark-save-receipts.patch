+ *--------------------------------------------------------------------------------------------*/
+
+// Ritemark (patch 014, #454): which refused saves the save-error handler hands to Ritemark.
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { RITEMARK_EDITOR_ID, shouldAskRitemarkBeforeReload, shouldHandSaveConflictToRitemark } from '../../browser/editors/textFileSaveErrorHandler.js';
+
+suite('Ritemark save conflict hand-over', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('a save refused as newer, for a document Ritemark\'s editor holds, goes to Ritemark', () => {
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, [RITEMARK_EDITOR_ID], false), true);
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, ['workbench.editors.files.textFileEditor', RITEMARK_EDITOR_ID], false), true, 'also with a text editor of the same file open (S44)');
+	});
+
+	test('everything else keeps VS Code\'s notification', () => {
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, ['workbench.editors.files.textFileEditor'], false), false, 'only a text editor holds it (S45)');
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, [], false), false, 'no editor holds it');
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, [undefined], false), false, 'an editor without an id');
+		assert.strictEqual(shouldHandSaveConflictToRitemark(false, [RITEMARK_EDITOR_ID], false), false, 'another save error (read-only, permissions)');
+		assert.strictEqual(shouldHandSaveConflictToRitemark(true, [RITEMARK_EDITOR_ID], true), false, 'a save from VS Code\'s own conflict editor');
+	});
+
+	// Sprint 145 R1 (#588): a reload of a clean document goes to Ritemark only when Ritemark's editor holds it.
+	test('a reload asks Ritemark only for a document Ritemark\'s editor holds', () => {
+		assert.strictEqual(shouldAskRitemarkBeforeReload([RITEMARK_EDITOR_ID]), true);
+		assert.strictEqual(shouldAskRitemarkBeforeReload(['workbench.editors.files.textFileEditor', RITEMARK_EDITOR_ID]), true, 'also with a text editor of the same file open');
+		assert.strictEqual(shouldAskRitemarkBeforeReload(['workbench.editors.files.textFileEditor']), false, 'only a text editor holds it');
+		assert.strictEqual(shouldAskRitemarkBeforeReload([]), false, 'no editor holds it');
+		assert.strictEqual(shouldAskRitemarkBeforeReload([undefined]), false, 'an editor without an id');
+	});
+});
