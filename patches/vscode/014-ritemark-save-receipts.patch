+	/**
+	 * Ritemark (patch 014, #454): Ritemark answers 'overwrite' when nobody else changed the text (a sync client
+	 * touched the file, or the disk already holds the person's text: save over it, no question), 'handled' when
+	 * its own Review changes asks. Anything else, or no answer (Ritemark not running, or not answering within
+	 * `RITEMARK_ANSWER_TIMEOUT_MS`), shows this handler's notification as before, so a conflict is never left
+	 * without a question.
+	 */
+	private handOverToRitemark(error: unknown, model: ITextFileEditorModel, options: ITextFileSaveOptions): boolean {
+		const isModifiedSince = (error as FileOperationError).fileOperationResult === FileOperationResult.FILE_MODIFIED_SINCE;
+		const fromConflictEditor = !!this.activeConflictResolutionResource && isEqual(this.activeConflictResolutionResource, model.resource);
+		const editorIds = isModifiedSince ? this.editorService.findEditors(model.resource).map(({ editor }) => editor.editorId) : [];
+		if (!shouldHandSaveConflictToRitemark(isModifiedSince, editorIds, fromConflictEditor)) {
+			return false;
+		}
+		void this.askRitemark(error, model, options);
+		return true;
+	}
+
+	private async askRitemark(error: unknown, model: ITextFileEditorModel, options: ITextFileSaveOptions): Promise<void> {
+		let answer: unknown;
+		try {
+			// No answer in time (the extension host is busy or stuck) counts as no answer: the notification shows.
+			answer = await raceTimeout(this.commandService.executeCommand<unknown>(RITEMARK_ANSWER_SAVE_CONFLICT_COMMAND, model.resource), RITEMARK_ANSWER_TIMEOUT_MS);
+		} catch {
+			answer = undefined; // the command is not registered: Ritemark is not running
+		}
+		if (answer === 'overwrite') {
+			if (!model.isDisposed()) {
+				// As this handler's own Overwrite does: the refused save left the model in conflict, where an auto save is ignored.
+				await model.save({ ...options, ignoreModifiedSince: true, reason: SaveReason.EXPLICIT });
+			}
+			return;
+		}
+		if (answer !== 'handled') {
+			this.onSaveError(error, model, options, true);
+		}
+	}
